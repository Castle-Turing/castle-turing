# Claude Code local state: machine-specific permissions, not shared config.
# The project skill in .claude/skills/ IS committed and travels with the repo.
.claude/settings.local.json

# Python bytecode from running the agent-layer harnesses locally
# (agent/castle-modal imports agent/castle as a module, which writes
# one). Never belongs in the repo: it is a build artifact of a
# specific interpreter version, and modules/agent's castleCli
# derivation takes agent/ as its src, so a stray .pyc changes a store
# path for nothing.
__pycache__/
# A scratch directory for tools that cannot use $TMPDIR. tools/handover.sh
# writes its ledger and draft under $TMPDIR by default — deliberately
# outside the checkout, because a ledger built on a real machine carries
# journal record ids and those are private layer. An agent session
# confined to its own worktree cannot write outside it, so it passes
# --out .scratch/ instead; this keeps that from being committed.
.scratch/
