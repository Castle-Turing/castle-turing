#!/usr/bin/env python3
"""castle-modal — the ambient-intake surface (docs/tasks/0009-ambient-intake.md).

The keybinding (Mod4+Shift+Return, see modules/home) opens a floating
`foot` terminal running this script. Stdlib Python only, same
constraint as agent/castle (agent/README.md) — and for the same reason:
this has to keep working with nothing installed beyond a python3
binary. It is deliberately NOT a GTK app, a wofi/fuzzel script, or
written in a second language; it's a terminal program because the
terminal is already the substrate this whole project is built on.

Two modes, both just callers of agent/castle's own record-writing and
record-reading functions — this file adds no judgment of its own,
exactly like `castle ask`/`castle digest` add none (Proposal 03):

  compose  Multi-line free text describing a problem, nothing else — no
           category picker, no priority dropdown. Ends on a lone '.'
           line or EOF. Becomes a `request` record via the same
           write_record() call `castle ask` uses; the modal is just
           another intake surface (docs/architecture.md: "the first
           intake is a CLI; a compositor keybinding opening a modal...
           are later intakes"). An interactive session is then asked
           one plain-language question — something to fix, or telling
           the system how it's doing — and the second answer routes
           the same body through castle's file_correction() instead
           (docs/tasks/0010-correction-record.md); intake itself still
           adds no judgment, since the resident is the one classifying,
           not the tool.
  status   A compact fold of recent errands: what was asked, what
           state it's in, what the system last decided and why. The
           "come back and check in later" surface. Corrections never
           appear here — they aren't errands, and there's nothing for
           the resident to check back on.

Headless by construction, not by special-casing: both modes read
stdin and write stdout/stderr with no dependency on a terminal at all.
Nothing here calls `curses` or emits raw ANSI codes except a couple of
purely cosmetic prompts guarded by `sys.stdin.isatty()` — delete those
lines and the program still does exactly the same work, which is the
property that lets CI pipe canned input at it with no compositor,
no foot, and no Sway involved (docs/tasks/0009's verification plan).
"""

from __future__ import annotations

import argparse
import datetime as dt
import importlib.machinery
import importlib.util
import pathlib
import sys


def _load_castle_module():
    """Import agent/castle (no .py extension, colocated in this same
    directory) as a library rather than shelling out to it — this
    script and `castle` are the same tool wearing two hats, so sharing
    the parser/writer in-process avoids re-implementing (and
    re-diverging from) the record format a second time.

    `spec_from_file_location` can't infer a loader from an extensionless
    filename, so the SourceFileLoader is constructed explicitly rather
    than relying on that inference.
    """
    castle_path = pathlib.Path(__file__).resolve().parent / "castle"
    loader = importlib.machinery.SourceFileLoader("castle_lib", str(castle_path))
    spec = importlib.util.spec_from_file_location("castle_lib", castle_path, loader=loader)
    if spec is None or spec.loader is None:
        raise ImportError(f"cannot load {castle_path} as a module")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _pause_for_dismissal(out=sys.stdout) -> None:
    """The keybinding (modules/home) opens a floating `foot` running this
    script as its sole command, and foot closes the instant that process
    exits — so without this, both the "Filed as <id>..." confirmation
    and the "empty request, nothing filed" refusal flash for zero
    human-perceptible frames (0009 review pass finding 5), on a surface
    whose entire premise is "describe it and walk away." Blocking on a
    keypress here — in the one process foot is running, rather than
    threading a shell wrapper's quoting through the Sway keybinding
    string — is what holds the window open until a human dismisses it.
    Gated on isatty() for the same reason compose mode's cosmetic
    prompts are: a piped-stdin run (CI, or `castle-modal` in a script)
    has no human to wait for and no tty to read a keypress from.
    """
    if not sys.stdin.isatty():
        return
    print(file=out)
    print("Press Enter to close.", file=out)
    try:
        input()
    except EOFError:
        pass


def _classify_interactively(out=sys.stdout) -> str:
    """One plain-language question, answered with one keypress
    (docs/tasks/0010-correction-record.md scope 6): is what was just
    typed something to fix, or is the resident telling the system how
    it's doing? Intake stays judgment-free — the resident classifies,
    the tool never guesses — and the words "correction record" never
    appear here or anywhere else this surface shows the resident;
    that vocabulary is for scripts and CI only (see --kind, below).

    termios cbreak, gated on isatty() by the same reasoning as every
    other cosmetic prompt in this file: a piped-stdin caller has no
    human to ask and no tty to read a keypress from, and never reaches
    this function. Bare Enter answers "something to fix" — the common
    case, and the one that shouldn't cost an extra keystroke.

    cbreak is engaged *before* the prompt is printed, not after
    (code-review finding, correction-record branch): printing is I/O —
    a syscall reaching the pty — and a keypress landing in the gap
    between "prompt printed" and "cbreak engaged" is held by the
    kernel's still-canonical line discipline until a newline arrives,
    which a bare single-character keypress never sends, hanging this
    read forever. Entering cbreak first collapses that window to a
    few bytecode instructions instead of a print() round-trip; output
    formatting is unaffected, since cbreak only changes how *input* is
    line-buffered, not how bytes written to the terminal are rendered.
    """
    import termios
    import tty

    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        print(file=out)
        print("Is this something to fix, or are you telling me how I'm doing?", file=out)
        print("[Enter/f] something to fix        [t] telling you how you're doing", file=out)
        answer = sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
    print(file=out)
    return "correction" if answer.lower() == "t" else "request"


def run_compose(castle, out=sys.stdout, kind: str = "request") -> int:
    interactive = sys.stdin.isatty()
    if interactive:
        print("Describe the problem in your own words.", file=out)
        print("End with a line containing just '.' (or Ctrl-D).", file=out)
        print(file=out)

    lines: list[str] = []
    for raw_line in sys.stdin:
        line = raw_line.rstrip("\n")
        if line.strip() == ".":
            break
        lines.append(line)
    body = "\n".join(lines).strip()

    if not body:
        print("castle-modal: empty request, nothing filed.", file=sys.stderr)
        _pause_for_dismissal(out)
        return 1

    # An interactive session is always asked, regardless of --kind (that
    # flag exists for non-interactive callers, who have no keyboard to
    # ask); a piped session keeps whatever --kind supplied (default
    # "request", so every existing piped caller is unchanged).
    if interactive:
        kind = _classify_interactively(out)

    if kind == "correction":
        record_id = castle.file_correction(body=body, refs=[], surface="modal")
        print(record_id, file=out)
        if interactive:
            print(f"Filed as {record_id}. Thanks — noted.", file=out)
    else:
        record_id = castle.write_record(
            castle.journal_dir(),
            type="request",
            provenance="requested",
            seat="intake",
            body=body,
        )
        print(record_id, file=out)
        if interactive:
            print(f"Filed as {record_id}. Check back with castle-modal --mode status.", file=out)
    _pause_for_dismissal(out)
    return 0


def _started_at(castle, claim) -> str:
    """A claim's start time as local wall-clock `HH:MM`.

    `created` is UTC, always (agent/castle's CREATED_FMT), and "started
    14:03" means nothing to a resident if 14:03 is in a timezone they
    don't live in. Falls back to the raw field if it doesn't parse —
    this is a status line, not a validator."""
    raw = claim.fields.get("created", "")
    try:
        when = dt.datetime.strptime(raw, castle.CREATED_FMT).replace(tzinfo=dt.timezone.utc)
    except ValueError:
        return raw or "?"
    return when.astimezone().strftime("%H:%M")


def _outcome_label(outcome: str, request_id: str) -> str:
    """One result's `outcome` as a resident-facing label.

    Every non-completed value names the retry command explicitly. That
    is docs/tasks/0015's lesson restated — "the label must not cause
    the inaction it describes": a label honest about failure but silent
    about what to do next repeats the same mistake in the other
    direction. An absent `outcome` means "done", deliberately and
    forever: every result written before that field existed is already
    permanent in an append-only journal and cannot be backfilled, so a
    pre-existing result whose body says "FAILED" in prose keeps reading
    as "done" — the same backward-compatibility posture
    `considered`/`propensity` already established. Nothing here greps a
    body for a word like "FAILED"; the field is the fact.
    """
    if outcome == "failed":
        return f"failed — castle work {request_id} to retry"
    if outcome == "timeout":
        return f"timed out — castle work {request_id} to retry"
    if outcome == "interrupted":
        return f"interrupted — castle work {request_id} to retry"
    return "done"


def _errand_state(castle, request, downstream: list) -> str:
    """`result` was checked before question/answer, so 'done' won any
    errand that also had an unanswered question — but the worker prompt
    (agent/castle-worker-claude) explicitly tells tenants to "file the
    question alongside your result rather than stopping", so
    result+unanswered-question is the *normal* shape for a worker that
    needed input mid-errand, not an edge case. That made "waiting on
    you" — the one state this whole modal exists to surface — silently
    unreachable in exactly the flow the worker is instructed to use
    (0009 review pass finding 4). Reporting both when both apply is
    strictly more honest than picking one. The ", waiting on you"
    overlay below composes exactly as it always has.

    **The errand's state is the state of its newest turn.** Since
    docs/tasks/0021-auto-dispatch.md a result names the `claim` it
    closes, so "which turn are we talking about" is answerable — and it
    has to be asked, because keying on the newest *result* gets two
    real cases backwards. An errand whose retry completed, and whose
    older abandoned turn was reaped afterwards, has a newer
    `interrupted` result than its `completed` one: keyed on results it
    reads as interrupted forever, though it is finished. And an errand
    with a second turn that died leaves a claim no result closes, which
    an older result masks entirely. Older turns' accounts — reaped ones
    included — are history; the newest turn is the current truth. A
    journal with no `claim` records at all (everything written before
    this task) keeps the old newest-result behavior unchanged.

    "in progress" is now *earnable* (docs/tasks/0021 §4), which
    docs/tasks/0015 deliberately left it not being: a `claim` record
    says a worker turn began, and a live `flock` on that errand's lease
    says one is running right this second. Both, not either — a claim
    with a dead lease is an interrupted turn, and saying "in progress"
    about it would be exactly the absence-of-evidence guess 0015
    removed. It is also checked **first**, ahead of any result: an
    errand whose failed turn the resident is retrying right now must
    not be labelled with advice to run the very command that is already
    running (and would be refused the lease).

    The narrow race this live probe shares with the dispatch reaper's
    own probe is documented on agent/castle's `lock_is_held`, and
    accepted there.
    """
    request_id = request.id
    types = {rec.type for rec in downstream}
    waiting = "question" in types and "answer" not in types
    results = sorted(
        (rec for rec in downstream if rec.type == "result"), key=lambda rec: rec.id
    )
    claims = sorted(
        (rec for rec in downstream if rec.type == "claim"), key=lambda rec: rec.id
    )

    base = None
    if claims:
        newest_claim = claims[-1]
        if castle.lease_is_held(request_id):
            base = f"in progress (started {_started_at(castle, newest_claim)})"
        else:
            # The result that closes *this* turn, not merely the newest
            # result on the errand.
            closing = [rec for rec in results if newest_claim.id in rec.refs]
            if closing:
                base = _outcome_label(closing[-1].fields.get("outcome", ""), request_id)
            else:
                # The window between "the lease died" and "the next
                # dispatch sweep reaps it into a result". Nothing is
                # running, so "interrupted" is the honest label.
                base = f"interrupted — castle work {request_id} to retry"
    elif results:
        # No claim records anywhere on this errand: a journal from
        # before docs/tasks/0021, where nothing recorded turns at all.
        base = _outcome_label(results[-1].fields.get("outcome", ""), request_id)
    elif request.fields.get(castle.FILED_DURING_TURN_FIELD, "").strip():
        # A request a worker tenant filed during its own turn
        # (docs/tasks/0021 §2.4(e)). "Awaiting a worker" would be the
        # 0015 failure exactly: a label promising a start that is never
        # coming, because dispatch deliberately never starts these. Say
        # what is true and what to do about it.
        base = f"filed during a worker turn — castle work {request_id} to run it"

    if waiting:
        return f"{base}, waiting on you" if base else "waiting on you"
    return base or "awaiting a worker"


def run_status(castle, limit: int, out=sys.stdout) -> int:
    records = castle.load_all(castle.journal_dir())
    requests = sorted(
        (rec for rec in records.values() if rec.type == "request"),
        key=lambda rec: rec.id,
        reverse=True,
    )[:limit]

    if not requests:
        print("No errands yet. Press Mod4+Shift+Return and describe one.", file=out)
        return 0

    for req in requests:
        downstream = castle._collect_downstream(records, req.id)
        state = _errand_state(castle, req, downstream)
        first_line = req.body.strip().splitlines()[0] if req.body.strip() else "(no description)"
        print(f"[{req.id}] {req.fields.get('provenance', '?')} — {state}", file=out)
        print(f"    asked: {first_line}", file=out)
        decisions = sorted(
            (rec for rec in downstream if rec.type == "decision"),
            key=lambda rec: rec.id,
        )
        for decision in decisions:
            channel = decision.fields.get("channel", "")
            evidence = decision.fields.get("evidence", "")
            if channel:
                print(f"    decided -> {channel}: {evidence}", file=out)
            else:
                # A decision that routed nothing — today, the dispatch
                # watermark, which names the requests it excluded from
                # automatic starting in its own `refs` and therefore
                # lands in this errand's fold (docs/tasks/0021 §2.2).
                # "decided -> ?" would read as a routing that failed;
                # this reads as what it is, which for an excluded
                # request is exactly the explanation the resident wants
                # for why nothing is happening on its own.
                print(f"    noted: {evidence}", file=out)
        print(file=out)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="castle-modal", description=__doc__)
    parser.add_argument(
        "--mode",
        choices=("compose", "status"),
        default="compose",
        help="compose a new request, or fold recent errands (default: compose)",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=10,
        help="status mode: how many recent errands to show (default: 10)",
    )
    parser.add_argument(
        "--kind",
        choices=("request", "correction"),
        default="request",
        help=(
            "compose mode, non-interactive callers only: file the composed text as "
            "something to fix (request, the default — every existing piped caller "
            "is unaffected) or as unprompted feedback about how the system is doing "
            "(correction). An interactive session ignores this flag and asks in "
            "plain language instead; this name is for scripts and CI, never shown "
            "to the resident (docs/tasks/0010-correction-record.md scope 6)."
        ),
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    castle = _load_castle_module()
    if args.mode == "compose":
        return run_compose(castle, kind=args.kind)
    return run_status(castle, args.limit)


if __name__ == "__main__":
    sys.exit(main())
