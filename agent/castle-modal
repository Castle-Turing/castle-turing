#!/usr/bin/env python3
"""castle-modal — the ambient-intake surface (docs/tasks/0009-ambient-intake.md).

The keybinding (Mod4+Shift+Return, see modules/home) opens a floating
`foot` terminal running this script. Stdlib Python only, same
constraint as agent/castle (agent/README.md) — and for the same reason:
this has to keep working with nothing installed beyond a python3
binary. It is deliberately NOT a GTK app, a wofi/fuzzel script, or
written in a second language; it's a terminal program because the
terminal is already the substrate this whole project is built on.

Three modes, all just callers of agent/castle's own record-writing and
record-reading functions — this file adds no judgment of its own,
exactly like `castle ask`/`castle digest` add none (Proposal 03):

  compose  Multi-line free text describing a problem, nothing else — no
           category picker, no priority dropdown. Ends on a lone '.'
           line or EOF. Becomes a `request` record via the same
           write_record() call `castle ask` uses; the modal is just
           another intake surface (docs/architecture.md: "the first
           intake is a CLI; a compositor keybinding opening a modal...
           are later intakes"). An interactive session is then asked
           one plain-language question — something to fix, or telling
           the system how it's doing — and the second answer routes
           the same body through castle's file_correction() instead
           (docs/tasks/0010-correction-record.md); intake itself still
           adds no judgment, since the resident is the one classifying,
           not the tool.
  status   A compact fold of recent errands: what was asked, what
           state it's in, what the system last decided and why. The
           "come back and check in later" surface. Corrections never
           appear here — they aren't errands, and there's nothing for
           the resident to check back on.
  answer   The questions the system is waiting on, and one of them
           answered (Mod4+Shift+a; docs/tasks/0022-answer-in-ui.md).
           Oldest first, chosen by a single keypress, answered in the
           same text-entry grammar compose uses, filed through castle's
           file_answer() — the same write `castle answer` performs. The
           resident never types or reads a record id to do any of it,
           and nothing at all is written unless a question was chosen
           and a body typed.

Headless by construction, not by special-casing: every mode reads
stdin and writes stdout/stderr with no dependency on a terminal at all.
Nothing here calls `curses` or emits raw ANSI codes except a couple of
purely cosmetic prompts guarded by `sys.stdin.isatty()` — delete those
lines and the program still does exactly the same work, which is the
property that lets CI pipe canned input at it with no compositor,
no foot, and no Sway involved (docs/tasks/0009's verification plan).
"""

from __future__ import annotations

import argparse
import datetime as dt
import importlib.machinery
import importlib.util
import pathlib
import sys


def _load_castle_module():
    """Import agent/castle (no .py extension, colocated in this same
    directory) as a library rather than shelling out to it — this
    script and `castle` are the same tool wearing two hats, so sharing
    the parser/writer in-process avoids re-implementing (and
    re-diverging from) the record format a second time.

    `spec_from_file_location` can't infer a loader from an extensionless
    filename, so the SourceFileLoader is constructed explicitly rather
    than relying on that inference.
    """
    castle_path = pathlib.Path(__file__).resolve().parent / "castle"
    loader = importlib.machinery.SourceFileLoader("castle_lib", str(castle_path))
    spec = importlib.util.spec_from_file_location("castle_lib", castle_path, loader=loader)
    if spec is None or spec.loader is None:
        raise ImportError(f"cannot load {castle_path} as a module")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _pause_for_dismissal(out=sys.stdout) -> None:
    """The keybinding (modules/home) opens a floating `foot` running this
    script as its sole command, and foot closes the instant that process
    exits — so without this, both the "Filed as <id>..." confirmation
    and the "empty request, nothing filed" refusal flash for zero
    human-perceptible frames (0009 review pass finding 5), on a surface
    whose entire premise is "describe it and walk away." Blocking on a
    keypress here — in the one process foot is running, rather than
    threading a shell wrapper's quoting through the Sway keybinding
    string — is what holds the window open until a human dismisses it.
    Gated on isatty() for the same reason compose mode's cosmetic
    prompts are: a piped-stdin run (CI, or `castle-modal` in a script)
    has no human to wait for and no tty to read a keypress from.

    **Both** ends, not just stdin (review round 1, finding 4). In foot —
    the only place this pause is for — stdin and stdout are the same
    tty. In a command substitution run from a terminal, `$(castle-modal
    ...)` pipes stdout while stdin stays the caller's tty, so a
    stdin-only test read as "a human is here" and blocked forever on a
    keypress nobody knew to press; a reviewer hung a harness on exactly
    that. Captured output means nobody is watching a window that could
    close, which is the whole thing this pause exists to prevent.
    """
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return
    print(file=out)
    print("Press Enter to close.", file=out)
    try:
        input()
    except EOFError:
        pass


def _classify_interactively(out=sys.stdout) -> str:
    """One plain-language question, answered with one keypress
    (docs/tasks/0010-correction-record.md scope 6): is what was just
    typed something to fix, or is the resident telling the system how
    it's doing? Intake stays judgment-free — the resident classifies,
    the tool never guesses — and the words "correction record" never
    appear here or anywhere else this surface shows the resident;
    that vocabulary is for scripts and CI only (see --kind, below).

    termios cbreak, gated on isatty() by the same reasoning as every
    other cosmetic prompt in this file: a piped-stdin caller has no
    human to ask and no tty to read a keypress from, and never reaches
    this function. Bare Enter answers "something to fix" — the common
    case, and the one that shouldn't cost an extra keystroke.

    cbreak is engaged *before* the prompt is printed, not after
    (code-review finding, correction-record branch): printing is I/O —
    a syscall reaching the pty — and a keypress landing in the gap
    between "prompt printed" and "cbreak engaged" is held by the
    kernel's still-canonical line discipline until a newline arrives,
    which a bare single-character keypress never sends, hanging this
    read forever. Entering cbreak first collapses that window to a
    few bytecode instructions instead of a print() round-trip; output
    formatting is unaffected, since cbreak only changes how *input* is
    line-buffered, not how bytes written to the terminal are rendered.
    """
    import termios
    import tty

    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        print(file=out)
        print("Is this something to fix, or are you telling me how I'm doing?", file=out)
        print("[Enter/f] something to fix        [t] telling you how you're doing", file=out)
        answer = sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
    print(file=out)
    return "correction" if answer.lower() == "t" else "request"


def _read_typed_body() -> str:
    """This surface's one text-entry grammar: read stdin until a line
    containing exactly '.' (or EOF), then strip.

    Shared by compose and answer mode rather than written twice. One
    window, one way to type into it — a second grammar would be a second
    thing to learn about the same box, and the '.' terminator is already
    the thing a resident's fingers know.
    """
    lines: list[str] = []
    for raw_line in sys.stdin:
        line = raw_line.rstrip("\n")
        if line.strip() == ".":
            break
        lines.append(line)
    return "\n".join(lines).strip()


def run_compose(castle, out=sys.stdout, kind: str = "request") -> int:
    interactive = sys.stdin.isatty()
    if interactive:
        print("Describe the problem in your own words.", file=out)
        print("End with a line containing just '.' (or Ctrl-D).", file=out)
        print(file=out)

    body = _read_typed_body()

    if not body:
        print("castle-modal: empty request, nothing filed.", file=sys.stderr)
        _pause_for_dismissal(out)
        return 1

    # An interactive session is always asked, regardless of --kind (that
    # flag exists for non-interactive callers, who have no keyboard to
    # ask); a piped session keeps whatever --kind supplied (default
    # "request", so every existing piped caller is unchanged).
    if interactive:
        kind = _classify_interactively(out)

    if kind == "correction":
        record_id = castle.file_correction(body=body, refs=[], surface="modal")
        print(record_id, file=out)
        if interactive:
            print(f"Filed as {record_id}. Thanks — noted.", file=out)
    else:
        record_id = castle.write_record(
            castle.journal_dir(),
            type="request",
            provenance="requested",
            seat="intake",
            body=body,
        )
        print(record_id, file=out)
        if interactive:
            print(f"Filed as {record_id}. Check back with castle-modal --mode status.", file=out)
    _pause_for_dismissal(out)
    return 0


# ---------------------------------------------------------------------------
# Answer mode (docs/tasks/0022-answer-in-ui.md). The third kind of
# resident speech this window carries: describing a problem (compose),
# volunteering feedback nobody asked for (compose's classification
# step), and — here — closing a question the system opened. Proposal 05
# says only the resident may close one; this mode's whole job is making
# that cheap without widening what counts as an answer.
#
# Everything this mode prints obeys one vocabulary rule: no record ids,
# and none of the words seat, provenance, refs, journal, record,
# channel, evidence, and no fact names. That binds the text this tool
# *adds*. The question and root-request bodies it shows are the worker's
# or the resident's own prose, shown verbatim and unfiltered.
# ---------------------------------------------------------------------------

# Nine, because this is a picker meant to fit one screen, not a
# paginated list. Past nine, the overflow line names the count honestly
# rather than silently truncating.
ANSWER_PICKER_LIMIT = 9


def _first_line(text: str) -> str:
    stripped = text.strip()
    return stripped.splitlines()[0] if stripped else ""


def _pending_questions(records: dict) -> list:
    """Every `question` no answer names, oldest first.

    A flat pass over the journal, deliberately NOT the transitive errand
    walk `run_status` does: `_collect_downstream` follows `refs` from a
    root request, so a question whose refs chain never reaches one —
    which `castle record --type question` can legitimately produce, with
    no --refs at all — would never appear in an errand-keyed fold. A
    surface whose entire job is "nothing you are supposed to answer stays
    silently unanswerable" cannot inherit a fold that can hide a question
    by construction.

    Pending is the direct predicate, exact rather than heuristic:
    file_answer guarantees every answer's refs is exactly the one
    question it closes, so there is no ambiguity to approximate around.
    It is the same test castle's own pendingness check and the status
    surface's "waiting on you" overlay apply.

    Sorted by full id, which is chronological only to one-second
    granularity (review round 1, finding 7): `make_id` prefixes a
    UTC timestamp and appends a *random* suffix, so two questions filed
    in the same second sort by that suffix rather than by which came
    first. What the sort actually guarantees — and all the picker needs
    — is that the order is deterministic and identical on every
    invocation, so the number a resident presses means the same thing
    for as long as the list is on screen. Across seconds it is genuinely
    oldest-first, the same property `castle dispatch`'s own loop relies
    on.
    """
    answered = {ref for rec in records.values() if rec.type == "answer" for ref in rec.refs}
    return sorted(
        (rec for rec in records.values() if rec.type == "question" and rec.id not in answered),
        key=lambda rec: rec.id,
    )


def _about_line(castle, records: dict, question) -> str:
    """The first line of the request this question came out of, or "" if
    the walk reaches no request. No placeholder and no error in that
    case — a question filed by hand with no chain to an errand is
    exactly the kind this mode must still be able to show."""
    root = castle._find_root_request(records, question)
    if root is None:
        return ""
    return _first_line(root.body)


def _show_picker(castle, records: dict, pending: list, out=sys.stdout):
    """Print the picker and read the one keypress that answers it.
    Returns the chosen question record, or None for "close without
    answering."

    cbreak is engaged *before* anything is printed, for the reason
    `_classify_interactively` documents at length and this reuses
    verbatim: printing is I/O — a syscall reaching the pty — and a
    keypress landing in the gap between "prompt printed" and "cbreak
    engaged" is held by the kernel's still-canonical line discipline
    until a newline arrives, which a bare digit keypress never sends,
    hanging the read forever.

    The keypress is a screen-relative index, never a record id: 1..9 is
    what satisfies "no internal identifiers as required input", and it
    is safe to treat as stable *because* the ordering is deterministic
    and recomputed once per invocation, not because the numbers mean
    anything durable.

    Past nine, `m` shows the next nine and wraps around after the last
    page (review round 1, finding 1). The cap alone made question ten
    unreachable — possibly the exact question a notification had just
    pointed the resident at — on a surface whose whole claim is that it
    cannot hide a question by construction. Paging keeps the
    one-keypress grammar: digits pick, `m` turns the page, anything
    else closes.
    """
    import termios
    import tty

    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    pages = max(1, (len(pending) + ANSWER_PICKER_LIMIT - 1) // ANSWER_PICKER_LIMIT)
    page = 0
    try:
        # cbreak stays engaged across every redraw, not just the first:
        # it is entered before anything is printed and left on until a
        # key ends the loop, so no page turn ever reopens the gap where
        # a keypress would be swallowed by the canonical line
        # discipline waiting for a newline that never comes.
        tty.setcbreak(fd)
        while True:
            start = page * ANSWER_PICKER_LIMIT
            shown = pending[start : start + ANSWER_PICKER_LIMIT]
            rest = len(pending) - len(shown)
            print("Waiting on you:", file=out)
            print(file=out)
            for index, question in enumerate(shown, start=1):
                print(f"  [{index}] {_first_line(question.body) or '(no text)'}", file=out)
                about = _about_line(castle, records, question)
                if about:
                    print(f"      about: {about}", file=out)
            if rest:
                print(file=out)
                print(f"…and {rest} more waiting — press m to see them.", file=out)
            print(file=out)
            if pages > 1:
                print(
                    "Press a number to answer, m for more, or any other key to close.",
                    file=out,
                )
            else:
                print("Press a number to answer, or any other key to close.", file=out)
            key = sys.stdin.read(1)

            # Explicit membership, not `str.isdigit()` (review round 1,
            # finding 5): isdigit() is true of '²' and of Eastern-Arabic
            # digits, and `int()` accepts the latter — so a stray
            # superscript crashed the picker and '٣' silently selected
            # the third entry. The live range is this page's own, so a
            # digit past the end of a short last page closes rather than
            # indexing off it.
            if len(key) == 1 and key in "123456789"[: len(shown)]:
                # Always an explicit selection, even when one question is
                # pending: a uniform grammar keeps "answering something
                # you did not choose" impossible by construction rather
                # than by luck.
                selected = shown[int(key) - 1]
                break
            if pages > 1 and key == "m":
                # Wraps, so the last page's `m` returns to the first
                # rather than dead-ending on a key the prompt still
                # offers.
                page = (page + 1) % pages
                print(file=out)
                continue
            selected = None
            break
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
    print(file=out)
    return selected


def _answer_refusal(exc) -> str:
    """Plain-language wording for each AnswerRefused kind, in compose
    mode's existing "nothing filed" vocabulary and naming no ids — the
    same refusal `castle answer` renders with the record id in it, said
    the way this surface is allowed to say it."""
    if exc.kind == "already_answered":
        return "castle-modal: that question was already answered elsewhere, nothing filed."
    if exc.kind == "no_such_record":
        return "castle-modal: no such question, nothing filed."
    if exc.kind == "wrong_type":
        return "castle-modal: that is not a question, nothing filed."
    if exc.kind == "unreadable_answer":
        # No path and no id, unlike the CLI's version of this same
        # refusal: this surface may not hand the resident a filename to
        # go and fix. It says what happened and that nothing was
        # written, which is the honest part they can act on.
        return "castle-modal: can't check that question is still open, nothing filed."
    return "castle-modal: empty answer, nothing filed."


def _run_answer_scripted(castle, question_id: str | None, out=sys.stdout) -> int:
    """The no-tty half of answer mode: --question or nothing.

    Guessing the oldest pending question in a script context would be a
    silent wrong-record path with no resident present to notice — worse
    than refusing outright. On success the answer's id goes to stdout:
    that is script output meant to be asserted on by a caller, not
    resident-facing prose, the same distinction `castle answer`'s own
    stdout already draws.
    """
    if not question_id:
        print(
            "castle-modal: questions are waiting, but this session has no terminal to "
            "choose one at — pass --question ID (scripts and CI only), or open the "
            "modal and pick.",
            file=sys.stderr,
        )
        return 1
    try:
        answer_id, _ = castle.file_answer(question_id=question_id, body=_read_typed_body())
    except castle.AnswerRefused as exc:
        print(_answer_refusal(exc), file=sys.stderr)
        return 1
    except castle.RecordError as exc:
        # The write-time refusals `write_record` itself owns — today,
        # an answer attempted from inside a worker turn (Proposal 05,
        # docs/tasks/0023 §5). Not a policy check duplicated here: the
        # policy lives in the one choke point every writer passes
        # through, and this is only the surface that reports it, so a
        # tenant that reached for this window instead of the CLI meets
        # a sentence rather than a traceback.
        print(str(exc), file=sys.stderr)
        return 1
    print(answer_id, file=out)
    return 0


def run_answer(castle, out=sys.stdout, question_id: str | None = None) -> int:
    records = castle.load_all(castle.journal_dir())
    pending = _pending_questions(records)
    interactive = sys.stdin.isatty()

    # A scripted caller naming a question goes straight to the write,
    # whatever the fold says (review round 1, finding 2). The friendly
    # "nothing is waiting" exit used to come first for everyone, which
    # quietly turned every documented --question refusal — a bogus id, a
    # request id, an already-answered question — into exit 0 with prose
    # on stdout, because those are exactly the cases where the fold is
    # likely to be empty. file_answer does all the checking; this path
    # only has to let it.
    if question_id and not interactive:
        return _run_answer_scripted(castle, question_id, out)

    if not pending:
        print("Nothing is waiting on you.", file=out)
        _pause_for_dismissal(out)
        return 0

    if not interactive:
        return _run_answer_scripted(castle, None, out)

    # An interactive session always shows the picker and always ignores
    # --question. A flag that preselects a question in a session a human
    # is looking at is precisely the "answering the wrong one" hazard
    # this design exists to prevent; --question exists for a context
    # with no human present to choose, and this is not that context.
    question = _show_picker(castle, records, pending, out)
    if question is None:
        # The keypress itself IS the dismissal — exit 0, no pause,
        # nothing written anywhere. Dismissal is a successful use of
        # this surface (the resident looked and chose not to act), and
        # there is no code path from here to a write: file_answer is
        # called only below, after a question was chosen and a body
        # typed. Demanding a second "press Enter to confirm you meant to
        # leave" after a deliberate choice is the friction this surface
        # exists to avoid.
        return 0

    # The full body, verbatim, never truncated. The picker's first-line
    # preview is a convenience for choosing among several; letting a
    # resident answer on a truncated understanding of the question is a
    # different thing entirely, and docs/tasks/0010's "no seat
    # paraphrases" extends to a read as naturally as to a write.
    print(question.body.strip() or "(no text)", file=out)
    about = _about_line(castle, records, question)
    if about:
        print(f"about: {about}", file=out)
    print(file=out)
    print("Answer in your own words.", file=out)
    print("End with a line containing just '.' (or Ctrl-D).", file=out)
    print(file=out)

    try:
        _, recorded_fact = castle.file_answer(question_id=question.id, body=_read_typed_body())
    except castle.AnswerRefused as exc:
        # Empty body, or the raced case: the question was answered by
        # another window or another process between the picker showing
        # it and this keypress landing. No re-prompt loop — that is a
        # state machine this surface does not need and a hang risk on a
        # pty-driven program; the chord is one keypress away.
        print(_answer_refusal(exc), file=sys.stderr)
        _pause_for_dismissal(out)
        return 1
    except castle.RecordError as exc:
        # See the piped path above: `write_record`'s own refusals,
        # reported rather than re-implemented.
        print(str(exc), file=sys.stderr)
        _pause_for_dismissal(out)
        return 1

    print(file=out)
    # No record id (compose mode's "Filed as {id}." is the pattern being
    # deliberately broken here, not copied). The second sentence that
    # used to follow — "Nothing picks this errand back up automatically
    # yet." — is deleted by docs/tasks/0023-resume-cold.md, exactly as
    # the comment that stood here anticipated: an answered *blocking*
    # question now does resume its errand.
    #
    # Nothing replaces it. "This errand will continue" would be true
    # only for a blocking question, and only on a host where dispatch
    # is enabled and running — this process knows the first from the
    # question record but never the second, and it does not itself
    # trigger anything. Promising a continuation this surface cannot
    # observe would be docs/tasks/0015's defect the other way up: a
    # label asserting an action nobody here can see happen. A bare
    # "Filed." is true on every path.
    print("Filed.", file=out)
    if recorded_fact is not None:
        # A write into the resident's own model that the resident is
        # never told about is authority exercised invisibly. One plain
        # line is the minimum that makes it real to the person it is
        # about — and the internal "recorded resident-model entry for
        # fact '...'" line, which names the fact key, must never reach
        # this surface. When nothing was written, silence is the honest
        # report that nothing else happened.
        print("Noted — I'll remember that.", file=out)
    _pause_for_dismissal(out)
    return 0


def _started_at(castle, claim) -> str:
    """A claim's start time as local wall-clock `HH:MM`.

    `created` is UTC, always (agent/castle's CREATED_FMT), and "started
    14:03" means nothing to a resident if 14:03 is in a timezone they
    don't live in. Falls back to the raw field if it doesn't parse —
    this is a status line, not a validator."""
    raw = claim.fields.get("created", "")
    try:
        when = dt.datetime.strptime(raw, castle.CREATED_FMT).replace(tzinfo=dt.timezone.utc)
    except ValueError:
        return raw or "?"
    return when.astimezone().strftime("%H:%M")


def _outcome_label(outcome: str, request_id: str) -> str:
    """One result's `outcome` as a resident-facing label.

    Every non-completed value names the retry command explicitly. That
    is docs/tasks/0015's lesson restated — "the label must not cause
    the inaction it describes": a label honest about failure but silent
    about what to do next repeats the same mistake in the other
    direction. An absent `outcome` means "done", deliberately and
    forever: every result written before that field existed is already
    permanent in an append-only journal and cannot be backfilled, so a
    pre-existing result whose body says "FAILED" in prose keeps reading
    as "done" — the same backward-compatibility posture
    `considered`/`propensity` already established. Nothing here greps a
    body for a word like "FAILED"; the field is the fact.
    """
    if outcome == "failed":
        return f"failed — castle work {request_id} to retry"
    if outcome == "timeout":
        return f"timed out — castle work {request_id} to retry"
    if outcome == "interrupted":
        return f"interrupted — castle work {request_id} to retry"
    if outcome and outcome != "completed":
        # An outcome from outside today's vocabulary — a later task
        # extending the contract, a hand-written record, a typo. Shown
        # verbatim with the retry hint rather than folded into "done":
        # `outcome` is a named cross-task contract (agent/README.md),
        # and defaulting an unrecognised member of it to success is the
        # exact failure this whole field exists to end — a surface
        # quietly reporting an errand as fine because it did not
        # understand what it was told. Absent and `completed` keep
        # meaning done, which is the append-only compatibility promise
        # and unchanged.
        return f"{outcome} — castle work {request_id} to retry"
    return "done"


def _errand_state(castle, request, downstream: list) -> str:
    """`result` was checked before question/answer, so 'done' won any
    errand that also had an unanswered question — but the worker prompt
    (agent/castle-worker-claude) explicitly tells tenants to "file the
    question alongside your result rather than stopping", so
    result+unanswered-question is the *normal* shape for a worker that
    needed input mid-errand, not an edge case. That made "waiting on
    you" — the one state this whole modal exists to surface — silently
    unreachable in exactly the flow the worker is instructed to use
    (0009 review pass finding 4). Reporting both when both apply is
    strictly more honest than picking one. The ", waiting on you"
    overlay below composes exactly as it always has — and it is now
    computed by pairing each question with an answer that names it,
    rather than by asking whether the fold contains an answer of any
    kind. The old form went quiet after the first answer, so a worker
    that raised a second question on the same errand waited on a
    resident who was never told.

    **The errand's state is the state of its newest turn.** Since
    docs/tasks/0021-auto-dispatch.md a result names the `claim` it
    closes, so "which turn are we talking about" is answerable — and it
    has to be asked, because keying on the newest *result* gets two
    real cases backwards. An errand whose retry completed, and whose
    older abandoned turn was reaped afterwards, has a newer
    `interrupted` result than its `completed` one: keyed on results it
    reads as interrupted forever, though it is finished. And an errand
    with a second turn that died leaves a claim no result closes, which
    an older result masks entirely. Older turns' accounts — reaped ones
    included — are history; the newest turn is the current truth. A
    journal with no `claim` records at all (everything written before
    this task) keeps the old newest-result behavior unchanged.

    "in progress" is now *earnable* (docs/tasks/0021 §4), which
    docs/tasks/0015 deliberately left it not being: a `claim` record
    says a worker turn began, and a live `flock` on that errand's lease
    says one is running right this second. Both, not either — a claim
    with a dead lease is an interrupted turn, and saying "in progress"
    about it would be exactly the absence-of-evidence guess 0015
    removed. It is also checked **first**, ahead of any result: an
    errand whose failed turn the resident is retrying right now must
    not be labelled with advice to run the very command that is already
    running (and would be refused the lease).

    The narrow race this live probe shares with the dispatch reaper's
    own probe is documented on agent/castle's `lock_is_held`, and
    accepted there.
    """
    request_id = request.id

    # Every question in this fold that no answer names. The old form
    # was `"question" in types and "answer" not in types`, which never
    # paired an answer with its question: one answered question made
    # the errand stop saying "waiting on you" forever, hiding every
    # later question the worker raised. Questions and answers are the
    # one thing that legitimately arrives here through the transitive
    # walk (a follow-up request's question is still this errand chain
    # waiting on the resident), so unlike the turn state below they are
    # deliberately NOT keyed to this request id.
    answered = {ref for rec in downstream if rec.type == "answer" for ref in rec.refs}
    waiting = any(
        rec.type == "question" and rec.id not in answered for rec in downstream
    )

    # `_collect_downstream` is transitive over `refs` with no keying by
    # type or by errand, which is right for the fold as a whole and
    # wrong for deriving *this* errand's turn state from it. A
    # follow-up filed with `castle ask --refs R1` pulls R2 into R1's
    # downstream, and R2's claims and results come with it — so an R1
    # that finished cleanly could be labelled from R2's abandoned turn
    # ("interrupted — castle work R1 to retry", about a turn that was
    # never R1's). Both selections are keyed to this request, the same
    # way agent/castle keys them: a claim belongs to the errand named
    # first in its `refs` (what the reaper uses to find the request),
    # and a result belongs to any errand it names (what `closing_result`
    # uses, and what lets `--refs R,C` close a turn by hand).
    results = sorted(
        (rec for rec in downstream if rec.type == "result" and request_id in rec.refs),
        key=lambda rec: rec.id,
    )
    claims = sorted(
        (
            rec
            for rec in downstream
            if rec.type == "claim" and rec.refs and rec.refs[0] == request_id
        ),
        key=lambda rec: rec.id,
    )

    base = None
    if claims:
        newest_claim = claims[-1]
        if castle.lease_is_held(request_id):
            base = f"in progress (started {_started_at(castle, newest_claim)})"
        else:
            # The result that closes *this* turn, not merely the newest
            # result on the errand — and the same two-clause rule the
            # dispatch reaper uses, from the same function, so the two
            # surfaces can never disagree about whether a turn was ever
            # accounted for. Clause (b) is what stops this label
            # masking a resident's own hand-written closure behind an
            # "interrupted" the reaper was about to contradict.
            closing = castle.closing_result(newest_claim, results, claims)
            if closing is not None:
                base = _outcome_label(closing.fields.get("outcome", ""), request_id)
            else:
                # The window between "the lease died" and "the next
                # dispatch sweep reaps it into a result". Nothing is
                # running, so "interrupted" is the honest label.
                base = f"interrupted — castle work {request_id} to retry"
    elif results:
        # No claim records anywhere on this errand: a journal from
        # before docs/tasks/0021, where nothing recorded turns at all.
        base = _outcome_label(results[-1].fields.get("outcome", ""), request_id)
    elif any(
        rec.type == "decision"
        and rec.fields.get("seat") == castle.DISPATCH_SEAT
        and rec.fields.get("watermark", "").strip()
        # Named in the watermark's own refs, not merely reachable from
        # this errand through one. The watermark excludes BY NAME
        # (docs/tasks/0021 §2.2), so a watermark that named a follow-up
        # request but not this one must not make this one claim it
        # predates dispatch — the same transitive contamination the
        # claim and result selections above are keyed against.
        and request_id in rec.refs
        for rec in downstream
    ):
        # The watermark names the requests it excluded in its own refs
        # (docs/tasks/0021 §2.2), which is exactly why it turns up in
        # this errand's downstream fold — so the reason nothing is
        # happening is already here, and "awaiting a worker" would be
        # 0015's failure again: a label promising a start that is never
        # coming, on an errand automatic dispatch has permanently
        # declined to touch.
        base = f"not started automatically (predates dispatch) — castle work {request_id} to run it"
    elif request.fields.get(castle.FILED_DURING_TURN_FIELD, "").strip():
        # A request a worker tenant filed during its own turn
        # (docs/tasks/0021 §2.4(e)). "Awaiting a worker" would be the
        # 0015 failure exactly: a label promising a start that is never
        # coming, because dispatch deliberately never starts these. Say
        # what is true and what to do about it.
        base = f"filed during a worker turn — castle work {request_id} to run it"

    # Naming the remedy, the same way every outcome label above does:
    # docs/tasks/0015's rule is that a label must not cause the inaction
    # it describes, and "waiting on you" was the one label on this
    # surface that told the resident something was wrong without telling
    # them what to do about it. CHORD COUPLING: Mod4+Shift+a is prose
    # here and a real binding in modules/home/default.nix's keybindings
    # attrset — change one and grep for the other (agent/castle's
    # notification carries the identical coupling, and the compose
    # chord's own mentions went stale exactly this way once already,
    # docs/tasks/0019).
    if waiting:
        hint = "waiting on you — press Mod4+Shift+a to answer"
        return f"{base}, {hint}" if base else hint
    return base or "awaiting a worker"


def run_status(castle, limit: int, out=sys.stdout) -> int:
    records = castle.load_all(castle.journal_dir())
    requests = sorted(
        (rec for rec in records.values() if rec.type == "request"),
        key=lambda rec: rec.id,
        reverse=True,
    )[:limit]

    if not requests:
        print("No errands yet. Press Mod4+Shift+Return and describe one.", file=out)
        # Both of this mode's exits pause, for the reason compose mode
        # already does (0009 review pass finding 5): the instant
        # anything binds status to a chord, a window with no pause opens
        # and closes in zero human-perceptible frames. Nothing binds one
        # today, but this task's own chord makes that shape one
        # keystroke away, and _pause_for_dismissal is isatty-gated
        # internally, so no piped caller changes behaviour.
        _pause_for_dismissal(out)
        return 0

    for req in requests:
        downstream = castle._collect_downstream(records, req.id)
        state = _errand_state(castle, req, downstream)
        first_line = req.body.strip().splitlines()[0] if req.body.strip() else "(no description)"
        print(f"[{req.id}] {req.fields.get('provenance', '?')} — {state}", file=out)
        print(f"    asked: {first_line}", file=out)
        decisions = sorted(
            (rec for rec in downstream if rec.type == "decision"),
            key=lambda rec: rec.id,
        )
        for decision in decisions:
            channel = decision.fields.get("channel", "")
            evidence = decision.fields.get("evidence", "")
            if channel:
                print(f"    decided -> {channel}: {evidence}", file=out)
            else:
                # A decision that routed nothing — today, the dispatch
                # watermark, which names the requests it excluded from
                # automatic starting in its own `refs` and therefore
                # lands in this errand's fold (docs/tasks/0021 §2.2).
                # "decided -> ?" would read as a routing that failed;
                # this reads as what it is, which for an excluded
                # request is exactly the explanation the resident wants
                # for why nothing is happening on its own.
                print(f"    noted: {evidence}", file=out)
        print(file=out)
    _pause_for_dismissal(out)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="castle-modal", description=__doc__)
    parser.add_argument(
        "--mode",
        choices=("compose", "status", "answer"),
        default="compose",
        help=(
            "compose a new request, fold recent errands, or answer a question the "
            "system is waiting on (default: compose)"
        ),
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=10,
        help="status mode: how many recent errands to show (default: 10)",
    )
    parser.add_argument(
        "--kind",
        choices=("request", "correction"),
        default="request",
        help=(
            "compose mode, non-interactive callers only: file the composed text as "
            "something to fix (request, the default — every existing piped caller "
            "is unaffected) or as unprompted feedback about how the system is doing "
            "(correction). An interactive session ignores this flag and asks in "
            "plain language instead; this name is for scripts and CI, never shown "
            "to the resident (docs/tasks/0010-correction-record.md scope 6)."
        ),
    )
    parser.add_argument(
        "--question",
        default=None,
        help=(
            "answer mode, non-interactive callers only: the id of the question to "
            "answer, read from stdin in the same '.'-terminated grammar. For scripts "
            "and CI, never shown to the resident — an interactive session ignores "
            "this flag entirely and always shows the picker, because preselecting a "
            "question for a human who is looking at the screen is exactly the "
            "answering-the-wrong-one hazard the picker exists to prevent "
            "(docs/tasks/0022-answer-in-ui.md scope 2)."
        ),
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    castle = _load_castle_module()
    if args.mode == "compose":
        return run_compose(castle, kind=args.kind)
    if args.mode == "answer":
        return run_answer(castle, question_id=args.question)
    return run_status(castle, args.limit)


if __name__ == "__main__":
    sys.exit(main())
