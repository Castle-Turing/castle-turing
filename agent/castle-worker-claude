  "Bash(swaymsg -t get_config:*)"
  "Bash(swaymsg -t get_outputs:*)"
  "Bash(swaymsg -t get_inputs:*)"
  "Bash(swaymsg -t get_seats:*)"
  "Bash(swaymsg -t get_version:*)"
