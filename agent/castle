class ApplyRefused(Exception):
    """The id handed to `castle apply` is not an authorization to spend.

    Raised before anything at all is written, and deliberately: a
    mistyped id, a record that is not an answer, an answer that is not
    an approval, one whose proposal was offered before an applier
    existed. None of those is an event the journal needs an opinion
    about, and writing one would put a permanent record in an
    append-only history to describe somebody's typo.

    Unreachable from the sweep, which only ever hands `_apply_one` an
    answer its own fold has already established all of this about — the
    same relationship `cmd_work`'s two recordless refusals have with
    `_eligible_requests`.
    """


class ApplyEnvironmentFault(Exception):
    """The applier could not use the checkout it was configured with.

    Raised by `_apply_one` *after* it has written the answer's
    `outcome: failed` result, exactly as `TenantNotRunnable` is — that
    record still lands, because it is what stops a broken environment
    producing a silent retry loop.

    What the exception adds is a signal to the sweep, and here it
    matters more than it does for a worker. A misconfigured
    `castle.agent.repo.private` is the same for every eligible approval,
    and any result at all bars a second automatic attempt — so a sweep
    that shrugged and carried on would burn *every resident
    authorization in the journal* on `failed` records in a single pass.
    An authorization is costlier and less repeatable than an errand's
    automatic attempt, which is why this aborts rather than continues.

    Carries the id of the result it already wrote, so a caller can point
    at it.
    """

    def __init__(self, message: str, result_id: str):
        super().__init__(message)
        self.result_id = result_id


def apply_timeout_seconds() -> int:
    """CASTLE_APPLY_TIMEOUT, tolerantly.

    `worker_timeout_seconds`' exact shape, for its exact reason: warn on
    stderr, fall back to the default, never refuse to do the work. A
    misconfigured timeout must not be the reason an authorized change
    goes unapplied.
    """
    raw = os.environ.get(APPLY_TIMEOUT_ENV)
    if raw is None or not raw.strip():
        return DEFAULT_APPLY_TIMEOUT_SECONDS
    try:
        value = int(raw.strip())
    except ValueError:
        print(
            f"castle apply: could not parse {APPLY_TIMEOUT_ENV} ({raw!r}) as a whole "
            f"number of seconds; using {DEFAULT_APPLY_TIMEOUT_SECONDS}",
            file=sys.stderr,
        )
        return DEFAULT_APPLY_TIMEOUT_SECONDS
    if value <= 0:
        print(
            f"castle apply: {APPLY_TIMEOUT_ENV} ({raw!r}) is not positive; using "
            f"{DEFAULT_APPLY_TIMEOUT_SECONDS}",
            file=sys.stderr,
        )
        return DEFAULT_APPLY_TIMEOUT_SECONDS
    return value


def _approval_binding(records: dict[str, Record], answer: Record):
    """The `(question, result)` an approving answer is bound to, or
    `(None, why)` if it is not an authorization this applier may spend.

    The reason half exists for the hand path only: the sweep's fold
    discards on the same predicate and says nothing, while a resident
    who typed an id deserves to be told which of these it failed.

    Three things, all required, and each one is the fold's version of a
    check `file_answer` already made at write time:

    * `refs[0]` resolves to a `question` carrying `proposal-sha256` —
      without the stamp there is no proposal here to have authorized,
      whatever the record says in prose;
    * that question carries `authorizes-apply: true` — the field
      docs/tasks/0026-apply-validate.md §A exists for. Its absence is
      the positive fact that this change was offered under a review
      screen saying in capitals that approving edits nothing, so the
      approval authorized a record and nothing more. Old approvals are
      inert here by construction, forever;
    * `refs[1]` resolves to a `result` — the same shape `cmd_validate`
      checks on every decision-bearing answer.
    """
    if len(answer.refs) < 2:
        return None, (
            "it names fewer than two records: a decision's first ref is the change it "
            "decides and its second is the exact proposal it was bound to"
        )
    question = records.get(answer.refs[0])
    if question is None or question.type != "question":
        return None, f"{answer.refs[0]} is not a question record"
    if not question.fields.get(PROPOSAL_SHA256_FIELD, "").strip():
        return None, (
            f"{question.id} carries no '{PROPOSAL_SHA256_FIELD}', so there is no "
            "proposal here that anything could have authorized"
        )
    if question.fields.get(AUTHORIZES_APPLY_FIELD, "").strip() != "true":
        return None, (
            f"{question.id} carries no '{AUTHORIZES_APPLY_FIELD}: true'. It was offered "
            "under the earlier statement that approving edits, commits and applies "
            "nothing, so approving it authorized the record and nothing more. That is "
            "not something a later change of wording can reach backwards and widen; "
            "if you want this change made, ask for it again "
            "(docs/tasks/0026-apply-validate.md §A)."
        )
    result = records.get(answer.refs[1])
    if result is None or result.type != "result":
        return None, f"{answer.refs[1]} is not a result record"
    return (question, result), ""


def _eligible_approvals(records: dict[str, Record]) -> list[Record]:
    """Every approval this sweep may spend, oldest first
    (docs/tasks/0026-apply-validate.md §B).

    An `answer` is eligible iff it approves, its question carries apply
    authority and a proposal stamp, its result resolves, and **no
    `result` record names it anywhere in its refs**. That last clause is
    the one-attempt bound, and it is structurally the same one
    `_requests_with_results` gives a request, for the same reason: a
    bound expressed as "does a record exist" cannot be reset by anything
    short of writing history. Any apply result at all bars a second
    automatic attempt, whatever its outcome — a refusal included, since
    the conditions that produced it do not clear themselves.

    The hand path is deliberately outside this bound. `castle apply
    <answer-id>` re-runs a spent authorization exactly as `castle work
    <id>` re-runs a resulted errand, and for the identical reason: that
    IS the retry path, and it is the only unbounded one.

    **One flat pass, not a per-answer rescan.** One sweep over the
    journal builds the set of ids any result names, then one filter over
    the answers: O(records), never answers × records. Stated because the
    neighbouring fold's cost is a filed backlog entry
    (docs/backlog/eligibility-fold-rescans-per-request.md, measured at
    130ms), and a future reader must not "tidy" this into the same
    shape.

    Nothing this repo writes puts an answer id in a `result`'s refs — a
    worker result names `[request, claim]` — so the set is exactly "ids
    some result accounts for", and only answer ids are ever tested
    against it.
    """
    named_by_results = {
        ref
        for rec in records.values()
        if rec.type == "result"
        for ref in rec.refs
    }
    eligible = [
        rec
        for rec in records.values()
        if rec.type == "answer"
        and rec.fields.get("decision", "").strip() == "approve"
        and rec.id not in named_by_results
        and _approval_binding(records, rec)[0] is not None
    ]
    eligible.sort(key=lambda rec: rec.id)
    return eligible


def _reconcile_in_flight(records: dict[str, Record]) -> list[str]:
    """Account for every attempt that touched a checkout and never wrote
    its result (docs/tasks/0026-apply-validate.md §C). Returns the ids
    of the records written.

    Runs before any fresh attempt, on both the sweep and the hand path.
    An answer with a marker is **not** re-attempted in the same
    invocation: the honest thing to write is what the marker proves,
    which is that an earlier attempt got as far as touching the
    checkout and cannot say what it left behind. Re-attempting on top of
    that is exactly what produces the contradiction — a
    `refused-tree-dirty` about the applier's own half-finished work, or
    a `refused-patch-stale` about a change that is already committed.

    The record is the no-conclusion shape: `outcome: failed`, no
    `apply-outcome`, which §H already renders as
    `could not be applied — castle apply <id> to try again`. So the
    answer is barred from automatic retry exactly like every other dead
    attempt, and the hand path stays open — and a hand retry re-runs the
    whole check suite, where the dirty and staleness checks refuse a
    double-apply honestly.

    Two markers get no record at all, and the difference is whether
    there is anything to say:

    * one naming an answer that does not resolve to an approving
      authorization — garbage, or a journal that moved underneath it.
      There is no record to write, because `refs` would have nothing
      truthful to point at.
    * one whose answer some result already names. That is a crash in the
      narrow window *after* the account landed and before the marker was
      removed, so the account already exists and a second one would be a
      duplicate claiming the attempt died when it did not.

    Both are removed with a note on stderr. Nothing happened to a
    checkout that this could name.
    """
    written: list[str] = []
    try:
        markers = sorted(apply_in_flight_dir().iterdir())
    except OSError:
        return written
    if not markers:
        return written

    accounted = {
        ref
        for rec in records.values()
        if rec.type == "result"
        for ref in rec.refs
    }
    root = os.environ.get(PRIVATE_ROOT_ENV, "").strip()
    for marker in markers:
        if not marker.is_file():
            continue
        answer_id, head_before, paths = _read_in_flight(marker)
        answer_id = answer_id or marker.name
        answer = records.get(answer_id)
        binding = (
            _approval_binding(records, answer)[0]
            if answer is not None and answer.type == "answer"
            else None
        )
        if binding is None or answer.fields.get("decision", "").strip() != "approve":
            print(
                f"castle apply: discarding an in-flight marker for {answer_id}, which "
                "is not an approval this journal has. Nothing was written.",
                file=sys.stderr,
            )
            _clear_in_flight(marker.name)
            continue
        if answer_id in accounted:
            print(
                f"castle apply: discarding an in-flight marker for {answer_id}, whose "
                "attempt is already accounted for by a result. Nothing was written.",
                file=sys.stderr,
            )
            _clear_in_flight(marker.name)
            continue

        question, _proposal = binding
        # Both shas, so the resident can see at a glance which side of
        # the commit the interruption fell on without running anything.
        head_now = ""
        if root:
            probe, _ = _run_git(root, ["rev-parse", "HEAD"], timeout=CHECKOUT_PROBE_SECONDS)
            if probe is not None and probe.returncode == 0:
                head_now = (probe.stdout or "").strip()
        moved = (
            "Your repository's head HAS moved since that attempt began, so the "
            "change was very likely committed."
            if head_now and head_before and head_now != head_before
            else "Your repository's head has NOT moved since that attempt began, so "
            "if anything reached your files it is uncommitted."
            if head_now and head_before
            else "Whether your repository's head has moved could not be established "
            "here."
        )
        detail = [
            f"What this was for: the change `{question.id}`, approved by "
            f"`{answer.id}`.",
            "",
            "An earlier attempt to make it was interrupted after it may have begun "
            "changing your configuration repository — the process was killed, or the "
            "machine stopped, before it could record what it had done. This record "
            "exists so that nothing later claims the change was refused when it may "
            "in fact be sitting in your repository.",
            "",
            f"Where the repository was when that attempt began: "
            f"`{head_before or '(no commits yet)'}`.",
            f"Where it is now: `{head_now or '(could not be read)'}`. {moved}",
        ]
        if paths:
            detail += [
                "",
                "The files that attempt was going to change:",
                "",
            ] + [f"    {_displayable(path)}" for path in paths]
        detail += [
            "",
            "Nothing was activated and nothing was pushed. Look at `git log` and "
            "`git status` in that repository, and when it says what you expect, "
            f"`castle apply {answer.id}` runs the whole thing again — every check "
            "included, so a change that is already there is refused rather than "
            "made twice.",
        ]
        try:
            result_id = _write_apply_result(
                answer,
                question,
                outcome="failed",
                apply_outcome="",
                detail_lines=detail,
            )
        except (RecordError, OSError) as exc:
            # The marker stays. Nothing was accounted for, so the next
            # run must find it again — that is the whole contract.
            print(
                f"castle apply: could not record the interrupted attempt for "
                f"{answer_id} ({exc}); its marker is left in place.",
                file=sys.stderr,
            )
            continue
        written.append(result_id)
        print(f"apply: {result_id} accounts for an interrupted attempt on {answer_id}")
    return written


def _hostname() -> str:
    """This machine's name, for the flake attribute the validation
    builds. A fact about the machine running the applier, never about
    the proposal — which is why the record states it and says so."""
    try:
        name = pathlib.Path(HOSTNAME_PATH).read_text(encoding="utf-8").strip()
    except OSError:
        name = ""
    return name or os.uname().nodename


def _patch_paths(root: str, sidecar: pathlib.Path) -> tuple[list[str] | None, str]:
    """The repository paths a patch touches, per git's own parser, or
    `(None, why)`.

    `git apply --numstat -z` and not a hand-rolled reader of `+++`
    lines: this is the same code that will apply the patch a moment
    later, so "which paths does this touch" is answered by the thing
    that decides it rather than by a second implementation free to
    disagree. `--numstat` touches nothing on disk.

    `-z` because a path is bytes and a resident's file names are their
    own business: the NUL-delimited form is the only one that does not
    quote, escape or mangle a name with a space, a quote or a newline in
    it. Its shape is `<added>\\t<deleted>\\t<path>NUL`, except for a
    rename, where the third field is empty and the two paths follow as
    their own NUL-terminated records — verified against git, not read
    off a manual page, and handled here because a `git diff`-format
    patch from some future tenant can carry one.

    **And the output is read as bytes, not as text** (Codex review on
    docs/tasks/0026-apply-validate.md, P2). `text=True, errors="replace"`
    turned any byte that is not valid UTF-8 into U+FFFD — in the one
    function whose whole reason for choosing `-z` was not to mangle a
    name. The damage was not cosmetic: the dirty check would then
    inspect a path that does not exist, find it clean, and the pathspec
    commit would fail *after* the working tree had already been
    modified. `surrogateescape` is the decode that round-trips: the
    original bytes come back out when Python encodes these strings into
    a subprocess argument list, so git receives exactly what it emitted.

    The cost is that these strings are **not safe to render**. A lone
    surrogate makes `write_text` raise, and records are UTF-8 by
    definition (docs/tasks/0033-byte-exact-proposal.md), so a path that
    reaches a record body, an error message or a notification must go
    through `_displayable` first. Nothing here renders one; the two
    places that do are marked.
    """
    git = shutil.which("git")
    if git is None:
        return None, "`git` is not on this session's PATH"
    try:
        probe = subprocess.run(
            [git, "-C", root, *GIT_ISOLATION_ARGS, "apply", "--numstat", "-z", "--", str(sidecar)],
            capture_output=True,
            timeout=CHECKOUT_PROBE_SECONDS,
            env=_git_stripped_env(),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return None, f"`git apply --numstat` could not be run there ({exc})"
    if probe.returncode != 0:
        # git's own message, which may itself name a path, so it is
        # decoded for display rather than for operation.
        detail = (probe.stderr or b"").decode("utf-8", "replace").strip()
        return None, detail or f"git exited {probe.returncode}"

    tokens = (probe.stdout or b"").split(b"\0")
    if tokens and tokens[-1] == b"":
        tokens.pop()
    paths: list[str] = []
    index = 0
    while index < len(tokens):
        fields = tokens[index].split(b"\t", 2)
        if len(fields) != 3:
            return None, f"could not read git's own numstat output: {tokens[index]!r}"
        if fields[2] == b"":
            # A rename: the two paths are the next two records.
            if index + 2 >= len(tokens):
                return None, "git's numstat output ended mid-rename"
            paths.extend(
                token.decode("utf-8", "surrogateescape")
                for token in tokens[index + 1 : index + 3]
            )
            index += 3
        else:
            paths.append(fields[2].decode("utf-8", "surrogateescape"))
            index += 1
    return paths, ""


def _displayable(value: str) -> str:
    """A path safe to write into a record, a message or a notification.

    `_patch_paths` decodes with `surrogateescape` so the original bytes
    survive back into git's argument list, which means a path whose name
    is not valid UTF-8 carries lone surrogates. Records are UTF-8 by
    definition, and `write_text` raises on one — so a path that has
    reached the point of being *shown* has to lose that property, while
    the value git is handed keeps it.

    `backslashreplace` rather than `replace`: an escape a resident can
    read back to the actual byte beats a row of U+FFFD that says only
    "something was here". A path that is ordinary UTF-8 — every path in
    practice — comes through untouched.
    """
    return value.encode("utf-8", "backslashreplace").decode("utf-8")


def _dirty_entries(
    root: str, paths: list[str]
) -> tuple[list[tuple[str, str]] | None, str]:
    """`(status-letters, path)` for everything uncommitted under
    `paths`, or `(None, why)` if git could not say.

    Two readers, and they are allowed to see different things — see
    `_dirty_under` below, which is the one that must not name a file.

    **Scoped to the patch's own paths, not repo-wide**, and that is a
    decision rather than an economy. Three documented layouts leave a
    perfectly healthy config repo dirty — a `state/` submodule dirties
    the outer gitlink on every journal commit, an un-gitignored
    `key.txt` shows as untracked, and the "set nothing" fallback leaves
    cleanliness unrelated to anything — so a repo-wide check would
    refuse forever on residents who did nothing wrong, which is worse
    than no check at all (docs/private-layer.md).
    """
    git = shutil.which("git")
    if git is None:
        return None, "`git` is not on this session's PATH"
    try:
        probe = subprocess.run(
            # `-z` here too, and literal pathspecs: this reads only the
            # two status letters off each record, but a path with a
            # newline in it would otherwise split one line into two and
            # inflate the count it reports.
            [
                git, "-C", root, *GIT_ISOLATION_ARGS,
                "status", "--porcelain", "-z", "--", *_literal(paths),
            ],
            capture_output=True,
            timeout=CHECKOUT_PROBE_SECONDS,
            env=_git_stripped_env(),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return None, f"`git status` could not be run there ({exc})"
    if probe.returncode != 0:
        detail = (probe.stderr or b"").decode("utf-8", "replace").strip()
        return None, detail or f"git exited {probe.returncode}"
    records = [record for record in (probe.stdout or b"").split(b"\0") if record]
    entries: list[tuple[str, str]] = []
    index = 0
    while index < len(records):
        raw = records[index]
        entries.append(
            (
                raw[:2].decode("utf-8", "replace").strip() or "??",
                raw[3:].decode("utf-8", "surrogateescape"),
            )
        )
        # A rename or a copy staged in the index emits its SOURCE path as
        # its own following record, with no status letters on it.
        # Skipping that record is what keeps the count a count of paths
        # rather than of records.
        index += 2 if raw[:1] in (b"R", b"C") else 1
    return entries, ""


def _dirty_under(root: str, paths: list[str]) -> tuple[str | None, str]:
    """`_dirty_entries` summarised the way a refusal about the
    RESIDENT'S OWN work must be: status letters and a count, never file
    names.

    That distinction is the whole reason there are two functions. A path
    the approved change touches is one the resident read on the review
    screen and can be named back to them; a path they happen to be
    working on is theirs, and this record is durable and leaves the
    machine more easily than a journal does (CLAUDE.md's hard rule).
    This is the caller for the second kind.
    """
    entries, why = _dirty_entries(root, paths)
    if entries is None:
        return None, why
    if not entries:
        return "", ""
    letters = sorted({letter for letter, _path in entries})
    return f"{len(entries)} path(s), status {', '.join(letters)}", ""


# How long one git command that WRITES the resident's checkout may take.
# Much longer than `CHECKOUT_PROBE_SECONDS`, which bounds a `rev-parse`
# that answers instantly, because these do real work on real files and
# may be doing it on a network mount. Bounded at all for the reason
# every other subprocess here is: an unattended sweep that hangs is
# indistinguishable from one that is working.
APPLY_GIT_SECONDS = 120

# **The resident's git hooks do not run on the applier's commit**, and
# this is a correctness property rather than tidiness (code review on
# docs/tasks/0026-apply-validate.md, finding 1, reproduced).
#
# The whole design rides on a digest chain: the resident approved exact
# bytes, `patch-sha256` proves the bytes on disk are those bytes, and
# the commit message records that digest so the commit is checkable
# against the journal years later with no tooling. An ordinary
# formatting `pre-commit` hook breaks that chain silently — reproduced:
# the committed content was the patch's bytes plus the hook's, under a
# commit message asserting a digest that no longer described it. A
# `post-commit` hook is worse in a different direction: it can create or
# commit anything at all, so `rev-parse HEAD` afterwards names a commit
# the applier did not make, and the record's `git revert <sha>` then
# reverts the hook's work while leaving the approved change in place.
#
# It also closes a hole `_run_git`'s timeout cannot: `subprocess.run`'s
# timeout kills the direct child, so a hook that daemonises outlives it.
# A hook that never runs cannot.
#
# **Two mechanisms, because one is not enough.** `--no-verify` skips
# `pre-commit` and `commit-msg` and nothing else; `core.hooksPath` is
# what stops `post-commit`, `post-index-change` and the rest.
#
# `/dev/null` is the hooks path deliberately. Any real directory has to
# exist and has to be trusted — `/var/empty` is neither guaranteed
# present nor guaranteed unwritable everywhere this runs, and a
# directory under the runtime dir would be world-writable on the `/tmp`
# fallback, which would replace the resident's own hooks with an
# attacker's. `/dev/null` can never be a directory on any Unix, so
# `access("/dev/null/pre-commit", X_OK)` fails with ENOTDIR and there is
# nowhere for anything to be planted. Verified against git 2.55: no
# warning, no hook, clean exit.
#
# None of this touches how the resident's own commits behave. Their
# hooks are their policy for their own work, and they still run on it.
# And `core.attributesFile`, for the same class of reason one level
# over. A `.gitattributes` clean filter runs at `add`/`commit` even with
# hooks disabled, and a clean/smudge pair can leave `git status`
# reporting a clean tree while the committed blob differs from the
# working-tree bytes — verified: with an ordinary
# `clean = sed s/MARKER:/MARKER:FILTERED/`, the parent, the commit count
# and the cleanliness check all passed and the commit held bytes nobody
# approved.
#
# **This closes half of it and cannot close the other half.** Git reads
# attributes from three places: the user's `~/.config/git/attributes`
# and the `core.attributesFile` it points at, `.git/info/attributes`,
# and `.gitattributes` files *inside the tree*. The first is switched
# off here outright. The last cannot be — it is tracked resident
# content, and the applier reading a resident's own repository has no
# standing to decide their `.gitattributes` does not apply to it; that
# file may be the very thing an approved change touches. So the in-repo
# half is **detected** rather than prevented: `_verify_single_commit`
# reads the committed blob back and compares it to the bytes on disk.
GIT_ISOLATION_ARGS = [
    "-c",
    "core.hooksPath=/dev/null",
    "-c",
    "core.attributesFile=/dev/null",
]


def _run_git(
    root: str,
    args: list[str],
    *,
    config: list[str] | None = None,
    env_extra: dict[str, str] | None = None,
    timeout: int = APPLY_GIT_SECONDS,
):
    """One `git` in the resident's checkout, with `GIT_*` stripped and
    the resident's hooks and user-level git attributes disabled (see
    `GIT_ISOLATION_ARGS`).

    `config` is per-invocation `-c key=value` settings. A parameter
    rather than something the caller splices into `args`, so `args[0]`
    is always the subcommand and the two error messages below can name
    it — and so nothing can accidentally land a `-c` before the hook
    suppression and shadow it.

    Returns `(CompletedProcess, "")`, or `(None, why)` when git could
    not be run to completion at all — not on disk, would not exec, or
    outlived its bound.

    **Never raises, and that is the point.** These run in the middle of
    a sequence that has already edited a resident's working tree, so an
    exception escaping here would abort the sweep with a traceback and
    write no record of what state that tree was left in. The two cases
    are kept distinct rather than folded into a nonzero return code
    because they mean different things: git speaking and refusing is a
    fact about the patch, while git never answering is a fact about the
    machine, and §F gives those two different records.

    The hook suppression is here, at the one choke point, rather than on
    the two invocations that run hooks today: a future call site added
    without it would reintroduce exactly the defect this closes, and
    `-c core.hooksPath=` costs nothing on a `rev-parse`.
    """
    git = shutil.which("git")
    if git is None:
        return None, "`git` is not on this session's PATH"
    settings = [item for value in (config or []) for item in ("-c", value)]
    # `env_extra` exists for exactly one variable — `GIT_INDEX_FILE`,
    # which is how the commit below is built without touching the
    # resident's real index. It is added *after* the strip, deliberately:
    # the strip is about not inheriting whatever the ambient environment
    # says a repository is, and this is this process saying it.
    env = _git_stripped_env()
    env.update(env_extra or {})
    try:
        return (
            subprocess.run(
                [git, "-C", root, *GIT_ISOLATION_ARGS, *settings, *args],
                capture_output=True,
                text=True,
                errors="replace",
                timeout=timeout,
                env=env,
            ),
            "",
        )
    except subprocess.TimeoutExpired:
        return None, f"`git {args[0]}` did not finish within {timeout}s"
    except OSError as exc:
        return None, f"`git {args[0]}` could not be run there ({exc})"


def _worktree_state(root: str, paths: list[str]) -> dict[str, tuple[str, bytes]]:
    """What each path looks like on disk right now, in a form two
    snapshots can be compared by.

    `("absent", b"")`, `("link", <target>)` or `("file", <bytes>)` — a
    symlink compares by its target, because that is what it *is*, and
    reading through it would compare whatever it happens to point at.
    An unreadable file comes back as `("unreadable", b"")`, which the
    caller treats as "do not touch this": a path it cannot see is one it
    must not decide it owns.
    """
    state: dict[str, tuple[str, bytes]] = {}
    for path in paths:
        target = pathlib.Path(root) / path
        try:
            if not os.path.lexists(target):
                state[path] = ("absent", b"")
            elif os.path.islink(target):
                state[path] = ("link", os.fsencode(os.readlink(target)))
            else:
                state[path] = ("file", target.read_bytes())
        except OSError:
            state[path] = ("unreadable", b"")
    return state


def _build_commit(
    root: str,
    snapshot: pathlib.Path,
    head_before: str,
    message: str,
) -> tuple[str, str, str]:
    """Build the commit the approved change produces, without touching
    the repository. Returns `(sha, failed_stage, detail)`.

    **This is docs/tasks/0026-apply-validate.md §D's landing sequence,
    and it replaces applying to the working tree and committing from
    it.** That older sequence had an irreducible race in it: between
    `git apply` writing the tree and the pathspec commit reading it
    back, anything at all — the resident, an editor, a formatter on save
    — could write one of those paths, and the commit then contained
    *their* bytes, certified under a message asserting the approved
    patch's digest. Nothing downstream could catch it either, because
    the committed blob and the working tree agreed: both held the
    concurrent edit (Codex review on this PR, round 4; reproduced).

    Constructing the commit from `head_before`'s tree plus the verified
    patch bytes, in a private index, removes the race rather than
    narrowing it. The content of the commit is a pure function of two
    things already verified, and the working tree is not one of them.
    Nothing here mutates anything: the temp index is a temp file, and
    the objects `write-tree`/`commit-tree` create are unreferenced until
    the caller moves a ref — which is why a failure at any stage below
    is a clean refusal with nothing to undo.

    **`git apply --cached` does not run `clean` filters** — established
    by running it, not by reading — so the tree holds the approved bytes
    exactly. That is strictly stronger than the blob comparison it
    replaces: a `.gitattributes` filter can no longer transform the
    commit at all, rather than being caught after the fact. The cost is
    stated where a resident meets it: in a repository whose filter would
    have canonicalised those bytes differently, git reports the file as
    modified until they decide what they want, and the record says so.

    **Nothing signs these commits, and that is right rather than
    incidental.** `commit-tree` does not sign, so a resident whose
    `commit.gpgsign` is on gets an unsigned commit here — as they
    should. The identity on it is the applier seat, not them, and
    signing a seat's commit with a resident's key would assert
    authorship they do not have.

    The stage name comes back so the caller can tell "this patch does
    not fit that tree" — a fact about the change, and a refusal — from
    "git would not run" — a fact about the machine.
    """
    index_fd, index_path = tempfile.mkstemp(prefix="castle-apply-index-")
    os.close(index_fd)
    index_env = {"GIT_INDEX_FILE": index_path}
    try:
        seed = ["read-tree", "--empty"] if not head_before else ["read-tree", head_before]
        for stage, args in (
            ("read-tree", seed),
            ("apply", ["apply", "--cached", "--", str(snapshot)]),
        ):
            probe, fault = _run_git(root, args, env_extra=index_env)
            if probe is None:
                return "", stage, fault
            if probe.returncode != 0:
                return "", stage, (probe.stderr or probe.stdout or "").strip()

        probe, fault = _run_git(root, ["write-tree"], env_extra=index_env)
        if probe is None or probe.returncode != 0:
            return "", "write-tree", (
                fault if probe is None else (probe.stderr or "").strip()
            )
        tree = (probe.stdout or "").strip()
        if not tree:
            return "", "write-tree", "git named no tree"

        # `-p` only when there is a parent: a repository with no commits
        # yet takes a root commit, which is a legitimate state — a patch
        # that only creates files applies to a fresh `git init`.
        commit_args = ["commit-tree", tree]
        if head_before:
            commit_args += ["-p", head_before]
        commit_args += ["-m", message]
        probe, fault = _run_git(
            root,
            commit_args,
            config=[
                f"user.name={APPLY_COMMIT_NAME}",
                f"user.email={APPLY_COMMIT_EMAIL}",
            ],
            env_extra=index_env,
        )
        if probe is None or probe.returncode != 0:
            return "", "commit-tree", (
                fault if probe is None else (probe.stderr or "").strip()
            )
        sha = (probe.stdout or "").strip()
        if not sha:
            return "", "commit-tree", "git named no commit"
        return sha, "", ""
    finally:
        try:
            os.unlink(index_path)
        except OSError:
            pass


def _paths_in_commit(
    root: str, sha: str, paths: list[str]
) -> tuple[set[str] | None, str]:
    """Which of `paths` the commit `sha` contains, or `(None, why)`.

    One `ls-tree` rather than a `cat-file` each, and `-z` for the same
    reason every other path-reading call here uses it: a name is bytes,
    and this must hand back exactly what git holds so the sync below can
    hand it straight back to git.

    Only presence is asked. Content is not compared against anything,
    and that is a change: the commit is built in a private index from
    `head_before` plus the verified bytes, so its content is a pure
    function of two already-verified inputs. Comparing it to a
    separately-derived post-image would mean re-implementing patch
    application here — a second implementation of the thing whose whole
    virtue is that git does it — and comparing it to the working tree is
    exactly the check the apply-to-commit race defeated.
    """
    git = shutil.which("git")
    if git is None:
        return None, "`git` is not on this session's PATH"
    try:
        probe = subprocess.run(
            [
                git, "-C", root, *GIT_ISOLATION_ARGS,
                "ls-tree", "-r", "-z", "--name-only", sha, "--", *_literal(paths),
            ],
            capture_output=True,
            timeout=CHECKOUT_PROBE_SECONDS,
            env=_git_stripped_env(),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return None, f"`git ls-tree` could not be run there ({exc})"
    if probe.returncode != 0:
        detail = (probe.stderr or b"").decode("utf-8", "replace").strip()
        return None, detail or f"git exited {probe.returncode}"
    return {
        record.decode("utf-8", "surrogateescape")
        for record in (probe.stdout or b"").split(b"\0")
        if record
    }, ""


def _sync_worktree(
    root: str,
    sha: str,
    paths: list[str],
    pre_images: dict[str, tuple[str, bytes]],
) -> tuple[list[str], list[str]]:
    """Bring the working tree and the index to the commit just made,
    without ever writing over somebody else's edit. Returns
    `(diverged, faults)`.

    The commit is already durable and already correct by the time this
    runs, which is what makes this step safe to do carefully rather than
    atomically. For each path, `pre_images` says what was on disk before
    any of this began:

    * unchanged since then — nobody else touched it — so the file is
      brought to what the commit says, by `checkout-index`, which
      applies the repository's own `smudge` filter and restores modes
      (a symlink comes back a symlink). That is exactly what the
      resident's own `git checkout` would produce.
    * changed since then — somebody wrote it during the window — so it
      is **left exactly as they left it** and named to the caller. Their
      edit becomes ordinary visible dirt over an approved commit, which
      `git status` will show them. Nothing is clobbered and nothing is
      claimed.

    The index is reset to the commit first, for both kinds of path,
    because otherwise every path would read as staged-for-reversal:
    nothing has updated the real index, so it still holds
    `head_before`'s entries while HEAD holds the new commit.

    A residual, stated rather than engineered around: an edit landing
    between the comparison and the write is still last-writer-wins on
    that one file. It cannot be closed without holding a lock on a
    resident's filesystem, and it no longer matters for the thing this
    task guarantees — the *commit* is the approved change either way.
    """
    diverged: list[str] = []
    faults: list[str] = []

    reset, fault = _run_git(root, ["reset", "-q", "--", *_literal(paths)])
    if reset is None or reset.returncode != 0:
        faults.append(
            "the index could not be brought to the new commit "
            f"({fault or (reset.stderr or '').strip()}), so `git status` will show "
            "these files as though the change were being undone until you run "
            "`git reset`"
        )

    present, why = _paths_in_commit(root, sha, paths)
    if present is None:
        faults.append(
            f"which files the commit contains could not be established ({why}), so "
            "the working tree was left alone"
        )
        return diverged, faults

    now = _worktree_state(root, paths)
    to_restore: list[str] = []
    for path in paths:
        if now.get(path) != pre_images.get(path):
            diverged.append(path)
            continue
        if path in present:
            to_restore.append(path)
        else:
            try:
                (pathlib.Path(root) / path).unlink()
            except FileNotFoundError:
                pass
            except OSError as exc:
                faults.append(f"{_displayable(path)} could not be removed ({exc})")

    if to_restore:
        checked_out, fault = _run_git(
            root, ["checkout-index", "-f", "--", *to_restore]
        )
        if checked_out is None or checked_out.returncode != 0:
            faults.append(
                "the working tree could not be brought to the new commit "
                f"({fault or (checked_out.stderr or '').strip()}); the commit itself "
                "is unaffected, and `git checkout HEAD -- .` in that repository "
                "finishes the job"
            )
    return diverged, faults


def _verify_single_commit(
    root: str, head_before: str, expected_sha: str
) -> tuple[str, str]:
    """Confirm the repository's head really is the commit this applier
    built, or `("", why)`.

    **Belt, since the construction moved.** These questions used to be
    the only thing standing between a hook and a false record; now the
    commit is built in a private index from `head_before` plus the
    verified patch bytes, and the ref moved under an old-value guard, so
    "exactly one commit, parented where this started, containing the
    approved bytes" is true by construction rather than by inspection.
    What is left for these to catch is the narrow thing construction
    cannot: something moving the ref again between that guarded update
    and this read.

    They are kept because they cost three `rev-parse`-class commands and
    the alternative is a record asserting a commit id it never looked
    at, printed beside a `git revert`.

    **Cleanliness is deliberately no longer among them.** The working
    tree is synced separately and per path, and there are two ordinary
    reasons for a path to be dirty afterwards that say nothing bad about
    the commit: a concurrent edit, which the caller records by name, and
    a repository whose own `clean` filter would canonicalise the
    approved bytes differently. Gating on cleanliness would turn either
    into `outcome: failed` over a commit that is exactly right.
    """
    head_probe, fault = _run_git(root, ["rev-parse", "HEAD"], timeout=CHECKOUT_PROBE_SECONDS)
    if head_probe is None or head_probe.returncode != 0:
        return "", (
            fault
            or "the repository has no HEAD after the reference was moved to one"
        )
    commit_sha = (head_probe.stdout or "").strip()
    if not commit_sha:
        return "", "git named no commit after the reference was moved to one"
    if commit_sha != expected_sha:
        return "", (
            "the repository's head is not the commit this built, so something else "
            "has moved it since"
        )

    if head_before:
        parent_probe, _ = _run_git(
            root, ["rev-parse", f"{commit_sha}^"], timeout=CHECKOUT_PROBE_SECONDS
        )
        parent = (
            (parent_probe.stdout or "").strip()
            if parent_probe is not None and parent_probe.returncode == 0
            else ""
        )
        if parent != head_before:
            return "", (
                "the new commit's parent is not where this started, so something "
                "other than this applier has committed here as well"
            )
        span = [f"{head_before}..{commit_sha}"]
    else:
        span = [commit_sha]
    count_probe, fault = _run_git(
        root, ["rev-list", "--count", *span], timeout=CHECKOUT_PROBE_SECONDS
    )
    if count_probe is None or count_probe.returncode != 0:
        return "", fault or "git could not count the commits this made"
    count = (count_probe.stdout or "").strip()
    if count != "1":
        return "", f"{count} commits landed where exactly one was expected"
    return commit_sha, ""


def _literal(paths: list[str]) -> list[str]:
    """Repository paths as **literal** pathspecs.

    `--` separates options from pathspecs; it does not stop git reading
    what follows as a pathspec *pattern*. So a resident's file called
    `weird*.nix` glob-matches other files, and one whose name begins
    with a colon is read as pathspec magic — in commands that add,
    commit and status exactly the set of paths a patch touched, where
    matching anything else is the failure. Every shape traced fails
    safe today (a wider match makes the commit contain more than the
    patch, which the verification above then refuses), but "fails safe
    by luck" is not a property to leave standing.

    `:(literal)` is git's own answer and takes no escaping rules of our
    own: everything after it is the path, byte for byte (code review on
    docs/tasks/0026-apply-validate.md).
    """
    return [f":(literal){path}" for path in paths]


def _write_apply_result(
    answer: Record,
    question: Record,
    *,
    outcome: str,
    apply_outcome: str,
    detail_lines: list[str],
    commit_sha: str = "",
) -> str:
    """The one record an apply writes (docs/tasks/0026-apply-validate.md
    §F).

    **A `result`, and no new record type.** `RECORD_TYPES` is a schema
    surface the router's `to_route` tuple, every fold, `cmd_digest` and
    the README's vocabulary all key on, and nothing here needs a type
    that `result` does not already mean: an account of a turn a seat
    ran.

    **`refs: [answer-id, question-id]`, and deliberately NOT the
    request.** `closing_result`'s clause (b) treats any result naming a
    claim's request, newer than the claim and naming no claim of that
    request, as the account closing that claim — and the reaper passes
    it every result in the journal. An apply result naming the request
    would therefore silently close a genuinely dangling worker claim, so
    an errand whose hand-run retry died would be labelled with the
    *apply's* outcome and never reaped. Leaving the request out makes
    the apply invisible to both `closing_result` and `_errand_state`'s
    result selection, which is exactly right: an apply is not a turn of
    the errand. Lineage is unharmed — `_find_root_request` walks
    `refs[0]` transitively and reaches the request through the answer
    and the question — so `castle digest`'s grouping and the router's
    evidence sentence are correct with no change anywhere.

    **`outcome` is not widened, and never will be by this task.**
    agent/README.md reserves the field name *and* its four values for
    0026 and 0027 by name. The split that makes reusing them honest:
    `outcome` is an observation about the applier's own run — the
    epistemic shape the field already has — and `apply-outcome` is an
    observation about the change. A refusal is `outcome: completed`
    because the applier ran to a recorded conclusion, and a conclusion
    correctly reached is not a failure of the run.

    **No `claim` record, ever.** `_reap_interrupted` walks every claim
    and hands one whose request has no closing result an `interrupted`
    result and a `castle work <request-id>` retry hint — the wrong
    command for an apply that died, written by a reaper with no idea
    what it is reaping. An applier killed before it writes anything
    therefore leaves no record at all, and the next sweep simply finds
    the approval still eligible and tries once more. That is the honest
    behaviour: nothing was written, so nothing was attempted as far as
    the journal is concerned.

    Provenance is inherited from the answer, which `file_answer` always
    writes as `requested`, so the router notifies. That is intended: the
    resident authorized something, and the push channel is how they
    learn what happened to it. Which is why the body's first line is
    harness prose drafted in `APPLY_FIRST_LINES` — `_fire_notification`
    takes exactly that line, and a result's first line has leaked a
    store path onto the notification channel before.
    """
    first_line = APPLY_FIRST_LINES.get(apply_outcome)
    if first_line is None:
        # The two `outcome: failed` shapes that carry no `apply-outcome`
        # at all: an environment fault, and a target naming a role this
        # applier has no checkout for. Neither is a statement about the
        # change, which is precisely why neither gets a field that would
        # make one.
        first_line = (
            "Castle could not act on the change you approved, and nothing in your "
            "configuration repository was touched."
        )
    body_lines = [first_line, ""] + list(detail_lines)
    extra = {"outcome": outcome}
    if apply_outcome:
        extra[APPLY_OUTCOME_FIELD] = apply_outcome
    # Only ever passed by the one call site that got here through
    # `_verify_single_commit`, which is what makes the field's meaning
    # exact: not "a commit happened" but "exactly one commit landed,
    # parented where this started, with nothing left uncommitted, and
    # this is it." Every refusal and every attempt that reached no
    # conclusion passes nothing, matching the body prose, which names no
    # sha on those paths either.
    if commit_sha:
        extra[APPLY_COMMIT_FIELD] = commit_sha
    record_id = write_record(
        journal_dir(),
        type="result",
        provenance=answer.fields.get("provenance", "requested"),
        seat=APPLIER_SEAT,
        refs=[answer.id, question.id],
        body="\n".join(body_lines),
        extra=extra,
    )
    # The account of this attempt is durable as of the line above, so
    # the crash breadcrumb has nothing left to say. Cleared HERE, at the
    # one place that knows the record landed, rather than in a `finally`
    # around the apply: a `finally` also runs when `write_record` itself
    # raises, which is precisely the window the marker exists to cover.
    # Pre-mutation refusals never wrote one, so this is a no-op for them.
    _clear_in_flight(answer.id)
    return record_id


def _validation_command(private_root: str, host: str) -> list[str]:
    """The one command this task ever runs against Nix
    (docs/tasks/0026-apply-validate.md §E).

    Every flag is load-bearing rather than stylistic:

    * `--no-write-lock-file --no-update-lock-file` because 0024 verified
      by running it that a bare evaluation of a path flake creates or
      updates `flake.lock` in that directory, and `flake.lock` is the
      audit artifact Principle 02's third consequence names. A validator
      that silently updated a resident's lock would be making an
      unauthorized change while checking an authorized one.
    * `--no-link` so no `result` symlink, no GC root and nothing at all
      is left behind in the checkout.
    * `build`, never `nix flake check` — which builds every
      resident-authored `checks` output, unbounded work nobody asked for
      — and never a bare `nix eval`, which proves less than this task's
      own title claims: a configuration can evaluate and still fail to
      build.

    Never as root and never under `sudo`. An unprivileged process can
    evaluate and build a secrets-bearing configuration (sops-nix's
    evaluation-time check and its build-time `checkPhase` both need the
    sops file readable and neither needs the private key); what it can
    never confirm is that decryption would succeed, and the record must
    not imply otherwise.
    """
    return [
        "nix",
        "build",
        "--no-link",
        "--no-write-lock-file",
        "--no-update-lock-file",
        f"{private_root}#nixosConfigurations.{host}.config.system.build.toplevel",
    ]


def _evaluate_configuration(
    private_root: str, answer_id: str, detail_lines: list[str]
) -> tuple[str, str]:
    """Evaluate and build this machine's host configuration, if all
    three gates allow it. Returns `(state, outcome)` where `state` is
    one of "skipped" / "ok" / "failed" and `outcome` is the `outcome`
    field this contributes.

    Appends its own account to `detail_lines`, including — always,
    whether it ran or not — the exact command line, shell-quoted. That
    line is the dry-run seam this task's harness asserts argv against
    with no environment variable and no injection point that could drift
    from what production does, and it is also the one command a resident
    can paste to check the thing themselves.

    **Four gates, all required before `nix` is invoked at all.** The
    option, off by default; a state layout where evaluating would not
    publish the resident's whole decision history to the world-readable
    store; a private root whose path can be expressed as a flakeref at
    all; and `nix` actually being on PATH, which a host running the
    agent layer without `modules/dev` genuinely may not have. None of
    the four is a refusal to *apply*: the change is already committed
    by the time this runs, and the gate is on evaluation, which is the
    only step that copies anything anywhere.
    """
    host = _hostname()

    # **Before anything is built into a flakeref: can this path even be
    # one?** A flakeref splits the attribute path at `#` and the query
    # at `?`, so a private checkout whose own path contains either makes
    # `nix` resolve some shorter, wrong directory. Reproduced against
    # nix 2.34: it does not fail as a malformed argument, it fails as
    # "getting status of ... No such file or directory" — which arrived
    # here as a nonzero exit and was recorded as `validation-failed`, a
    # false claim that the resident's configuration no longer builds
    # (code review on docs/tasks/0026-apply-validate.md).
    #
    # Escaping was considered and there is nothing to escape *to*: a
    # path flakeref has no quoting rule for these, which is why they are
    # reserved. So this is a skip and not a refusal — the apply and the
    # commit are fine, and only the check is inexpressible.
    flakeref_reserved = sorted({char for char in FLAKEREF_RESERVED if char in private_root})

    def skip(reason: str, *, command: str | None) -> tuple[str, str]:
        detail_lines.append("")
        detail_lines.append(f"No evaluation was attempted: {reason}")
        if command is not None:
            detail_lines.append("")
            detail_lines.append("The check that would have run is:")
            detail_lines.append("")
            detail_lines.append(f"    {command}")
        return "skipped", "completed"

    if flakeref_reserved:
        # Deliberately BEFORE the hostname sentence and with no command
        # line printed: there is no command to print. Printing the one
        # that cannot work would be this record recommending the thing
        # that produced the wrong answer.
        return skip(
            "your configuration repository's own path contains "
            + " and ".join(f"`{char}`" for char in flakeref_reserved)
            + ", which Nix reads as flakeref syntax rather than as part of the "
            "path — so there is no way to name this repository to `nix build` at "
            "all. Nothing is wrong with the change, and nothing about it was "
            "checked. Moving the checkout to a path without those characters is "
            "the only fix; there is no escaping rule for them.",
            command=None,
        )

    argv = _validation_command(private_root, host)
    printable = shlex.join(argv)

    detail_lines.append("")
    detail_lines.append(
        f"The configuration checked is the one named by this machine's own hostname "
        f"(`{host}`), read from `{HOSTNAME_PATH}`. That is a fact about the machine "
        "this applier ran on, not about the change: nothing anywhere records which "
        "host configuration a proposal was meant for, and nothing here checked "
        "whether the change did what the proposal claimed."
    )

    if os.environ.get(APPLY_EVALUATE_ENV, "").strip() != "true":
        return skip(
            f"`castle.agent.apply.evaluateFlake` is off (it is off by default, and "
            f"wires ${APPLY_EVALUATE_ENV}). Turning it on lets this build the host "
            "configuration your change produces. Nothing is activated either way.",
            command=printable,
        )

    finding = _state_layout_finding(state_dir())
    if finding:
        return skip(
            "evaluating this flake would publish your own decision history, and "
            "unlike a rebuild it is this tool that would be making the copy — so it "
            f"declines rather than reports. What was found: {finding}",
            command=printable,
        )

    nix = shutil.which("nix")
    if nix is None:
        return skip(
            "`nix` is not on this session's PATH, so there is nothing here to "
            "evaluate with. Nothing about the change is in question; it simply was "
            "not checked.",
            command=printable,
        )

    timeout = apply_timeout_seconds()
    detail_lines.append("")
    detail_lines.append("The check that ran:")
    detail_lines.append("")
    detail_lines.append(f"    {printable}")

    timed_out = False
    try:
        proc = subprocess.Popen(
            [nix, *argv[1:]],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            errors="replace",
            # Its own process group, so the kill below reaches the
            # builders `nix build` spawns. Killing only the parent
            # leaves them running, which is the failure the worker seat
            # already learned once.
            start_new_session=True,
            env=_git_stripped_env(),
        )
    except OSError as exc:
        detail_lines.append("")
        detail_lines.append(f"It could not be started at all: {exc}")
        return "failed", "completed"

    pgid = proc.pid
    try:
        output, _ = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        _kill_tenant_group(pgid)
        try:
            output, _ = proc.communicate(timeout=TENANT_DRAIN_SECONDS)
        except subprocess.TimeoutExpired:
            output = ""
    output = output or ""

    # The whole of it to the spool, best effort. The spool is ephemeral,
    # lives under $XDG_RUNTIME_DIR, and is the named answer to "full
    # build logs and progress belong outside the durable journal". A
    # failure writing it is printed and ignored — it is never the reason
    # an apply is reported as failed.
    spool_path = spool_dir() / f"apply-{answer_id}.log"
    try:
        spool_path.write_text(output, encoding="utf-8")
        detail_lines.append("")
        detail_lines.append(f"Its full output is at `{spool_path}` until the next reboot.")
    except OSError as exc:
        print(
            f"castle apply: the validation's full output could not be spooled to "
            f"{spool_path} ({exc}); the record still carries its last "
            f"{APPLY_LOG_TAIL_LINES} lines.",
            file=sys.stderr,
        )

    tail = output.splitlines()[-APPLY_LOG_TAIL_LINES:]
    if tail:
        detail_lines.append("")
        detail_lines.append(
            f"The last {len(tail)} line(s) of its output:"
            if len(tail) < APPLY_LOG_TAIL_LINES
            else f"The last {APPLY_LOG_TAIL_LINES} lines of its output:"
        )
        detail_lines.append("```")
        detail_lines.extend(tail)
        detail_lines.append("```")

    if timed_out:
        detail_lines.append("")
        detail_lines.append(
            f"It outlived its {timeout}s bound and its whole process group was "
            "killed. Raise `castle.agent.apply.timeoutSeconds` if this machine "
            "legitimately needs longer."
        )
        return "failed", "timeout"
    if proc.returncode != 0:
        detail_lines.append("")
        detail_lines.append(f"It exited {proc.returncode}: the configuration does not build.")
        return "failed", "completed"
    return "ok", "completed"


def _apply_one(answer: Record, records: dict[str, Record]) -> tuple[str, str]:
    """Spend one authorization. Returns `(result_id, apply_outcome)`.

    Raises `ApplyRefused` before writing anything when the id is not an
    authorization at all, and `ApplyEnvironmentFault` — after writing
    the `outcome: failed` record — when the configured checkout cannot
    be used.

    The order of the pre-flight is docs/tasks/0026-apply-validate.md
    §C's, with one deliberate departure: the checks that resolve the
    decision run **before** the environment check, rather than after it
    as the brief lists them. They are the two that write no record, so
    running them first is what keeps a mistyped id from putting a
    permanent `failed` result in an append-only journal to describe
    somebody's typo. The brief carries the correction.
    """
    binding, why = _approval_binding(records, answer)
    if binding is None:
        raise ApplyRefused(why)
    question, proposal = binding
    if answer.fields.get("decision", "").strip() != "approve":
        raise ApplyRefused(
            f"it records `{answer.fields.get('decision', '').strip() or 'no decision'}`, "
            "not an approval. Only an approval authorizes anything to be made."
        )

    detail_lines: list[str] = []

    # ---------------------------------------------------------------
    # C.1 — the environment.
    # ---------------------------------------------------------------
    root = os.environ.get(PRIVATE_ROOT_ENV, "").strip()
    fault = _checkout_fault(root) if root else "it is not configured at all"
    if fault:
        # An **environment** fault, not a property of the proposal, so
        # it takes `outcome: failed` with no `apply-outcome` — exactly
        # what `_write_worker_result` does for a tenant that could not
        # be run. `_checkout_fault` is reused rather than
        # re-implemented, and the case that matters most here is the one
        # its own docstring says nothing downstream could detect: a root
        # that is a *subdirectory* of a checkout, whose diffs carry
        # paths relative to a root the applier will not be using. This
        # is that downstream step, and it detects it.
        detail_lines.append(
            f"Castle has no usable private checkout to make it in: {fault}. Set "
            "`castle.agent.repo.private` to the root of your own configuration "
            "checkout (it wires $" + PRIVATE_ROOT_ENV + ")."
        )
        detail_lines.append("")
        detail_lines.append(
            f"Nothing was read or written anywhere. The change you approved "
            f"(`{question.id}`) is untouched and can be applied by hand with "
            f"`castle apply {answer.id}` once the checkout is configured."
        )
        result_id = _write_apply_result(
            answer,
            question,
            outcome="failed",
            apply_outcome="",
            detail_lines=detail_lines,
        )
        raise ApplyEnvironmentFault(fault, result_id)

    detail_lines.append(
        f"What this applies: the change `{question.id}`, proposed by `{proposal.id}` "
        f"and approved by `{answer.id}`."
    )

    def refuse(apply_outcome: str, lines: list[str]) -> tuple[str, str]:
        result_id = _write_apply_result(
            answer,
            question,
            outcome="completed",
            apply_outcome=apply_outcome,
            detail_lines=detail_lines + [""] + lines,
        )
        return result_id, apply_outcome

    # ---------------------------------------------------------------
    # C.3 — the record is still the record that was authorized.
    # ---------------------------------------------------------------
    # Compared against the ANSWER's stamp, not the question's: the
    # answer's is the value that was verified at the moment authority
    # was granted (`file_answer` writes it only after it matched).
    # Re-derived from disk right now, for `file_answer`'s own stated
    # reason — a check that re-reads from disk holds with no state
    # carried between the process that displayed something and the
    # process that acts on it.
    authorized_hash = answer.fields.get(PROPOSAL_SHA256_FIELD, "").strip()
    try:
        current_hash = hashlib.sha256(proposal.path.read_bytes()).hexdigest()
    except OSError as exc:
        return refuse(
            "refused-artifact-changed",
            [
                f"The proposal it was bound to could not be read ({exc}), so there is "
                "no way to confirm that what is on disk is what you approved."
            ],
        )
    if not authorized_hash or current_hash != authorized_hash:
        return refuse(
            "refused-artifact-changed",
            [
                "The proposal you approved is not the one on disk now: its contents "
                "hash differently than they did when your approval was recorded. "
                "Nothing here rewrites a record, so there is no version to prefer — "
                "it refuses rather than guessing which one you meant. Ask for the "
                "change again if you still want it."
            ],
        )

    # ---------------------------------------------------------------
    # C.4 — the exact bytes exist, and they are the exact bytes.
    # ---------------------------------------------------------------
    patch_digest = proposal.fields.get(PATCH_SHA256_FIELD, "").strip()
    sidecar = journal_dir() / f"{proposal.id}.patch"
    if not patch_digest or not sidecar.exists():
        # Not an exception but a named outcome: a result carrying no
        # diff boundary and no sidecar is approvable today — the review
        # surface deliberately renders such a body whole — so an
        # authorization can legitimately resolve to no bytes at all.
        return refuse(
            "refused-no-patch",
            [
                "No exact copy of the change was kept beside the proposal, so there "
                "is nothing to apply. The rendered copy in the proposal itself is for "
                "reading, not for applying: it has been through this format's own "
                "line handling and is not guaranteed byte-for-byte "
                "(docs/tasks/0033-byte-exact-proposal.md). Ask for the change again "
                "and it will be kept exactly this time."
            ],
        )
    try:
        sidecar_bytes = sidecar.read_bytes()
    except OSError as exc:
        return refuse(
            "refused-no-patch",
            [f"The exact copy of the change could not be read ({exc})."],
        )
    if hashlib.sha256(sidecar_bytes).hexdigest() != patch_digest:
        return refuse(
            "refused-artifact-changed",
            [
                "The exact copy of the change no longer matches the digest recorded "
                "beside it, so what is on disk is not what you approved."
            ],
        )

    # ---------------------------------------------------------------
    # C.5 — which checkout it is for.
    # ---------------------------------------------------------------
    target = proposal.fields.get(TARGET_FIELD, "").strip()
    detail_lines.append("")
    detail_lines.append(f"It was proposed against the **{target or 'unstated'}** checkout.")
    if target == "mechanism":
        return refuse(
            "refused-target-mechanism",
            [
                "That is the Castle Turing framework itself — the public project this "
                "machine's mechanism comes from — rather than your own configuration. "
                "This seat only ever writes your own checkout, and it has no "
                "authority over that one, so the change was not made anywhere. Your "
                "approval is recorded and remains the record of what you thought; the "
                "change is yours to carry upstream if you want it. Nothing about this "
                "says the change belongs somewhere else than where it was proposed."
            ],
        )
    if target != "private":
        # No third value is reachable through any writer here — a result
        # with no `target` never produced a proposal question at all,
        # and an unresolvable role is discarded before it is stamped —
        # so this is not given a refusal it could never earn. It takes
        # the same posture one layer down as the worker's own refusal to
        # record a role it cannot resolve: `outcome: failed`, and no
        # `apply-outcome`, because this says nothing about the change.
        result_id = _write_apply_result(
            answer,
            question,
            outcome="failed",
            apply_outcome="",
            detail_lines=detail_lines
            + [
                "",
                "That is not a checkout this applier has: it only ever writes the one "
                "you configured as your own. Nothing was touched anywhere.",
            ],
        )
        return result_id, ""

    # ---------------------------------------------------------------
    # C.5b — freeze the verified bytes.
    # ---------------------------------------------------------------
    # `sidecar_bytes` was hashed and checked against `patch-sha256`
    # above, but every git invocation from here on named `sidecar` —
    # the mutable path in the journal directory — rather than those
    # verified bytes. A sync or an edit landing in the window between
    # that check and `git apply` could substitute different bytes
    # under the same digest: a replacement patch touching the same
    # paths would then commit successfully under a commit message
    # still asserting the OLD patch's digest (Codex review on this PR,
    # finding 1). Snapshotting the verified bytes into a private temp
    # file — read by nothing else, never resynced — closes that
    # window: everything below reads only the copy this just wrote.
    snapshot_fd, snapshot_path_str = tempfile.mkstemp(
        prefix="castle-apply-patch-", suffix=".patch"
    )
    try:
        with os.fdopen(snapshot_fd, "wb") as fh:
            fh.write(sidecar_bytes)
        snapshot = pathlib.Path(snapshot_path_str)

        # -----------------------------------------------------------
        # C.6 — the resident's own uncommitted work, under these paths only.
        # -----------------------------------------------------------
        paths, why_paths = _patch_paths(root, snapshot)
        if paths is None:
            return refuse(
                "refused-patch-stale",
                [
                    "Git could not even read the change as a patch, so it certainly "
                    "cannot be made:",
                    "",
                    "```",
                    why_paths,
                    "```",
                ],
            )
        if not paths:
            return refuse(
                "refused-no-patch",
                ["The kept copy of the change touches no files at all."],
            )
        dirty, why_dirty = _dirty_under(root, paths)
        if dirty is None:
            return refuse(
                "refused-tree-dirty",
                [
                    "Whether you have uncommitted work under those files could not be "
                    f"established ({why_dirty}), and this will not write over work it "
                    "cannot see."
                ],
            )
        if dirty:
            return refuse(
                "refused-tree-dirty",
                [
                    f"You have uncommitted edits under the files it touches ({dirty}), and "
                    "it will not write over them. Your own `git status` will say which "
                    "files — they are deliberately not named here, because this record is "
                    "durable and your file names are yours. Commit or set aside that work "
                    f"and run `castle apply {answer.id}` again.",
                ],
            )

        # -----------------------------------------------------------
        # C.7 — does it still fit? Exactly, or not at all.
        # -----------------------------------------------------------
        # No fuzz, ever: no `-3`, no `--recount`, no `patch(1)` fallback. A
        # patch that does not apply exactly is not the change you approved,
        # and a three-way merge would produce a change nobody authorized.
        # This also stands in for the absent proposal-time revision stamp:
        # "has the tree moved since approval" is answerable only by asking
        # git whether the patch still fits, which is a more precise question
        # than comparing revisions anyway, since a revision that moved for
        # unrelated reasons is not staleness.
        check, check_fault = _run_git(root, ["apply", "--check", "--", str(snapshot)])
        if check is None:
            # git never answered, so nothing is known about the patch and
            # nothing was written. An environment fault, not a property of
            # the change — the same shape §C.1 takes, and it aborts the
            # sweep for the same reason: the next approval would meet the
            # identical broken machine.
            result_id = _write_apply_result(
                answer,
                question,
                outcome="failed",
                apply_outcome="",
                detail_lines=detail_lines
                + [
                    "",
                    f"Castle could not ask git whether the change still fits: "
                    f"{check_fault}. Nothing was written anywhere.",
                ],
            )
            raise ApplyEnvironmentFault(check_fault, result_id)
        if check.returncode != 0:
            return refuse(
                "refused-patch-stale",
                [
                    "It no longer fits your configuration repository — the files it "
                    "changes are not in the state they were in when it was proposed. It "
                    "is applied exactly or not at all; nothing here merges, fuzzes or "
                    "guesses, because the result of that would be a change you never saw. "
                    "Git's own account:",
                    "",
                    "```",
                    (check.stderr or check.stdout or "").strip(),
                    "```",
                ],
            )

        # -----------------------------------------------------------
        # D — build the commit, move the ref, then sync the tree.
        # -----------------------------------------------------------
        # **The commit is constructed, not collected**, and that is the
        # change round 4 of review forced. The old sequence applied the
        # patch to the working tree and committed from it, which left an
        # irreducible window: anything writing one of those paths in
        # between — the resident, an editor, a formatter on save — got
        # its bytes committed and certified under a message asserting
        # the approved patch's digest, with the committed blob and the
        # working tree agreeing because both held the concurrent edit.
        # Reproduced. See `_build_commit`, which removes the race rather
        # than narrowing it: the commit's content is a pure function of
        # `head_before` and the verified patch bytes, and the working
        # tree is not an input to it at all.
        #
        # What is on disk right now, per path, so the sync below can
        # tell "nobody touched this" from "somebody did".
        pre_images = _worktree_state(root, paths)

        # An empty string is a legitimate answer: a repository with no
        # commits yet has no HEAD, and a patch that only creates files
        # applies to one perfectly well.
        head_probe, _ = _run_git(root, ["rev-parse", "HEAD"], timeout=CHECKOUT_PROBE_SECONDS)
        head_before = (
            (head_probe.stdout or "").strip()
            if head_probe is not None and head_probe.returncode == 0
            else ""
        )

        # Ids only, and never a path or a word of tenant prose: this
        # message is durable and leaves the machine more easily than a
        # journal does. The digest is what makes the commit checkable
        # against the journal years later with no tooling at all.
        errand = _find_root_request(records, question)
        message = "\n".join(
            [
                "castle: apply an approved change",
                "",
                f"errand:   {errand.id if errand is not None else '(none recorded)'}",
                f"change:   {question.id}",
                f"decision: {answer.id}",
                f"proposal: {proposal.id}",
                f"patch-sha256: {patch_digest}",
                "",
                "Applied by `castle apply` on the resident's recorded approval",
                "(docs/tasks/0026-apply-validate.md). Nothing was activated: no",
                "nixos-rebuild, no switch, no new generation.",
            ]
        )

        # Nothing below this line has touched the repository yet: a temp
        # index and some unreferenced objects. A failure here is a clean
        # refusal with nothing to undo, which is why the patch not
        # fitting is an ordinary named refusal rather than the alarming
        # "it passed a dry run and then would not apply" the old
        # sequence had to write.
        built_sha, failed_stage, build_detail = _build_commit(
            root, snapshot, head_before, message
        )
        if failed_stage == "apply":
            return refuse(
                "refused-patch-stale",
                [
                    "It no longer fits the commit it would be made on top of. Nothing "
                    "was touched: the change is built against your repository's "
                    "history before anything is written, so a change that does not "
                    "fit simply is not made. Git's own account:",
                    "",
                    "```",
                    build_detail,
                    "```",
                ],
            )
        if failed_stage:
            result_id = _write_apply_result(
                answer,
                question,
                outcome="failed",
                apply_outcome="",
                detail_lines=detail_lines
                + [
                    "",
                    f"Castle could not build the commit for it (`git {failed_stage}`: "
                    f"{build_detail}). Nothing in your configuration repository was "
                    "touched — the change is assembled before anything is written, "
                    "so a failure here changes nothing.",
                ],
            )
            raise ApplyEnvironmentFault(build_detail, result_id)

        # **The last line before anything in the resident's repository
        # moves**, and the window it covers is now only the reference
        # update and the working-tree sync below. If this process dies
        # in that window — killed, rebooted, or with `write_record`
        # itself failing — no result names this answer, so it stays
        # eligible and the next sweep would attempt it afresh: on a
        # landed commit, which refuses `refused-patch-stale`. A durable
        # record saying the applier declined a change that is in fact in
        # the resident's repository. The marker is what the next run
        # reads instead of guessing.
        _write_in_flight(answer.id, head_before, paths)

        # One guarded move. `--old-value` semantics: an empty
        # `head_before` means "this reference must not exist yet", which
        # is the root-commit case. Anything else committing here in the
        # meantime makes this fail loudly rather than splice a commit
        # onto history that moved.
        moved, moved_fault = _run_git(
            root, ["update-ref", "HEAD", built_sha, head_before]
        )
        if moved is None or moved.returncode != 0:
            return refuse(
                "refused-patch-stale",
                [
                    "Something else committed to your configuration repository while "
                    "this was being prepared, so the change was not made — it will "
                    "not splice a commit onto history that moved underneath it. "
                    "Nothing was touched. Git's own account:",
                    "",
                    "```",
                    moved_fault if moved is None else (moved.stderr or "").strip(),
                    "```",
                ],
            )

        diverged, sync_faults = _sync_worktree(root, built_sha, paths, pre_images)
    finally:
        # Best-effort: a leftover temp file is a cleanup nit, never a
        # correctness question.
        try:
            pathlib.Path(snapshot_path_str).unlink()
        except OSError:
            pass

    # Belt, not the guarantee — see `_verify_single_commit`. The commit
    # is right by construction; this catches something moving the
    # reference again between the guarded update and this read.
    commit_sha, landing_fault = _verify_single_commit(root, head_before, built_sha)
    if landing_fault:
        detail_lines.append("")
        detail_lines.append(
            "The commit was made, and the repository is not in the state that "
            f"implies: {landing_fault}"
        )
        detail_lines.append("")
        detail_lines.append(
            f"The commit this built is `{built_sha}` — it contains exactly the change "
            "you approved, because it was assembled from your repository's history "
            "plus those exact bytes. What cannot be vouched for is what your "
            "repository's history looks like now, so no commit is named here as "
            "*the* one to revert. Look at `git log` and `git status` before doing "
            "anything else. Nothing was rolled back, nothing was activated, and "
            "nothing was pushed anywhere."
        )
        result_id = _write_apply_result(
            answer,
            question,
            outcome="failed",
            apply_outcome="",
            detail_lines=detail_lines,
        )
        return result_id, ""

    detail_lines.append("")
    detail_lines.append(
        f"It is now one commit in your configuration repository: `{commit_sha}`, "
        f"on the branch that was checked out. It holds exactly the change you "
        f"approved: it was built from your repository's history plus those exact "
        f"bytes, so nothing that happened while it was being made could get into "
        f"it. Nothing was pushed anywhere, and nothing was activated — no rebuild, "
        f"no new generation, no change to the machine you are using. To undo it: "
        f"`git revert {commit_sha}`."
    )
    if diverged:
        # The unavoidable last-writer race, turned into visible dirt
        # rather than into either a lie or destroyed work.
        detail_lines.append("")
        detail_lines.append(
            "Something changed these files while the change was being made, so they "
            "have been left exactly as you left them rather than being overwritten:"
        )
        detail_lines.append("")
        detail_lines += [f"    {_displayable(path)}" for path in diverged]
        detail_lines.append("")
        detail_lines.append(
            "The commit above is still the change you approved. Your edits are on "
            "top of it, uncommitted, and `git status` will show them — `git diff` "
            "says what they are and nothing here has decided anything about them."
        )
    for fault in sync_faults:
        detail_lines.append("")
        detail_lines.append(
            f"The commit was made and one step of bringing your working files to it "
            f"did not finish: {fault}"
        )

    # Information, never a gate. The paths this synced should read clean
    # afterwards; when they do not, the likeliest reason by far is a
    # `.gitattributes` `clean` filter that would store those bytes in a
    # different canonical form than the ones that were approved. The
    # commit is still exactly the approved change — `git apply --cached`
    # does not filter — but git will go on reporting the file as
    # modified until the resident decides which form they want, and
    # meeting that with no explanation would be its own small failure.
    synced = [path for path in paths if path not in diverged]
    if synced:
        residue, _why_residue = _dirty_entries(root, synced)
        if residue:
            detail_lines.append("")
            detail_lines.append(
                "Your repository still reports these files as changed, even though "
                "the commit holds exactly the bytes you approved:"
            )
            detail_lines.append("")
            detail_lines += [
                f"    {_displayable(path)}" for _letters, path in residue
            ]
            detail_lines.append("")
            detail_lines.append(
                "That usually means a content filter in that repository (a "
                "`.gitattributes` `clean` rule) would store them in a different form "
                "than the one that was proposed to you. Nothing here decided between "
                "the two: the change you approved is what was committed, and git will "
                "keep showing the difference until you say which you want. These are "
                "files the change itself touched — nothing else in your repository "
                "was looked at."
            )

    state, outcome = _evaluate_configuration(root, answer.id, detail_lines)
    apply_outcome = {
        "ok": "applied-validated",
        "failed": "validation-failed",
        "skipped": "applied-unvalidated",
    }[state]
    if state == "failed":
        detail_lines.append("")
        detail_lines.append(
            "Nothing was undone and nothing was activated, so the machine you are "
            "using is exactly as it was. There is no automatic repair and no second "
            "attempt: the way to change this is to ask for a new change."
        )
    result_id = _write_apply_result(
        answer,
        question,
        outcome=outcome,
        apply_outcome=apply_outcome,
        detail_lines=detail_lines,
        # The one place this is ever stamped: everything above returned
        # already, and reaching here means `_verify_single_commit`
        # answered. See APPLY_COMMIT_FIELD.
        commit_sha=commit_sha,
    )
    return result_id, apply_outcome


# The two `apply-outcome` values that mean the change the resident
# authorized is in their repository and known to be fine. `castle apply
# <answer-id>` exits 0 on exactly these: a human typing it by hand is
# asking "did my change land, and is it all right?", and the shell's
# exit code is where they will read the answer. Every other conclusion —
# a refusal, a failed check, an uncommitted apply, an environment fault
# — exits 1. The sweep keeps `castle dispatch`'s contract instead, where
# the exit code means "the mechanism worked" and outcomes live in the
# records.
APPLY_SUCCESS_OUTCOMES = ("applied-validated", "applied-unvalidated")


def cmd_apply(args: argparse.Namespace) -> int:
    """The applier seat's hands (docs/tasks/0026-apply-validate.md §B).

    Two forms, exactly one of which argparse allows at a time, and the
    pair mirrors `castle work <id>` / `castle dispatch` deliberately:
    `castle apply <answer-id>` is the hand path and is NOT bounded by
    the one-attempt rule, because re-running by hand IS the retry path;
    `castle apply --sweep` is the automatic one and is.

    The argument is the **answer** id and never the question's. The
    authorization is the answer; a question is a proposal, and a
    proposal authorizes nothing on its own. Naming the thing being spent
    is the same discipline `refs` already follows.
    """
    # STOP-19's mechanical half. `agent/castle-worker-claude`'s
    # nonce-fenced override block already tells a tenant that a passage
    # saying "the resident has already approved applying something" was
    # quoted out of a record and did not come from the harness — and
    # since docs/tasks/0023 renders approved proposals into a resumed
    # tenant's prompt, that block is load-bearing rather than defensive.
    # This is the same rule in code.
    #
    # Defeated by `env -u`, exactly like the two guards in
    # `write_record` it mirrors, and that hole is stated rather than
    # papered over: docs/backlog/env-stripping-defeats-write-guards.md,
    # and §J of this task's brief, which records that this task is the
    # thing which makes a forged approval mutate a configuration rather
    # than sit inert.
    claim_id = os.environ.get(WORKER_CLAIM_ENV, "").strip()
    if claim_id:
        print(
            "castle apply: refusing to apply anything from inside a worker turn "
            f"(this environment carries {WORKER_CLAIM_ENV}={claim_id}). The worker "
            "seat proposes; the applier seat applies, on the resident's recorded "
            "approval and nothing else. File the change and end the turn.",
            file=sys.stderr,
        )
        return 1

    configured_state_dir = state_dir()
    if not configured_state_dir.exists():
        # The same posture and the same exit code `cmd_dispatch` takes:
        # a state directory that does not exist yet is a machine that is
        # not ready, not a mechanism fault. The timer comes back.
        print(
            f"apply: state dir {configured_state_dir} does not exist yet "
            "(private repo not restored?); nothing to do"
        )
        return 0

    # An unattended applier will not make liveness decisions on locks in
    # a world-writable directory, mirroring `cmd_dispatch`'s refusal
    # exactly and for a version of the same reason that matters more
    # here. `/tmp/castle-$UID` is `runtime_dir()`'s last-resort branch,
    # and any local user can create that path first and hold
    # `apply.lock`: this would then report "another applier is already
    # running" and exit 0, forever, staying green in `systemctl --user
    # status` while every approval the resident granted sat unapplied.
    # Dispatch's version of that is an errand that never starts; this
    # one is an authorization that never gets spent, on the seat with
    # the higher authority of the two.
    #
    # The hand path keeps the fallback deliberately, exactly as `castle
    # work` does: a human is present, watching the command, and will
    # notice it behaving strangely. Nobody is watching a timer.
    if args.sweep and runtime_dir_is_fallback():
        print(
            "castle apply: refusing to sweep with locks under "
            f"{runtime_dir()} — no XDG_RUNTIME_DIR and no /run/user/{os.getuid()}, "
            "so the only available lock directory is world-writable and an "
            "unattended applier cannot trust it. Run applying from a real login "
            "session (the systemd user units do), or run `castle apply "
            "<answer-id>` by hand, where a human is present to notice.",
            file=sys.stderr,
        )
        return 1

    lock = acquire_lock(apply_lock_path())
    if lock is None:
        # One applier at a time, machine-wide: they would all be writing
        # one working tree. Not an error — the other one is doing this.
        print("apply: another applier is already running; nothing to do")
        return 0
    try:
        try:
            records = load_all(journal_dir())
        except OSError as exc:
            print(f"castle apply: cannot read the journal: {exc}", file=sys.stderr)
            return 1

        # **Before anything fresh, on both paths.** An attempt that
        # touched a checkout and never wrote its account is the one
        # thing a re-attempt must not run on top of, so it is settled
        # first and the answers it settles are barred by their own
        # results from the fold below.
        reconciled = _reconcile_in_flight(records)
        if reconciled:
            records = load_all(journal_dir())

        if not args.sweep:
            if args.answer_id in {
                rec.refs[0]
                for rid in reconciled
                for rec in (records.get(rid),)
                if rec is not None and rec.refs
            }:
                # This invocation just wrote the account of an
                # interrupted attempt on the very id it was asked to
                # apply. It does NOT then proceed: the whole point is
                # that nothing knows what that attempt left behind, and
                # re-running on top of it is what manufactures the
                # contradiction. Running it again is one command away,
                # and the record says so.
                print(
                    f"castle apply: an earlier attempt on {args.answer_id} was "
                    "interrupted after it may have begun changing your configuration "
                    "repository; that is now recorded. Look at it, then run this "
                    "again.",
                    file=sys.stderr,
                )
                for rid in reconciled:
                    print(rid)
                return 1
            answer = records.get(args.answer_id)
            if answer is None or answer.type != "answer":
                print(
                    f"castle apply: {args.answer_id} is not an approval in this "
                    "journal. The argument is the id of the decision that approved a "
                    "change, not of the change itself.",
                    file=sys.stderr,
                )
                return 1
            try:
                result_id, apply_outcome = _apply_one(answer, records)
            except ApplyRefused as exc:
                print(f"castle apply: {args.answer_id} cannot be spent: {exc}", file=sys.stderr)
                return 1
            except ApplyEnvironmentFault as exc:
                print(f"castle apply: {exc}", file=sys.stderr)
                print(exc.result_id)
                return 1
            print(result_id)
            return 0 if apply_outcome in APPLY_SUCCESS_OUTCOMES else 1

        approvals = _eligible_approvals(records)
        if not approvals:
            print("apply: nothing eligible")
        applied = 0
        for answer in approvals:
            try:
                result_id, apply_outcome = _apply_one(answer, records)
            except ApplyRefused as exc:
                # Unreachable: the fold established every one of these.
                # Reported rather than crashed on, and never fatal to
                # the rest of the sweep.
                print(f"castle apply: skipping {answer.id}: {exc}", file=sys.stderr)
                continue
            except ApplyEnvironmentFault as exc:
                print(
                    f"castle apply: {exc}. Aborting the sweep rather than spending "
                    "every remaining authorization on the same broken checkout — see "
                    f"{exc.result_id}.",
                    file=sys.stderr,
                )
                return 1
            applied += 1
            print(f"apply: {result_id} spends {answer.id} -> {apply_outcome or 'failed'}")
        if applied or reconciled:
            # Exactly one route pass after the loop, the same tail step
            # `cmd_dispatch` runs and for the same reason: `route_journal`
            # is an idempotent whole-journal fold, so per-record routing
            # would buy nothing. It matters here rather than being left
            # to dispatch because a host may enable applying without
            # enabling dispatch, and then nothing else would ever fire
            # the notification that tells the resident what happened to
            # the change they authorized.
            #
            # The hand path deliberately does NOT route, exactly as
            # `castle work` does not: a human at a terminal can see what
            # happened, and `castle route` is one command away.
            return route_journal()
        return 0
    finally:
        lock.close()


def _collect_downstream(records: dict[str, Record], root_id: str) -> list[Record]:
    """Every record reachable from `root_id` along the lineage edge,
    plus anything naming `root_id` directly.

    **The lineage edge is `refs[0]`, and honouring it here is what stops
    one errand's fold reaching into another's.** This walk predates
    docs/tasks/0023 and used to follow *any* ref, which was harmless
    while every record's later refs pointed at things inside its own
    errand. That stopped being true when a resuming claim began naming
    the answers it spends: an `answer` can name blocking questions on
    two different errands (only the generic writer can produce that
    shape — `file_answer` refs one question), so from errand A the old
    walk reached A's question, the shared answer, then B's claim
    (`refs: B, <answer>`), and from there B's whole subtree. `castle
    digest` printed B's records under A, and `castle-modal --mode
    status` listed B's decisions as A's.

    The second clause — a record naming `root_id` anywhere in its refs
    — is not a loophole in the first; it is what keeps two existing
    shapes working. The dispatch watermark names every request it
    excluded in one record's `refs`, and only the first of them is at
    `refs[0]`, yet `_errand_state` finds that record in each excluded
    errand's fold to explain why nothing is happening. A result a
    resident hand-closed with `--refs <request>,<some-claim>` names its
    request directly too. Both are records *about* this root; what the
    first clause refuses is records about somebody else that merely
    mention something of ours in passing.

    Every record this repo writes is unaffected: a result's refs are
    `[request, claim]`, a claim's `[request, ...]`, a question's
    `[request]` or `[result]`, an answer's `[question]`, a decision's
    `[record]` — lineage first in every case. Proved by comparing both
    traversals over a journal built from all of those shapes rather
    than assumed; the only records the two walks disagree about are
    ones the generic writer alone can produce.

    Two such disagreements, both narrower than the leak they close and
    both stated rather than discovered later. A result a resident
    hand-closed as `--refs <request-A>,<claim-of-B>` now appears in A's
    fold only, not in B's — which is what `closing_result`'s own
    narrowing already decided about that record, applied one layer out.
    And a single answer naming questions on two errands appears in the
    fold of the errand whose question it names *first*, and not in the
    other's.

    That second one was briefly worse than it sounds, and the fix
    belongs on the record here because the shape of the residual
    changed. While `_errand_state` derived "which questions are
    answered" from this walk, an errand missing the shared answer said
    "waiting on you" permanently while the answer picker — which folds
    flat — declined to offer the question, because it is answered. Two
    surfaces contradicting each other about one record is the failure
    docs/tasks/0015 scope 3 names, and it was this narrowing that
    introduced it. `_errand_state` now takes `answered` from a flat
    pass, as `_pending_questions` and `file_answer`'s duplicate guard
    already did, so what remains is genuinely only which errand's
    *section* the answer record is listed under in the digest.
    Structurally it costs nothing either way: `_resumable_answers` does
    not use this walk at all, so spend and eligibility never depended
    on it.
    """
    collected: list[Record] = []
    seen = {root_id}
    changed = True
    while changed:
        changed = False
        for rec in records.values():
            if rec.id in seen:
                continue
            refs = rec.refs
            if refs and (refs[0] in seen or root_id in refs):
                collected.append(rec)
                seen.add(rec.id)
                changed = True
    return collected


def _digest_body(rec: Record) -> str:
    """A record's body, stripped of its diff's nonce boundary lines if
    it has any.

    `run_worker_turn` wraps a proposed diff in `CASTLE-DIFF-<nonce>
    BEGIN` / `END` lines and stamps the nonce in `DIFF_BOUNDARY_FIELD`
    so review mode can find the diff's exact edges without trusting
    body content as structure (see `diff_boundary_lines`). Review mode
    strips those two lines before showing a resident anything; this
    digest used to print the body verbatim instead, so a resident's
    digest carried a bare sixteen-hex-character token twice per
    proposal — meaningless to read and no part of the record's actual
    content. Reuses `diff_boundary_lines` rather than re-deriving the
    marker shape, the same way review mode's `_split_proposal_body`
    does, so the two readers cannot drift apart on what the boundary
    looks like.

    The ```diff fence stays: it is *inside* the boundary and is
    deliberate decoration (`diff_boundary_lines`'s own comment), not
    part of what this strips.

    A record with no `diff-boundary` field, or one whose stamped lines
    cannot be found (a truncated or hand-edited record), renders whole
    and unchanged — the documented meaning of "absent" every other
    reader of this field already gives it.
    """
    body = rec.body.strip()
    boundary = rec.fields.get(DIFF_BOUNDARY_FIELD, "").strip()
    if not boundary:
        return body
    begin, end = diff_boundary_lines(boundary)
    lines = body.splitlines()
    try:
        lines.remove(begin)
        lines.remove(end)
    except ValueError:
        return body
    return "\n".join(lines).strip()


def cmd_digest(args: argparse.Namespace) -> int:
    """Fold the journal into "what happened, and why" (architecture.md's
    digest surface). Invoked by hand — no scheduling in this skeleton.

    Corrections are not errands (no request, no downstream fold — see
    _errand_state in castle-modal for the same distinction on that
    surface) but they still need to be part of a "read the journal cold"
    account, so they get their own section rather than being silently
    absent (scope 7, docs/tasks/0010): every correction in the period,
    verbatim first line, created time, and any refs the resident
    supplied."""
    # Before anything is folded, and before the "No errands recorded"
    # early return below — a resident whose journal is still empty is
    # exactly the resident best placed to move it somewhere safe
    # (docs/tasks/0030-state-outside-the-flake.md).
    _warn_state_layout()
    records = load_all(journal_dir())
    requests = [rec for rec in records.values() if rec.type == "request"]
    corrections = [rec for rec in records.values() if rec.type == "correction"]
    if args.since:
        requests = [rec for rec in requests if rec.fields.get("created", "") >= args.since]
        corrections = [rec for rec in corrections if rec.fields.get("created", "") >= args.since]
    requests.sort(key=lambda r: r.id)
    corrections.sort(key=lambda r: r.id)

    if not requests and not corrections:
        print("No errands recorded.")
        return 0

    for req in requests:
        print(f"## Errand {req.id}")
        print(f"- provenance: {req.fields.get('provenance')}")
        print(f"- seat: {req.fields.get('seat')}")
        print(f"- created: {req.fields.get('created')}")
        print()
        if req.body.strip():
            print(req.body.strip())
            print()
        # Corrections are filtered out of the errand fold on purpose, and
        # this is the only place that filtering can happen:
        # `_collect_downstream` walks `refs` chains over every record type,
        # and `castle correct --refs <request-id>` is legal (cmd_correct
        # validates that a ref resolves, not what type it resolves to). So
        # a correction that cites the errand it was provoked by would
        # otherwise be swept into this fold *and* printed again in the
        # Corrections section below — contradicting both this function's
        # docstring and that section's own preamble ("Not an errand").
        # Corrections render in exactly one place: their own section.
        downstream = [
            rec for rec in _collect_downstream(records, req.id) if rec.type != "correction"
        ]
        downstream.sort(key=lambda r: r.id)
        for rec in downstream:
            print(f"### {rec.type} {rec.id} (seat: {rec.fields.get('seat')})")
            if rec.type == "decision":
                # Not every decision routes something. The dispatch
                # watermark (docs/tasks/0021 §2.2) names the requests it
                # excluded in its own `refs`, which is what puts it in
                # this fold at all — printing `channel: ?` for it would
                # invent a routing that never happened.
                if rec.fields.get("channel"):
                    print(f"- channel: {rec.fields['channel']}")
                print(f"- evidence: {rec.fields.get('evidence', '')}")
            # `outcome` rendered inline wherever a result carries one
            # (docs/tasks/0021 §4), beside the decision fields above.
            # The digest deliberately grows no lease reader to go with
            # it, and that asymmetry with castle-modal's `_errand_state`
            # is not the two surfaces disagreeing: a digest is a
            # historical account of a period that has already happened,
            # not a live view of what is running right now. Rendering
            # "in progress" here for an errand that finished between
            # the fold and the resident reading it would be exactly the
            # stale claim docs/tasks/0015 fixed the modal for. The live
            # check belongs only on the surface that is actually read
            # live.
            if rec.type == "result" and rec.fields.get("outcome"):
                print(f"- outcome: {rec.fields['outcome']}")
            # And `target` beside it (docs/tasks/0025-approval.md §J),
            # presentation only: `castle validate` already checks the
            # field's shape, and this fold was simply hiding it from a
            # resident reading a period's account cold — on the one
            # field 0026 will route an apply step on.
            if rec.type == "result" and rec.fields.get(TARGET_FIELD):
                print(f"- target: {rec.fields[TARGET_FIELD]}")
            # And `decision` beside those (docs/tasks/0025-approval.md
            # §G), presentation only in the same sense: `castle
            # validate` already checks the field's shape and its
            # vocabulary, this just stops hiding it. `defer` never
            # invites a comment and approve/reject only make one
            # optional, so a decision answer's body is usually empty —
            # without this line the digest for the one record type
            # that carries an authorization renders as a bare heading,
            # and a resident reading a period's account cold cannot
            # tell an approval from a rejection from a deferral.
            if rec.type == "answer" and rec.fields.get("decision"):
                print(f"- decision: {rec.fields['decision']}")
            body = _digest_body(rec)
            if body:
                print()
                print(body)
            print()

    if corrections:
        print("## Corrections")
        print()
        print(
            "Volunteered, unprompted — the resident's own words about how "
            "the system is doing (docs/tasks/0010-correction-record.md). "
            "Not an errand: nothing below is \"awaiting a worker\" or "
            "\"done,\" and none of it was routed."
        )
        print()
        for rec in corrections:
            body = rec.body.strip()
            first_line = body.splitlines()[0] if body else "(empty)"
            refs = rec.fields.get("refs", "")
            suffix = f" (refs: {refs})" if refs else ""
            print(f"- {rec.fields.get('created', '?')} — {first_line}{suffix}")
        print()

    return 0


def cmd_validate(args: argparse.Namespace) -> int:
    """Schema-check a journal. This is what CI asserts with (task 0008)."""
    jdir = pathlib.Path(args.journal) if args.journal else journal_dir()
    files = sorted(jdir.glob("*.md"))
    errors: list[str] = []
    records: dict[str, Record] = {}

    for path in files:
        try:
            rec = parse_record(path)
        except RecordError as exc:
            errors.append(str(exc))
            continue

        if rec.id:
            records[rec.id] = rec

        for field in REQUIRED_FIELDS:
            if field not in rec.fields:
                errors.append(f"{path.name}: missing required field '{field}'")

        if rec.fields.get("id") and rec.fields["id"] != path.stem:
            errors.append(
                f"{path.name}: id field {rec.fields['id']!r} does not match filename"
            )

        rtype = rec.fields.get("type")
        if rtype not in RECORD_TYPES:
            errors.append(f"{path.name}: invalid type {rtype!r}")

        provenance = rec.fields.get("provenance")
        if provenance not in PROVENANCE_VALUES:
            errors.append(f"{path.name}: invalid provenance {provenance!r}")

        # Proposal 04 given teeth: a decision without evidence doesn't
        # validate, full stop.
        if rtype == "decision" and not rec.fields.get("evidence", "").strip():
            errors.append(f"{path.name}: decision record missing non-empty 'evidence'")

        # `considered`/`propensity` (decision-only, written by cmd_route
        # for the counterfactual-logging reasons in agent/README.md) are
        # validated *when present*, not required. Deliberately not added
        # to REQUIRED_FIELDS or given an `evidence`-style hard check:
        # the journal is append-only (docs/architecture.md), so every
        # decision record written before this field existed is already
        # permanent, and a validator that suddenly required a field no
        # writer could have supplied at the time would fail the entire
        # pre-existing journal retroactively. `evidence` could be made
        # required because it existed from the schema's first commit;
        # these two cannot claim the same thing, so they get "well-formed
        # if present" instead of "must be present."
        # `outcome` (result-only, docs/tasks/0021 §3.5) gets exactly the
        # treatment `considered`/`propensity` already get, for exactly
        # the reason spelled out below them: validated when present,
        # checked for membership in the closed set, never required.
        # Every result written before this field existed is already
        # permanent in an append-only journal, and a validator that
        # suddenly demanded a field no writer at the time could supply
        # would fail the entire pre-existing journal retroactively.
        #
        # Scoped to results as well as checked for membership, and that
        # scoping is a correction made by docs/tasks/0025-approval.md
        # §F rather than something this block always had. `blocking`
        # (0023) and `target` (0024) each closed this same asymmetry for
        # themselves; `outcome` is the one instance that kept it, so an
        # `answer` record carrying `outcome: completed` wrote, exited 0
        # and validated clean. Nothing reads the field off any other
        # type, so such a record would validate, read as meaningful and
        # do nothing — and leaving the gap open invites the next reader
        # copying this family of checks to copy the one that forgot.
        outcome_raw = rec.fields.get("outcome")
        if outcome_raw is not None and rtype != "result":
            errors.append(
                f"{path.name}: 'outcome' is a result-record field and this is a "
                f"{rtype!r} record. Nothing reads it here, so it would validate, "
                "read as meaningful, and do nothing (docs/tasks/0021-auto-dispatch.md)."
            )
        elif outcome_raw is not None and outcome_raw not in OUTCOME_VALUES:
            errors.append(
                f"{path.name}: 'outcome' ({outcome_raw!r}) is not one of "
                f"{', '.join(OUTCOME_VALUES)}"
            )

        # `blocking` (question-only, docs/tasks/0023 §9) gets the same
        # treatment for the same append-only reason: checked when
        # present, never required, so no pre-existing question record
        # is failed retroactively by a field no writer could have
        # supplied. The check itself is narrower than `outcome`'s —
        # there is no vocabulary to test membership against, only the
        # one spelling this repo's only writer produces.
        #
        # Strict about that one spelling on purpose, and paired with
        # `_is_blocking`, which is strict in the other direction: the
        # fold declines to resume on any spelling but `true`, so a
        # hand-written `blocking: false` or `blocking: maybe` is inert
        # rather than dangerous. What it is not is *visible* — the
        # record sits there looking like it means something, doing
        # nothing. This check is what names it, the one time somebody
        # runs the validator. Neither guard replaces the other:
        # `castle validate` is advisory and nothing invokes it
        # automatically (`cmd_dispatch` reaps, folds, works and routes,
        # and never validates), so a guard that lived only here would
        # leave a real host acting on the value it was meant to catch.
        # It costs nothing retroactively either: the field is new, so
        # nothing already written can carry it.
        # Scoped to questions, and that scoping is a reversal: an
        # earlier pass deliberately left the check type-agnostic on the
        # grounds that a future seat might find a use for the field
        # elsewhere. That reasoning died when `cmd_record` began
        # refusing `--blocking` on any type but `question`. A validator
        # laxer than the writer makes the backstop weaker than the
        # door, and it is the backstop that matters here: the CLI can
        # only refuse what the CLI writes, while these files can be
        # hand-written, restored, or produced by some later tool. The
        # record `cmd_record` now refuses to write must not be the
        # record `castle validate` calls clean.
        blocking_raw = rec.fields.get(BLOCKING_FIELD)
        if blocking_raw is not None and rtype != "question":
            errors.append(
                f"{path.name}: '{BLOCKING_FIELD}' is a question-record field and this "
                f"is a {rtype!r} record. Nothing reads it here, so it would validate, "
                "read as meaningful, and do nothing (docs/tasks/0023-resume-cold.md)."
            )
        elif blocking_raw is not None and blocking_raw != "true":
            errors.append(
                f"{path.name}: '{BLOCKING_FIELD}' ({blocking_raw!r}) is present but "
                "is not the literal 'true' — the only spelling `castle record "
                "--blocking` writes. Absent means not blocking; there is no "
                "other value."
            )

        # `authorizes-apply` (question-only,
        # docs/tasks/0026-apply-validate.md §I), word for word
        # `blocking`'s two checks above and for word-for-word the same
        # reasons: type-scoped because nothing reads it off any other
        # record, and strict about the one spelling because the
        # applier's fold is strict in the other direction. A
        # hand-written `authorizes-apply: false` is inert rather than
        # dangerous — what it is not is *visible*, and this check is
        # what names it. No `cmd_record` writer guard is paired with it,
        # unlike `--blocking`'s, for the simple reason that
        # `cmd_record` has no generic field flag and so cannot write
        # this field at all.
        authorizes_raw = rec.fields.get(AUTHORIZES_APPLY_FIELD)
        if authorizes_raw is not None and rtype != "question":
            errors.append(
                f"{path.name}: '{AUTHORIZES_APPLY_FIELD}' is a question-record field "
                f"and this is a {rtype!r} record. Nothing reads it here, so it would "
                "validate, read as meaningful, and do nothing "
                "(docs/tasks/0026-apply-validate.md)."
            )
        elif authorizes_raw is not None and authorizes_raw != "true":
            errors.append(
                f"{path.name}: '{AUTHORIZES_APPLY_FIELD}' ({authorizes_raw!r}) is "
                "present but is not the literal 'true' — the only spelling "
                "`_file_proposal_question` writes. Absent means this proposal was "
                "offered under the older statement that approving applies nothing; "
                "there is no other value."
            )

        # `apply-outcome` (result-only, docs/tasks/0026-apply-validate.md
        # §I), the same "well-formed if present, never required"
        # treatment as everything above it. A membership test rather
        # than `target`'s open non-blank check, because unlike `target`
        # this vocabulary is closed by construction: exactly one writer
        # exists (`_apply_one`) and every surface that reads it
        # branches on the value.
        apply_outcome_raw = rec.fields.get(APPLY_OUTCOME_FIELD)
        if apply_outcome_raw is not None and rtype != "result":
            errors.append(
                f"{path.name}: '{APPLY_OUTCOME_FIELD}' is a result-record field and "
                f"this is a {rtype!r} record. Nothing reads it here, so it would "
                "validate, read as meaningful, and do nothing "
                "(docs/tasks/0026-apply-validate.md)."
            )
        elif apply_outcome_raw is not None and apply_outcome_raw not in APPLY_OUTCOME_VALUES:
            errors.append(
                f"{path.name}: '{APPLY_OUTCOME_FIELD}' ({apply_outcome_raw!r}) is not "
                f"one of {', '.join(APPLY_OUTCOME_VALUES)}"
            )

        # `apply-commit` (result-only,
        # docs/tasks/0026-apply-validate.md §F), the same "well-formed
        # if present, never required" treatment as everything above.
        # Absent means this result made no commit it can vouch for,
        # which is true of every refusal, every attempt that reached no
        # conclusion, and every result written before the field existed.
        #
        # **Forty OR sixty-four hex characters, and hard-coding forty
        # would have been a latent lie.** Git's sha256 object format is
        # real — `git init --object-format=sha256` — and a resident's
        # configuration repository is theirs to create however they
        # like. A validator that condemned a perfectly good sha256
        # commit id would be this project telling a resident their own
        # repository is malformed, which is exactly the shape of
        # false-refusal the path-scoped dirty check exists to avoid one
        # layer over. Both lengths, no third.
        apply_commit_raw = rec.fields.get(APPLY_COMMIT_FIELD)
        if apply_commit_raw is not None and rtype != "result":
            errors.append(
                f"{path.name}: '{APPLY_COMMIT_FIELD}' is a result-record field and "
                f"this is a {rtype!r} record. Nothing reads it here, so it would "
                "validate, read as meaningful, and do nothing "
                "(docs/tasks/0026-apply-validate.md)."
            )
        elif apply_commit_raw is not None and (
            len(apply_commit_raw) not in (40, 64)
            or any(char not in "0123456789abcdef" for char in apply_commit_raw)
        ):
            errors.append(
                f"{path.name}: '{APPLY_COMMIT_FIELD}' ({apply_commit_raw!r}) is not 40 "
                "or 64 lowercase hex characters — the two shapes a git commit id has "
                "(sha1 and sha256 object formats)."
            )

        # `target` (result-only, docs/tasks/0024 §6), same append-only
        # treatment again: checked when present, never required, so no
        # result written before this field existed is failed
        # retroactively.
        #
        # Two checks and deliberately not a third. Scoped to results,
        # mirroring `blocking`'s question-only scoping and for the same
        # reason: nothing anywhere reads `target` off another record
        # type, so one written there would validate, read as
        # meaningful, and do nothing. And non-blank, because a present
        # but empty field claims to name a checkout while naming none.
        #
        # What is deliberately absent is a membership test against a
        # fixed pair of words. `outcome` gets one because its four
        # values are a named cross-task contract several surfaces
        # branch on; `target` is two values today with room for a third
        # checkout role, and a closed vocabulary here would turn adding
        # one into a schema migration to buy safety nothing needs. See
        # TARGET_FIELD's own comment.
        target_raw = rec.fields.get(TARGET_FIELD)
        if target_raw is not None and rtype != "result":
            errors.append(
                f"{path.name}: '{TARGET_FIELD}' is a result-record field and this "
                f"is a {rtype!r} record. Nothing reads it here, so it would "
                "validate, read as meaningful, and do nothing "
                "(docs/tasks/0024-config-target.md)."
            )
        elif target_raw is not None and not target_raw.strip():
            errors.append(
                f"{path.name}: '{TARGET_FIELD}' is present but blank. It names which "
                "checkout this turn's diff is against; absent means no target was "
                "stamped, and there is no empty spelling of one."
            )

        # `diff-boundary` (result-only, docs/tasks/0025-approval.md §G),
        # same "well-formed if present" treatment: absent means this
        # result embeds no diff, which is true of every result written
        # before the field existed and of every turn that proposed
        # nothing. Scoped and shape-checked for the same reason
        # `blocking` and `target` are — nothing reads it off another
        # type, and a value that is not the nonce this repo's only
        # writer produces names a boundary no reader can find, which is
        # the silently half-rendered diff this field exists to make
        # impossible.
        boundary_raw = rec.fields.get(DIFF_BOUNDARY_FIELD)
        if boundary_raw is not None and rtype != "result":
            errors.append(
                f"{path.name}: '{DIFF_BOUNDARY_FIELD}' is a result-record field and "
                f"this is a {rtype!r} record. Nothing reads it here, so it would "
                "validate, read as meaningful, and do nothing "
                "(docs/tasks/0025-approval.md)."
            )
        elif boundary_raw is not None and (
            len(boundary_raw) != 16
            or any(char not in "0123456789abcdef" for char in boundary_raw)
        ):
            errors.append(
                f"{path.name}: '{DIFF_BOUNDARY_FIELD}' ({boundary_raw!r}) is not 16 "
                "lowercase hex characters — the only shape the eight random bytes "
                "this field carries can have."
            )

        # `patch-sha256` (result-only, docs/tasks/0033-byte-exact-
        # proposal.md), same "well-formed if present, never required"
        # treatment as `diff-boundary` right above it — absent means
        # this result embeds no diff, true of every result written
        # before this field existed. Unlike `diff-boundary`, a
        # well-formed value names a second file, so a well-formed
        # `patch-sha256` gets one check neither `diff-boundary` nor
        # `proposal-sha256` needs: does the sidecar it names actually
        # exist, and does it actually hash to this value. Absent means
        # absent — no sidecar is expected, and this block must not scan
        # the journal directory for stray `.patch` files nothing names;
        # an orphaned sidecar from a partially-written turn is not
        # itself a validation failure.
        patch_raw = rec.fields.get(PATCH_SHA256_FIELD)
        if patch_raw is not None and rtype != "result":
            errors.append(
                f"{path.name}: '{PATCH_SHA256_FIELD}' is a result-record field and "
                f"this is a {rtype!r} record. Nothing reads it here, so it would "
                "validate, read as meaningful, and do nothing "
                "(docs/tasks/0033-byte-exact-proposal.md)."
            )
        elif patch_raw is not None and (
            len(patch_raw) != 64
            or any(char not in "0123456789abcdef" for char in patch_raw)
        ):
            errors.append(
                f"{path.name}: '{PATCH_SHA256_FIELD}' ({patch_raw!r}) is not 64 "
                "lowercase hex characters — the only shape a SHA-256 digest has."
            )
        elif patch_raw is not None:
            # Keyed on `path.stem`, not `rec.id`: the sidecar was named
            # after the id that also names the record *file* (`_file_
            # proposal_question`'s caller writes both from the same
            # `result_id`), so the two agree for any well-formed
            # journal. A record whose `id` field disagrees with its own
            # filename is already flagged by the mismatch check above;
            # keying this lookup on `rec.id` would then go looking for a
            # sidecar named after an id that never named any file,
            # report a second, misleading "no sidecar" error, and never
            # check the sidecar that is actually sitting on disk beside
            # this record. `path.stem` reports about the file that is
            # really there (code review finding on this task).
            sidecar = path.parent / f"{path.stem}.patch"
            if not sidecar.exists():
                errors.append(
                    f"{path.name}: '{PATCH_SHA256_FIELD}' is present but no sidecar "
                    f"file exists at {sidecar.name} beside it."
                )
            else:
                try:
                    sidecar_bytes = sidecar.read_bytes()
                except OSError as exc:
                    # Reproduced: replace the sidecar with a directory
                    # and this raises `IsADirectoryError` uncaught —
                    # `validate`'s whole job is to report a broken
                    # journal, not to crash on one (code review finding
                    # on this task).
                    errors.append(
                        f"{path.name}: '{PATCH_SHA256_FIELD}' names sidecar "
                        f"{sidecar.name}, which could not be read: {exc}."
                    )
                else:
                    actual = hashlib.sha256(sidecar_bytes).hexdigest()
                    if actual != patch_raw:
                        errors.append(
                            f"{path.name}: '{PATCH_SHA256_FIELD}' ({patch_raw!r}) does "
                            f"not match the sidecar {sidecar.name}'s actual digest "
                            f"({actual!r})."
                        )

        # `decision` and `proposal-sha256`
        # (docs/tasks/0025-approval.md §F), same "well-formed if
        # present, never required" treatment as everything above, for
        # the same append-only reason. Both are type-scoped as well as
        # value-checked, following `blocking` and `target` rather than
        # the gap `outcome` had until this task.
        decision_raw = rec.fields.get("decision")
        if decision_raw is not None and rtype != "answer":
            # A `decision` on any other type is a fabricated
            # authorization: nothing reads it there, so it would
            # validate and read as one to a human skimming the journal
            # cold, which is worse than inert.
            errors.append(
                f"{path.name}: 'decision' is an answer-record field and this is a "
                f"{rtype!r} record. A decision on any other type is a fabricated "
                "authorization (docs/tasks/0025-approval.md)."
            )
        elif decision_raw is not None and decision_raw not in DECISION_VALUES:
            errors.append(
                f"{path.name}: 'decision' ({decision_raw!r}) is not one of "
                f"{', '.join(DECISION_VALUES)}"
            )

        hash_raw = rec.fields.get(PROPOSAL_SHA256_FIELD)
        if hash_raw is not None and rtype not in ("question", "answer"):
            errors.append(
                f"{path.name}: '{PROPOSAL_SHA256_FIELD}' belongs on the question that "
                f"proposes a change or the answer that decides it, and this is a "
                f"{rtype!r} record. Nothing reads it here, so it would validate, read "
                "as meaningful, and do nothing (docs/tasks/0025-approval.md)."
            )
        # Explicit membership rather than a regex or `str.isalnum()`,
        # the same reasoning castle-modal's picker gives for not using
        # `str.isdigit()`: the unicode-aware helpers are true of
        # characters no digest ever contains.
        elif hash_raw is not None and (
            len(hash_raw) != 64
            or any(char not in "0123456789abcdef" for char in hash_raw)
        ):
            errors.append(
                f"{path.name}: '{PROPOSAL_SHA256_FIELD}' ({hash_raw!r}) is not 64 "
                "lowercase hex characters — the only shape a SHA-256 digest has."
            )

        # A question carrying a proposal must not also elicit a fact:
        # the permanent-schema-gate form of `file_answer`'s own guard,
        # so the invariant does not depend solely on one write path
        # catching it. What it prevents is an approval laundered into a
        # durable stated preference the resident never stated.
        if rtype == "question" and hash_raw is not None and rec.fields.get("fact", "").strip():
            errors.append(
                f"{path.name}: a question carrying '{PROPOSAL_SHA256_FIELD}' also "
                "carries 'fact'. Deciding it would write a resident-model entry as a "
                "side effect of approving or rejecting a change "
                "(docs/tasks/0025-approval.md)."
            )

        # And the two shape rules `refs` is now responsible for on a
        # decision-bearing answer. Identifying the proposal by `refs`
        # rather than by a named field (§A) is only cold-readable if
        # something checks the shape refs took on: existence of the
        # refs is already checked below, but "the second one is the
        # result this decision is about" is not a property any existing
        # pass asks about.
        if decision_raw is not None and rtype == "answer":
            if hash_raw is None:
                errors.append(
                    f"{path.name}: 'decision' is present with no "
                    f"'{PROPOSAL_SHA256_FIELD}'. A decision names which exact bytes "
                    "it authorized, or it authorizes nothing checkable."
                )
            if len(rec.refs) < 2:
                errors.append(
                    f"{path.name}: 'decision' is present but refs names fewer than two "
                    "records. A decision's second ref is the result it decides "
                    "(docs/tasks/0025-approval.md)."
                )

        considered_raw = rec.fields.get("considered")
        considered_list: list[str] | None = None
        if considered_raw is not None:
            considered_list = split_refs(considered_raw)
            if not considered_list:
                errors.append(
                    f"{path.name}: 'considered' ({considered_raw!r}) is present but "
                    "not a non-empty flat list"
                )

        # A general invariant, not an assumption about today's specific
        # channel vocabulary: whatever was chosen must be among what was
        # weighed, for any policy this router ever runs (code-review
        # finding on this task — cmd_validate is the permanent schema
        # gate applied to every journal forever, including a future
        # router's, so this belongs here rather than only in
        # test/agent-loop/check_assertions.py's harness-specific check).
        # Only checked when both fields are present, same "well-formed
        # if present" treatment as everything else in this block.
        channel_raw = rec.fields.get("channel")
        if channel_raw is not None and considered_list is not None and channel_raw not in considered_list:
            errors.append(
                f"{path.name}: 'channel' ({channel_raw!r}) is not among 'considered' "
                f"({considered_raw!r})"
            )

        propensity_raw = rec.fields.get("propensity")
        if propensity_raw is not None:
            try:
                propensity_value = float(propensity_raw)
            except ValueError:
                errors.append(
                    f"{path.name}: 'propensity' ({propensity_raw!r}) is not a float"
                )
            else:
                if not (0.0 <= propensity_value <= 1.0):
                    errors.append(
                        f"{path.name}: 'propensity' ({propensity_raw!r}) is not in [0,1]"
                    )

        created = rec.fields.get("created", "")
        try:
            dt.datetime.strptime(created, CREATED_FMT)
        except ValueError:
            errors.append(f"{path.name}: 'created' ({created!r}) is not a valid UTC timestamp")

    for rec in records.values():
        for ref in rec.refs:
            if ref not in records:
                errors.append(f"{rec.path.name}: refs unknown record '{ref}'")

    # The two cross-record halves of docs/tasks/0025-approval.md §F,
    # here rather than in the per-file pass above because both need the
    # whole journal resolved.
    decided: dict[str, str] = {}
    for rec in sorted(records.values(), key=lambda r: r.id):
        if rec.type != "answer" or rec.fields.get("decision") is None:
            continue
        # Shape, not mere existence. The ref-existence pass above says
        # every ref points at *something*; this says the second one
        # points at the kind of thing a decision can be about. Without
        # it, "identify the proposal by refs rather than a field" is an
        # unchecked convention.
        if len(rec.refs) > 1:
            proposal = records.get(rec.refs[1])
            if proposal is not None and proposal.type != "result":
                errors.append(
                    f"{rec.path.name}: a decision's second ref must be the result it "
                    f"decides, and {rec.refs[1]} is a {proposal.type!r} record."
                )
        # At most one decision per question, and stated as exactly what
        # it is: a backstop, not a prevention. `file_answer`'s
        # already-answered scan closes this at write time for its own
        # callers and `cmd_record` refuses to write a decision at all,
        # but that scan is documented in its own comment as a
        # scan-then-write rather than a lock — so two concurrent review
        # sessions can both pass it before either writes. This is what
        # catches that narrow window afterwards.
        if rec.refs:
            first = rec.refs[0]
            if first in decided:
                errors.append(
                    f"{rec.path.name}: a second decision on {first}, already decided "
                    f"by {decided[first]}. Two decisions on one proposal leave nothing "
                    "able to say which one authorized it."
                )
            else:
                decided[first] = rec.id

    # The cross-record half of docs/tasks/0026-apply-validate.md §I, and
    # it is deliberately narrower than "at most one apply per
    # authorization." That bound is structural in the fold
    # (`_eligible_approvals` skips any answer some result already
    # names), but a hand-run `castle apply <answer-id>` is deliberately
    # allowed to retry — it is the retry path, exactly as `castle work`
    # is for an errand — so two apply results naming one answer are a
    # legitimate journal and not an error.
    #
    # What is checked instead is the one shape nobody should be able to
    # hand-write into a journal and have validate call clean: an apply
    # result claiming an authorization that does not exist. `refs[0]` is
    # the answer the apply spent, so it has to resolve to an `answer`
    # carrying `decision: approve`.
    #
    # **Keyed on the seat OR the field, and the "or" is a fix.** This
    # gated on `apply-outcome` alone, which silently exempted the shape
    # this same task introduced: an apply that reached no conclusion
    # about the change — an unusable checkout, an unresolvable target
    # role, a `git apply` git never finished, a commit whose landing did
    # not verify — writes `seat: applier` with `outcome: failed` and no
    # `apply-outcome` at all. So a hand-written `seat: applier` result
    # naming any real record at all passed clean, while
    # `_eligible_approvals` still counted it as having spent whatever
    # answer it names and `castle-modal`'s fold still recognised it by
    # seat. Fail-closed, and invisible to the one command whose job is
    # to name a broken journal (Codex review on
    # docs/tasks/0026-apply-validate.md).
    #
    # **Refs-shape only, deliberately, and it must stay that way.** This
    # cannot tell a forged suppressor from a legitimate dead attempt and
    # nothing appended-only ever could: both are `seat: applier`
    # results naming a real approving answer, which is exactly what a
    # genuine environment fault writes. The status fold already renders
    # both with the hand-retry remedy. All this owes is that a
    # *malformed* one is named rather than passed over.
    for rec in sorted(records.values(), key=lambda r: r.id):
        if rec.type != "result":
            continue
        if (
            rec.fields.get(APPLY_OUTCOME_FIELD) is None
            and rec.fields.get("seat") != APPLIER_SEAT
        ):
            continue
        authorization = records.get(rec.refs[0]) if rec.refs else None
        if (
            authorization is None
            or authorization.type != "answer"
            or authorization.fields.get("decision", "").strip() != "approve"
        ):
            # Wording true of both shapes it now covers. Saying "carries
            # 'apply-outcome' but…" would be a false statement about the
            # no-conclusion record, which is the half that was missing.
            errors.append(
                f"{rec.path.name}: an applier-seat result must spend a real "
                "authorization: its first ref has to resolve to an answer carrying "
                f"'decision: approve', and this one names "
                f"{rec.refs[0] if rec.refs else 'nothing'} "
                "(docs/tasks/0026-apply-validate.md)."
            )

    # Unconditionally, and outside the pass/fail branch below: an unsafe
    # state layout is a fact about the environment, not a malformed
    # record, so it must print whether or not the journal is
    # schema-clean — and it must not join `errors`, which would fail a
    # perfectly valid journal for a reason no edit to any record could
    # fix (docs/tasks/0030-state-outside-the-flake.md). Nothing about
    # this line changes the exit code.
    #
    # Asked of `state_dir()` rather than `jdir`: the question is where
    # the resident's state lives, and `--journal` points this command
    # at some other directory for a one-off check without moving
    # anything.
    _warn_state_layout()

    if errors:
        for err in errors:
            print(f"INVALID: {err}", file=sys.stderr)
        print(f"{len(errors)} error(s) across {len(files)} record(s) in {jdir}", file=sys.stderr)
        return 1

    print(f"OK: {len(files)} record(s) valid in {jdir}")
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    for directory in (journal_dir(), spool_dir()):
        path = directory / f"{args.id}.md"
        if path.exists():
            print(path.read_text(encoding="utf-8"), end="")
            return 0
    print(f"castle show: no such record: {args.id}", file=sys.stderr)
    return 1


# ---------------------------------------------------------------------------
# argparse wiring
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="castle", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p_ask = sub.add_parser("ask", help="intake: write a request record")
    p_ask.add_argument(
        "--provenance",
        choices=PROVENANCE_VALUES,
        default="requested",
        help="default 'requested': intake normally captures the resident asking directly",
    )
    p_ask.add_argument("--refs", default="", help="comma-separated ids this request responds to")
    p_ask.add_argument("text", nargs="*", help="the request body (or piped on stdin)")
    p_ask.set_defaults(func=cmd_ask)

    p_answer = sub.add_parser("answer", help="intake: write an answer record for a question")
    p_answer.add_argument("question_id", help="id of the question record being answered")
    p_answer.add_argument(
        "--fact",
        default=None,
        help=(
            "resident-model fact name this answer elicits (Proposal 05's write path). "
            "Normally read from the question record's own 'fact' field; pass this to "
            "override, or to supply one for a question that didn't carry it."
        ),
    )
    p_answer.add_argument(
        "--decision",
        choices=DECISION_VALUES,
        default=None,
        help=(
            "answering a proposed configuration change: approve it, reject it, or "
            "defer it (docs/tasks/0025-approval.md). Only valid against a question "
            "this system filed to propose a change, and nothing is applied by any of "
            "the three — the decision is recorded and that is all. The body stays "
            "optional here, and is stored verbatim whatever it says."
        ),
    )
    p_answer.add_argument("text", nargs="*", help="the answer body (or piped on stdin)")
    p_answer.set_defaults(func=cmd_answer)

    p_correct = sub.add_parser(
        "correct",
        help="intake: write a correction record — resident speech, unbidden, about how the system is doing",
    )
    p_correct.add_argument(
        "--refs",
        default="",
        help=(
            "comma-separated ids this correction is about — the record's one causal "
            "claim, resident-supplied only (docs/tasks/0010-correction-record.md)"
        ),
    )
    p_correct.add_argument("text", nargs="*", help="the correction body (or piped on stdin)")
    p_correct.set_defaults(func=cmd_correct)

    p_record = sub.add_parser("record", help="generic record writer (any seat, any type)")
    p_record.add_argument("--type", required=True, choices=RECORD_TYPES)
    p_record.add_argument("--provenance", required=True, choices=PROVENANCE_VALUES)
    p_record.add_argument("--seat", required=True, help="which seat is writing this record")
    p_record.add_argument("--refs", default="", help="comma-separated ids this record responds to")
    p_record.add_argument("--evidence", default=None, help="required in spirit on decision records")
    p_record.add_argument(
        "--fact",
        default=None,
        help="resident-model fact name (question records only, by convention) — see 'castle answer'",
    )
    p_record.add_argument(
        "--outcome",
        default=None,
        choices=OUTCOME_VALUES,
        help=(
            "what happened to a worker turn. Result records only, and enforced "
            "rather than left to convention since docs/tasks/0025-approval.md — "
            "`castle validate` rejects it on any other type, and a writer must "
            "not be able to produce a record its own validator condemns. A human "
            "holding the worker seat by hand should pass this: no surface may "
            "read failure out of prose, so a failed errand with no `outcome` "
            "field reads as done, forever (docs/tasks/0021-auto-dispatch.md)."
        ),
    )
    p_record.add_argument(
        "--target",
        default=None,
        help=(
            "which checkout this turn's diff is against — `private` or "
            "`mechanism`. The automatic path fills this in from whatever the "
            "tenant wrote to $CASTLE_TARGET_FILE; this flag is the same lever "
            "for a human holding the worker seat by hand, or a fixture building "
            "a result record directly. Enforced at write time, like --blocking "
            "and unlike --fact/--outcome: refused on any --type but result, and "
            "refused blank, because `castle validate` rejects both and a writer "
            "must not be able to produce a record its own validator condemns in "
            "an append-only journal. NOT restricted to those two words, though "
            "— a third checkout role should not need a schema migration "
            "(docs/tasks/0024-config-target.md)."
        ),
    )
    p_record.add_argument(
        "--blocking",
        action="store_true",
        help=(
            "this question stopped the errand: an answered blocking question "
            "makes its errand eligible for one more worker turn, exactly once "
            "(docs/tasks/0023-resume-cold.md). Unlike --fact and --outcome, "
            "which name their record type by convention, this flag is enforced "
            "at write time and refuses three things outright: any --type but "
            "question, --spool (the spool is ephemeral and no fold reads it), "
            "and a --refs whose FIRST entry does not walk back to a request "
            "record. The first ref is the whole test — resumption follows "
            "refs[0] and ignores the rest — so a correct id in second place is "
            "refused exactly like no id at all."
        ),
    )
    p_record.add_argument(
        "--decision",
        default=None,
        choices=DECISION_VALUES,
        help=(
            "accepted so this writer can refuse it by name rather than writing an "
            "unverified authorization: `castle record` never writes a decision "
            "field. Approving, rejecting or deferring a proposed change goes "
            "through `castle answer --decision` or castle-modal's review mode, the "
            "one path that checks the question really is a proposal, elicits no "
            "fact, and still hashes to the bytes it was filed against "
            "(docs/tasks/0025-approval.md)."
        ),
    )
    p_record.add_argument("--body", default=None, help="record body text")
    p_record.add_argument("--body-file", default=None, help="read the body from this file instead")
    p_record.add_argument(
        "--spool", action="store_true", help="write to the ephemeral spool instead of the journal"
    )
    p_record.set_defaults(func=cmd_record)

    p_route = sub.add_parser("route", help="router: append decision records for unrouted records")
    p_route.set_defaults(func=cmd_route)

    p_work = sub.add_parser("work", help="worker: run the configured tenant against a request")
    p_work.add_argument("request_id", help="id of the request record to work")
    p_work.set_defaults(func=cmd_work)

    p_dispatch = sub.add_parser(
        "dispatch",
        help="dispatch: one sweep — reap interrupted turns, work every eligible request, route once",
    )
    p_dispatch.add_argument(
        "--watermark-only",
        action="store_true",
        help=(
            "establish the dispatch watermark if this journal has never had one, "
            "then exit without sweeping; used by the session-start systemd unit "
            "(modules/agent's castle-dispatch-watermark)"
        ),
    )
    p_dispatch.set_defaults(func=cmd_dispatch)

    p_apply = sub.add_parser(
        "apply",
        help="applier: make one approved change in your configuration repository",
    )
    # Exactly one of the two forms, enforced by argparse rather than by
    # a hand-written check: an apply with neither an id nor --sweep has
    # no defensible default (applying "the obvious one" is a judgment
    # this seat must never hold), and one with both would have to
    # silently prefer one.
    p_apply_form = p_apply.add_mutually_exclusive_group(required=True)
    p_apply_form.add_argument(
        "answer_id",
        nargs="?",
        help=(
            "id of the ANSWER that approved the change — the authorization being "
            "spent, not the change itself. This is the hand path and it is "
            "deliberately unbounded: re-running it on an approval that already has "
            "an apply record is the retry, exactly as `castle work <id>` is for an "
            "errand."
        ),
    )
    p_apply_form.add_argument(
        "--sweep",
        action="store_true",
        help=(
            "apply every approval nothing has applied yet, oldest first, at most "
            "once each. What the castle-apply systemd unit runs "
            "(docs/tasks/0026-apply-validate.md)."
        ),
    )
    p_apply.set_defaults(func=cmd_apply)

    p_waiter = sub.add_parser(
        "notify-waiter",
        help=(
            "internal: the detached notification-action waiter the router "
            "spawns (docs/tasks/0034); not for humans"
        ),
    )
    p_waiter.add_argument("record_id")
    p_waiter.add_argument("title")
    p_waiter.add_argument("body")
    p_waiter.set_defaults(func=cmd_notify_waiter)

    p_digest = sub.add_parser("digest", help="fold the journal into a report")
    p_digest.add_argument("--since", default=None, help="only errands created at/after this timestamp")
    p_digest.set_defaults(func=cmd_digest)

    p_validate = sub.add_parser("validate", help="schema-check a journal")
    p_validate.add_argument("--journal", default=None, help="journal directory (default: the configured state dir)")
    p_validate.set_defaults(func=cmd_validate)

    p_show = sub.add_parser("show", help="print one record")
    p_show.add_argument("id", help="record id")
    p_show.set_defaults(func=cmd_show)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except RecordError as exc:
        # Every subcommand's write path funnels through write_record /
        # render_model_entry, both of which now raise RecordError rather
        # than silently writing something parse_record can't read back
        # (finding 6, 0009 review pass). One catch here, instead of one
        # in each subcommand, is what makes that guarantee — a future
        # write path gets the same clean failure for free.
        print(f"castle: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
