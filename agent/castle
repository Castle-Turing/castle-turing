class RecordError(Exception):
    """A record file did not parse as the strict frontmatter subset."""


class Record:
    """One parsed record: its frontmatter fields and its markdown body."""

    def __init__(self, fields: dict, body: str, path: pathlib.Path | None = None):
        self.fields = fields
        self.body = body
        self.path = path

    @property
    def id(self) -> str:
        return self.fields.get("id", "")

    @property
    def type(self) -> str:
        return self.fields.get("type", "")

    @property
    def refs(self) -> list[str]:
        return split_refs(self.fields.get("refs", ""))


def split_refs(value: str) -> list[str]:
    """Parse the comma-separated-on-one-line list convention (see README)."""
    return [part.strip() for part in value.split(",") if part.strip()]


def parse_record(path: pathlib.Path) -> Record:
    """Parse the strict flat frontmatter subset documented in agent/README.md.

    Deliberately not a YAML parser: no nesting, no anchors, no multi-line
    values, one `key: value` per line. This is what keeps the whole thing
    readable in ~150 lines of stdlib instead of a PyYAML dependency, and
    keeps `grep '^type: decision'` a valid way to query the journal.
    """
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise RecordError(f"cannot read {path}: {exc}") from exc
    except UnicodeDecodeError as exc:
        # Records are UTF-8 by definition (docs/tasks/0033-byte-exact-
        # proposal.md, agent/README.md's "The record format"), and this
        # is that rule's enforcement failing loud instead of silent:
        # without this, `UnicodeDecodeError` — a `ValueError`, not an
        # `OSError` — passed straight through every caller here, none
        # of which caught anything but `OSError`/`RecordError`, so
        # `castle validate` and `castle digest` both tracebacked on a
        # record containing one invalid byte instead of reporting it.
        # Not a regression this task introduced (the locale-default
        # `read_text()` this replaced failed the same way before it),
        # but this is the commit that made "UTF-8 by definition" an
        # explicit, documented claim, so it is the one that owns making
        # a violation report as a validation error rather than a crash.
        raise RecordError(
            f"{path}: not valid UTF-8 at byte offset {exc.start} ({exc.reason}) — "
            "records are UTF-8 by definition (docs/tasks/0033-byte-exact-proposal.md)"
        ) from exc

    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        raise RecordError(f"{path}: does not start with a '---' frontmatter fence")

    fields: dict[str, str] = {}
    i = 1
    while i < len(lines) and lines[i].strip() != "---":
        line = lines[i]
        if line.strip():
            if ":" not in line:
                raise RecordError(f"{path}: line {i + 1} is not 'key: value': {line!r}")
            key, _, value = line.partition(":")
            key = key.strip()
            if not key:
                raise RecordError(f"{path}: line {i + 1} has an empty key: {line!r}")
            fields[key] = value.strip()
        i += 1
    if i >= len(lines):
        raise RecordError(f"{path}: frontmatter never closed with a second '---'")

    body = "\n".join(lines[i + 1 :])
    # Exactly one blank line is the convention after the closing fence;
    # strip only the leading blank so a body that starts with real
    # whitespace-sensitive markdown (a code block) is not mangled.
    if body.startswith("\n"):
        body = body[1:]
    return Record(fields=fields, body=body, path=path)


def _reject_line_breaking_fields(fields: dict, *, what: str) -> None:
    """A field value carrying a line break breaks this format at the
    root (0009 review pass finding 6): render_record/render_model_entry
    write `f"{key}: {value}"` on one line, with no escaping, so a
    multi-line value produces a continuation line with no colon.
    parse_record then raises on that file, and load_all — whose job is
    to keep working over one bad file rather than refusing to touch the
    rest of the journal — silently SKIPS it. The record vanishes from
    `route` and `digest` while `validate` fails on it, all after the
    caller (e.g. `castle record --evidence "$(some_command)"`, an easy
    way to get a newline in) was told the write succeeded. Called from
    every writer *before* anything is written, so the failure is loud,
    immediate, and leaves no partial file behind — multi-line content
    belongs in the body, which has no such restriction.

    **The test is a round trip through `str.splitlines()`, not a search
    for `"\n"`, and that widening closed a real hole.** `parse_record`
    reads records back with `splitlines()`, which breaks on ten
    characters, not one: CR, VT, FF, the three file/group/record
    separators, NEL, and the two Unicode line separators. A guard
    looking only for `"\n"` therefore let `castle record --target
    $'private\rmechanism'` through — written, id printed, exit 0 — and
    `parse_record` then raised on it forever, in an append-only
    journal. That is precisely the invariant `--target`'s own write-time
    guards exist to enforce, defeated through the one character class
    those guards did not know about.

    Asking `splitlines()` itself rather than listing its characters is
    deliberate: a transcribed list is a copy of another implementation's
    behaviour that cannot notice when the original changes, and the
    same reasoning put a `GIT_*` prefix strip in `_checkout_fault`
    instead of an enumeration. A value survives iff splitting it yields
    exactly one line and that line is the value unchanged — which also
    catches a *trailing* break, where `splitlines()` returns one line
    but the character would still reach the file.
    """
    for key, value in fields.items():
        if not isinstance(value, str) or not value:
            continue
        lines = value.splitlines()
        if len(lines) != 1 or lines[0] != value:
            raise RecordError(
                f"{what} field {key!r} contains a line break, which this format's "
                f"flat frontmatter cannot represent: {value!r}. This is whatever "
                "`str.splitlines()` treats as a line boundary — a newline, but "
                "also CR, VT, FF, NEL and the Unicode line separators — because "
                "that is what reads these records back. Put multi-line content in "
                "the record body instead."
            )


def render_record(fields: dict, body: str) -> str:
    lines = ["---"]
    seen = set()
    for key in FIELD_ORDER:
        if key in fields:
            lines.append(f"{key}: {fields[key]}")
            seen.add(key)
    for key in sorted(set(fields) - seen):
        lines.append(f"{key}: {fields[key]}")
    lines.append("---")
    lines.append("")
    body = body.rstrip("\n")
    return "\n".join(lines) + ("\n" + body + "\n" if body else "\n")


def make_id(record_type: str, now: dt.datetime | None = None) -> str:
    """`YYYYMMDDTHHMMSSZ-<type>-<6 hex chars>` — sortable, greppable,
    collision-safe enough (docs/tasks/0008 pre-made decision)."""
    now = now or dt.datetime.now(dt.timezone.utc)
    ts = now.strftime(ID_TIMESTAMP_FMT)
    suffix = os.urandom(3).hex()
    return f"{ts}-{record_type}-{suffix}"


