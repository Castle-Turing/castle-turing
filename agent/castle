def state_dir() -> pathlib.Path:
    """CASTLE_STATE_DIR, then XDG_STATE_HOME/castle, then ~/.local/state/castle.

    CASTLE_STATE_DIR is what makes the CI harness possible: it points a
    throwaway journal at a temp directory without touching a real
    resident's state. The Nix module (modules/agent) wires
    castle.agent.stateDir into this same environment variable.
    """
    env = os.environ.get("CASTLE_STATE_DIR")
    if env:
        return pathlib.Path(env)
    xdg = os.environ.get("XDG_STATE_HOME")
    if xdg:
        return pathlib.Path(xdg) / "castle"
    return pathlib.Path.home() / ".local" / "state" / "castle"


def journal_dir() -> pathlib.Path:
    d = state_dir() / "journal"
    d.mkdir(parents=True, exist_ok=True)
    return d


def runtime_dir_is_fallback() -> bool:
    """True when `runtime_dir()` resolved to its `/tmp` last resort.

    Asked by `castle dispatch`, which refuses to run there — see the
    comment at that check. Written as its own predicate over the same
    two conditions `runtime_dir()` branches on, rather than as a string
    test on the returned path, so the two cannot drift: a resident
    whose `XDG_RUNTIME_DIR` happens to live under /tmp is not on the
    fallback, and nothing here has to guess that from a prefix.
    """
    if os.environ.get("XDG_RUNTIME_DIR"):
        return False
    return not pathlib.Path(f"/run/user/{os.getuid()}").is_dir()


def runtime_dir() -> pathlib.Path:
    """`$XDG_RUNTIME_DIR/castle`, then `/run/user/$UID/castle`, then
    `/tmp/castle-$UID`.

    The machine-local, login-session-lifetime root: the spool lives
    under it, and so do the locks docs/tasks/0021-auto-dispatch.md
    adds. Nothing durable is ever kept here — a reboot wipes it, and
    every piece of this tool treats that as normal rather than as data
    loss (see `leases_dir`).

    **The middle branch is a correctness fix, not tidiness.** Once
    these locks exist, this function decides which *namespace* a lock
    lives in, and two callers that disagree are not mutually excluded
    at all. `XDG_RUNTIME_DIR` is unset in exactly the contexts most
    likely to run `castle work` alongside a dispatch unit — an ssh
    session, a cron job, `su`. Falling straight to `/tmp/castle-$UID`
    there put a hand-run turn in a different namespace from the unit's,
    which was reproduced writing a false `interrupted` result over a
    turn that was very much alive. `/run/user/$UID` is the path
    systemd's own user manager sets `XDG_RUNTIME_DIR` to, so preferring
    it whenever it exists puts every caller on one host in one
    namespace. If it does not exist there is no user manager, hence no
    unit to diverge from, and `/tmp` is the honest last resort.
    """
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        return pathlib.Path(runtime) / "castle"
    session = pathlib.Path(f"/run/user/{os.getuid()}")
    if session.is_dir():
        return session / "castle"
    return pathlib.Path(f"/tmp/castle-{os.getuid()}")


def spool_dir() -> pathlib.Path:
    d = runtime_dir() / "spool"
    d.mkdir(parents=True, exist_ok=True)
    return d


def leases_dir() -> pathlib.Path:
    """Where per-request worker leases live (docs/tasks/0021 §3.1).

    A sibling of `spool/`, deliberately NOT part of it and deliberately
    not a record type: `RECORD_TYPES` is schema forever — every entry
    is a durable commitment about what a journal may contain — and "a
    worker currently holds this errand" is an ephemeral liveness fact
    with the lifetime of a login session, not a message any seat is
    sending any other. It is a lock, not a record. The durable account
    of what actually happened is the `claim` record.
    """
    d = runtime_dir() / "leases"
    d.mkdir(parents=True, exist_ok=True)
    return d


def lease_path(request_id: str) -> pathlib.Path:
    return leases_dir() / f"{request_id}.lock"


def route_lock_path() -> pathlib.Path:
    """The router's serialization lock (docs/tasks/0021 §2.6).

    Routing was a single-invoker fold until this task: one human typing
    `castle route`. Now a sweep's tail step runs it unattended, so a
    resident who types the command at the wrong instant can have their
    invocation and the sweep's fold the same unrouted record in
    parallel — both see it as unrouted, both append a decision, and
    both fire a notification for it. Serializing the whole fold is the
    cheap fix, and it is cheap: routing is fast and idempotent, so the
    loser of the race just finds nothing to do.
    """
    d = runtime_dir()
    d.mkdir(parents=True, exist_ok=True)
    return d / "route.lock"


def dispatch_lock_path() -> pathlib.Path:
    """The global sweep lock (docs/tasks/0021 §2.1) — one sweep at a
    time, machine-wide, per login session."""
    d = runtime_dir()
    d.mkdir(parents=True, exist_ok=True)
    return d / "dispatch.lock"


def spend_lock_path() -> pathlib.Path:
    """The global answer-spend lock (docs/tasks/0023, cross-model
    review): one process at a time may read which answers are unspent
    and write the claim that spends them.

    **Why it must be global when the lease is per-request.** The bound
    this protects — one further turn per answer, ever — is a property of
    the *answer*, and an answer can name blocking questions on more than
    one request (only the generic writer can produce that shape;
    `file_answer` refs exactly one question). `_resumable_answers`
    accounts for that: it treats an answer as spent when any claim
    anywhere names it. But two `castle work` invocations on two
    different requests take two different leases, exclude each other not
    at all, and can both load the journal before either writes its
    claim — so both see the same answer unspent, both spend it, and one
    answer buys two turns. The invariant is global, so the mutual
    exclusion has to be.

    Held across the recomputation and the claim write, and released
    immediately after — never across the tenant call. A turn may run for
    CASTLE_WORKER_TIMEOUT (900s by default), and serialising *that*
    would turn "one turn at a time per errand" into "one turn at a time
    on this machine", which is a behavioural change and not a fix. The
    section this covers is a journal read, a fold and one file write:
    microseconds.

    Blocking, unlike the lease, and the difference is the same judgment
    `acquire_lock_blocking` already documents for routing. A lease
    conflict means another worker is doing this errand and there is
    nothing useful left to do, so the caller skips. A spend-lock
    conflict means another turn is a few microseconds from finishing its
    accounting, after which this one has a correct answer to compute
    from — waiting is right, and skipping would strand a turn that has
    already taken its lease and is entitled to run.

    **LOCK ORDERING, and nothing may ever depart from it:**

        dispatch sweep lock  ->  per-request lease  ->  this lock

    `cmd_dispatch` takes the sweep lock and holds it for the whole
    sweep; `run_worker_turn` takes the lease, then this. Every path
    acquires a subset of that sequence in that order, so no cycle
    exists and none can deadlock. The next person adding a lock here is
    the one who could break it: acquire later in the sequence than
    anything you already hold, or take nothing you cannot take first.
    """
    d = runtime_dir()
    d.mkdir(parents=True, exist_ok=True)
    return d / "spend.lock"


def acquire_lock_blocking(path: pathlib.Path):
    """Take `flock(LOCK_EX)` on `path`, waiting for it if held.

    Blocking, unlike `acquire_lock`, and the difference is a judgment
    about what the caller should do when somebody else holds the lock.
    For the sweep and for a per-request lease, "somebody else is on it"
    means there is nothing useful left to do, so they skip. For routing
    it means "wait a moment": the fold is fast, idempotent, and a
    resident who typed `castle route` wants it to have run when the
    command returns, not to have quietly declined.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = path.open("a+")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    except BaseException:
        handle.close()
        raise
    return handle


def acquire_lock(path: pathlib.Path):
    """Take `flock(LOCK_EX | LOCK_NB)` on `path`, returning the open
    file object that holds it, or None if somebody else holds it now.

    `flock` on a plain file, never a PID file with a manual staleness
    check (docs/tasks/0021 §3.1): the kernel releases a flock the
    instant the holding process exits, for any reason including a
    crash, so a stale lock is detectable race-free by the next
    acquirer. A PID file needs a second mechanism (read /proc/<pid>,
    race against PID reuse) to answer the same question less reliably.

    The caller keeps the returned handle open for as long as it holds
    the lock; closing it releases the lock.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = path.open("a+")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        # EWOULDBLOCK, and ONLY that: somebody else holds this lock,
        # which is the ordinary answer this function exists to give.
        # A broader `except OSError` would quietly turn ENOLCK (the
        # kernel is out of lock records) or EIO on an exotic filesystem
        # into "somebody holds it" — a mechanism fault rendered as a
        # perfectly normal skip, which for the reaper means declining
        # to reap forever and for `castle work` means refusing to run
        # with a message naming a holder that does not exist. Anything
        # that is not "held" propagates and is loud.
        handle.close()
        return None
    except BaseException:
        handle.close()
        raise
    return handle


def lock_is_held(path: pathlib.Path) -> bool:
    """Probe whether somebody currently holds the lock on `path`.

    A probe is a nonblocking acquire immediately followed by a release
    — which means the probe itself briefly HOLDS the lock while it
    checks. That opens a narrow window in which a probe (a reaping
    sweep, or castle-modal's status fold) contends with a hand-run
    `castle work` starting at almost exactly the same instant, and the
    human's `castle work` can lose that race and see the lease as
    momentarily held. Accepted, not engineered around
    (docs/tasks/0021 §2.3): the resulting refusal is loud, an immediate
    retry succeeds because the probe released within microseconds, and
    a second locking protocol whose only job is making probes
    non-contending is not worth the complexity for a window this
    narrow. Resist the temptation to invent something more elaborate.
    """
    if not path.exists():
        # The normal case after a reboot: $XDG_RUNTIME_DIR is wiped, so
        # an interrupted turn's lease file is simply gone. Absence is
        # not "held," and the journal — not this directory — is what
        # says whether the turn ever finished.
        return False
    handle = acquire_lock(path)
    if handle is None:
        return True
    handle.close()
    return False


def lease_is_held(request_id: str) -> bool:
    """Is a worker running this errand right now? (docs/tasks/0021 §4)"""
    return lock_is_held(lease_path(request_id))


def load_all(directory: pathlib.Path) -> dict[str, Record]:
    """Load every record in a flat directory, keyed by id.

    Malformed files are skipped here rather than raising — `validate` is
    the command whose job is to complain about those; `route` and
    `digest` should keep working over a journal that has one bad file in
    it rather than refusing to touch anything else in the errand.
    """
    records: dict[str, Record] = {}
    for path in sorted(directory.glob("*.md")):
        try:
            rec = parse_record(path)
        except RecordError:
            continue
        if rec.id:
            records[rec.id] = rec
    return records


def write_record(
    target_dir: pathlib.Path,
    *,
    type: str,
    provenance: str,
    seat: str,
    refs: list[str] | None = None,
    evidence: str | None = None,
    body: str = "",
    extra: dict | None = None,
) -> str:
    record_id = make_id(type)
    created = dt.datetime.now(dt.timezone.utc).strftime(CREATED_FMT)
    fields = {
        "id": record_id,
        "type": type,
        "provenance": provenance,
        "refs": ",".join(refs or []),
        "seat": seat,
        "created": created,
    }
    if evidence is not None:
        fields["evidence"] = evidence
    if extra:
        fields.update(extra)
    # Stamped here rather than in `cmd_ask`, deliberately: a worker
    # tenant files a follow-up request with whatever hands it has —
    # `castle ask`, `castle record --type request`, or anything else
    # that ends up calling this function — and a stamp applied at one
    # of those entry points would simply be avoided by using another.
    # This is the single choke point every written record passes
    # through (docs/tasks/0021 §2.4(e)).
    claim_id = os.environ.get(WORKER_CLAIM_ENV, "").strip()
    if type == "request" and claim_id and FILED_DURING_TURN_FIELD not in fields:
        fields[FILED_DURING_TURN_FIELD] = claim_id

    # And the same choke point refuses an `answer` written from inside
    # a worker turn outright (docs/tasks/0023 §5). Not a stamp — a
    # refusal — because there is no shape of this write that is
    # acceptable.
    #
    # Proposal 05 (docs/architecture.md): inference may *open* a
    # question; only the resident may close one. A seat that answers
    # its own question retires it before the resident ever sees it —
    # the answer satisfies the "waiting on you" fold on every surface,
    # so the question stops being pending and nothing anywhere reports
    # that the system, not the person, decided. That alone is the
    # violation, independent of anything resumption does.
    #
    # Resumption then makes it a spend loop as well. Since 0023 an
    # answered blocking question buys the errand one further automatic
    # turn, and the turn's own claim spends only the answers that
    # already existed when it started — so a tenant that files a fresh
    # blocking question plus its own answer each turn is eligible again
    # on the very next sweep, forever, at one model call per turn.
    # Reproduced at five turns on one request before this refusal
    # existed, through both `castle answer` and
    # `castle record --type answer`. 0021 §2.4(e) severed exactly this
    # chain for requests; this is the second door 0023 opened, closed
    # the same way and in the same place, so no future write path can
    # route around it by choosing a different subcommand.
    #
    # Safe for every legitimate writer because of one property, checked
    # rather than assumed: `run_worker_turn` sets WORKER_CLAIM_ENV on
    # the *child's* env dict and never on `os.environ`, so the
    # dispatching process's own claim, result and decision writes never
    # see it — only a process descended from a tenant does.
    # `correction` is refused here for the same reason and by the same
    # test, and adding it decides no new policy: `cmd_record` has
    # refused `--type correction` since docs/tasks/0010, with a comment
    # giving exactly this reason — the generic writer would let a
    # worker fabricate what looks like verbatim resident speech. So the
    # repo already ruled that a tenant may not write corrections;
    # `cmd_correct` was simply an unguarded second door onto a thing
    # already prohibited, and this closes it where every writer passes
    # rather than in one more subcommand.
    #
    # The two harms are different and the message says which is which.
    # An answer closes a question the resident never saw. A correction
    # invents an opinion the resident never held — and unlike an
    # answer it also writes a `provenance: volunteered` resident-model
    # entry, so the fabrication becomes durable stated preference that
    # the router reads on every later decision. That is the larger of
    # the two doors, and it was the open one.
    #
    # Confirmed the dispatcher's own writes cannot trip either refusal,
    # the same way it was confirmed for `answer` and by the same two
    # facts: nothing in `agent/castle` or `agent/castle-modal` ever
    # assigns into `os.environ` (checked — there is no `os.environ[...]
    # =` anywhere in either file), so the variable can only be present
    # in a process descended from a tenant; and the record types a
    # sweep writes for itself are `claim`, `result` and `decision`,
    # never `answer` or `correction` — `file_answer` and
    # `file_correction` are resident paths, reached from the CLI and
    # the modal.
    if type in ("answer", "correction") and claim_id:
        harm = (
            "a seat that answers its own question retires it before the resident "
            "ever sees it, and — since docs/tasks/0023-resume-cold.md — an "
            "answered blocking question grants the errand another automatic turn, "
            "so a seat that could answer itself could grant itself unbounded "
            "unattended work. File the question and end the turn; the resident's "
            "answer is what resumes the errand."
            if type == "answer"
            else "a correction is the resident's own verdict on how this system is "
            "doing, filed unbidden and quoted verbatim wherever it is read — and "
            "filing one also writes a `provenance: volunteered` entry into the "
            "resident model, which the router consults afterward. A seat writing "
            "its own correction does not merely speak for the resident once; it "
            "installs an opinion they never held. `castle record --type "
            "correction` has been refused since docs/tasks/0010 for this reason; "
            "this is the same refusal, applied to the other door."
        )
        raise RecordError(
            f"refusing to write a {type} record from inside a worker turn "
            f"(a tenant's environment carries {WORKER_CLAIM_ENV}={claim_id}). Only "
            "the resident may speak as the resident (docs/architecture.md, "
            f"Proposal 05): {harm}"
        )

    _reject_line_breaking_fields(fields, what="record")
    target_dir.mkdir(parents=True, exist_ok=True)
    path = target_dir / f"{record_id}.md"
    path.write_text(render_record(fields, body))
    return record_id


def load_journal_record(record_id: str) -> Record | None:
    """Resolve a record id against the journal, or None if it does not
    exist there or fails to parse. Callers that are about to write a
    record whose `refs` will point at `record_id` should call this
    *before* writing (see cmd_ask, cmd_answer) — the journal is
    append-only by design (docs/architecture.md), so a `refs` entry
    pointing at nothing is permanent: `validate` flags it forever, and
    there is no way to make it go away short of hand-editing history
    (0009 review pass finding 3)."""
    path = journal_dir() / f"{record_id}.md"
    if not path.exists():
        return None
    try:
        return parse_record(path)
    except RecordError:
        return None


# ---------------------------------------------------------------------------
# The resident model (docs/architecture.md's Proposal 05; format documented
# in agent/README.md). Not a record type — a single flat file of entries,
# each in the same fenced-frontmatter style, living beside the journal
# rather than inside it.
#
# The journal is the source of truth; this file is a derived, regenerable
# *view* over it — trivially so today, since every entry is a near-copy of
# the question+answer or correction records it cites. That framing (not
# "second source of truth") is what makes a future normalization pass
# legitimate rather than an append-only violation: the file stays
# append-only in day-to-day operation, but nothing is lost if it is ever
# rebuilt from the journal by a better judge (docs/tasks/0010-correction-
# record.md).
#
# Two write paths, both narrow by construction: `file_answer`, which only
# ever runs because a human typed an answer at this CLI or at
# castle-modal's answer mode, and `file_correction`, which only ever runs
# because a human typed a correction (see below). Nothing here is ever
# called from `cmd_route` or `cmd_work` — inference and workers may raise
# questions, never close them, and they certainly never get to speak on
# the resident's behalf.
# ---------------------------------------------------------------------------

# `asked`/`answered` (elicited entries) and `provenance`/`stated`
# (volunteered entries, docs/tasks/0010) are mutually exclusive per
# entry — absence of `provenance` continues to mean "elicited," so every
# entry written before this task still parses as exactly what it always
# was. render_model_entry below only emits a key if it's present in the
# fields dict, so this one order serves both entry shapes correctly.
MODEL_FIELD_ORDER = ("fact", "asked", "answered", "provenance", "stated", "when")


def resident_model_path() -> pathlib.Path:
    return state_dir() / "resident-model.md"


def render_model_entry(fields: dict, body: str) -> str:
    # Same defect, same fix, as write_record's frontmatter (finding 6,
    # 0009 review pass): resident-model.md is append-only for the same
    # reason the journal is, and `fact` in particular can come straight
    # from an unchecked `castle answer --fact` argument (or, since
    # docs/tasks/0010, straight from a correction's own first line).
    _reject_line_breaking_fields(fields, what="resident-model")
    lines = ["---"]
    for key in MODEL_FIELD_ORDER:
        if key in fields:
            lines.append(f"{key}: {fields[key]}")
    lines.append("---")
    lines.append("")
    body = body.rstrip("\n")
    return "\n".join(lines) + ("\n" + body + "\n" if body else "\n")


def append_model_entry(
    *,
    fact: str,
    when: str,
    body: str,
    asked: str | None = None,
    answered: str | None = None,
    provenance: str | None = None,
    stated: str | None = None,
) -> None:
    """Append one entry to state/resident-model.md. Never overwrites or
    edits an existing entry — the model is append-only, same as the
    journal, for the same reason (agent/README.md).

    `asked`/`answered` is Proposal 05's elicited shape (`cmd_answer`);
    `provenance`/`stated` is docs/tasks/0010's volunteered shape
    (`file_correction`, below) — a caller passes one pair, never both,
    and the fields absent from `fields` here simply never appear in the
    rendered entry (render_model_entry only writes present keys)."""
    path = resident_model_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    fields = {"fact": fact, "when": when}
    if asked is not None:
        fields["asked"] = asked
    if answered is not None:
        fields["answered"] = answered
    if provenance is not None:
        fields["provenance"] = provenance
    if stated is not None:
        fields["stated"] = stated
    entry = render_model_entry(fields, body)
    existing = path.read_text() if path.exists() else ""
    separator = "\n" if existing.strip() else ""
    with path.open("a") as f:
        f.write(separator + entry)


class AnswerRefused(Exception):
    """Why `file_answer` refused to write. One exception type carrying a
    `kind` discriminant rather than four exception classes: every caller
    needs the same dispatch (map kind to wording), and a single type with
    a discriminant is the smaller surface for that.

    `kind` is one of "empty_body", "no_such_record", "wrong_type",
    "already_answered", "unreadable_answer". The extra attributes carry
    whatever detail a kind needs — `record_type` for "wrong_type",
    `existing_answer_id` for "already_answered", `path` for
    "unreadable_answer" — and are empty strings otherwise. No wording
    lives here or in `file_answer`: `cmd_answer` prints ids and the CLI's
    long-standing spellings, castle-modal's answer mode prints plain
    language with no ids at all, and both render from the same `kind`.
    """

    def __init__(
        self,
        kind: str,
        *,
        question_id: str = "",
        record_type: str = "",
        existing_answer_id: str = "",
        path: str = "",
    ):
        super().__init__(kind)
        self.kind = kind
        self.question_id = question_id
        self.record_type = record_type
        self.existing_answer_id = existing_answer_id
        self.path = path


def file_answer(
    *, question_id: str, body: str, fact: str | None = None
) -> tuple[str, str | None]:
    """The answer write path (docs/tasks/0022-answer-in-ui.md scope 1) —
    the `answer` record plus, when the question elicited a fact, the
    resident-model entry Proposal 05 allows only here.

    Extracted from `cmd_answer` for the same reason `file_correction`
    was extracted from `cmd_correct`: a second caller now exists
    (castle-modal's answer mode), and the modal reimplementing this write
    path in its own words is exactly the erosion these shared functions
    prevent — "the modal is castle's functions wearing a different hat"
    (docs/tasks/0010-correction-record.md).

    Every pre-write check lives here so no caller can skip one, and each
    refusal raises AnswerRefused rather than printing: this function
    prints nothing, ever, which is what lets `cmd_answer` keep its
    existing stderr line naming the internal fact key while the modal
    says something plainer over the identical write.

    Returns `(answer_id, recorded_fact_or_None)`.
    """
    if not body.strip():
        raise AnswerRefused("empty_body", question_id=question_id)
    # Resolve and type-check the question *before* writing the answer
    # (finding 3, 0009 review pass): the journal is append-only, so an
    # answer whose `refs` points at a typo'd or otherwise nonexistent
    # question id corrupts it permanently — `validate` flags the
    # dangling ref forever, and nothing short of hand-editing history
    # clears it. The old code wrote the answer unconditionally and only
    # checked the question's existence afterward (for the resident-model
    # fact lookup, treating absence as merely "no fact to record" rather
    # than an error) — so a typo produced no error at the point of
    # failure, just a silently-broken journal discovered later, if ever,
    # by `castle validate`. Checking first, and refusing outright when
    # the id doesn't resolve to an actual `question` record, is what
    # keeps that impossible instead of merely detectable.
    question = load_journal_record(question_id)
    if question is None:
        raise AnswerRefused("no_such_record", question_id=question_id)
    if question.type != "question":
        raise AnswerRefused(
            "wrong_type", question_id=question_id, record_type=question.type
        )

    # Is this question still open? The same fold castle-modal's answer
    # picker and the status surface's "waiting on you" overlay use: a
    # question is answered iff some `answer` record names it in `refs`.
    # Two answers on one question make "pending" ambiguous for every
    # later reader — including errand resumption, which asks exactly
    # this question and has since docs/tasks/0023-resume-cold.md
    # shipped: `_resumable_answers` folds an answer into one further
    # worker turn, so "is this question still open" now has spend
    # attached to it rather than only display. The
    # check lives here rather than in the modal so the CLI and the modal
    # can never disagree about what pending means (docs/tasks/0015 scope
    # 3 names two surfaces disagreeing as worse than either being wrong
    # alone).
    #
    # Deliberately NOT a lock. The journal is one file per record, so two
    # writers never physically conflict — flock protects a shared
    # resource and there is none here. The realistic case this catches is
    # a stale modal window left open from an earlier session and reused
    # after the question was answered elsewhere, which now produces a
    # legible refusal instead of a silent duplicate. The narrow race
    # between this check and the write below — another writer answering
    # the same question in the interval — is accepted: at most one
    # duplicate answer could land, on a single-resident machine, in a
    # window measured in microseconds, and a lock around a data model
    # built specifically to need none costs more than the residual risk.
    # Scanned strictly, file by file, rather than folded out of
    # `load_all`: that helper skips anything that fails to parse, so a
    # single corrupt answer record would silently re-open the duplicate
    # this guard exists to close — the one failure mode where "carry on
    # with what parsed" is exactly wrong. An unreadable answer file
    # means the question's state cannot be established, and the honest
    # move is to refuse and say which file to look at.
    #
    # The asymmetry with the read surfaces is deliberate: the picker in
    # castle-modal and the status overlay both fold with `load_all` and
    # stay tolerant of a corrupt file, because a surface that refuses to
    # render anything at all over one bad record is worse than one
    # showing the rest. A guard that decides whether to *write* has the
    # opposite duty.
    for path in sorted(journal_dir().glob("*-answer-*.md")):
        try:
            rec = parse_record(path)
        except RecordError:
            raise AnswerRefused(
                "unreadable_answer", question_id=question_id, path=str(path)
            ) from None
        if rec.type == "answer" and question_id in rec.refs:
            raise AnswerRefused(
                "already_answered", question_id=question_id, existing_answer_id=rec.id
            )

    # Answering is also intake: a resident's word entering the system
    # through one of its surfaces, same as `ask` — see architecture.md's
    # description of intake as "no judgment, just capture."
    record_id = write_record(
        journal_dir(),
        type="answer",
        provenance="requested",
        seat="intake",
        refs=[question_id],
        body=body,
    )

    # Proposal 05's write path: an explicit resident answer, and only
    # that, may write a resident-model entry. The fact name normally
    # comes from the question record itself (the seat that raised the
    # question is the one that knows what it's eliciting) — the `fact`
    # argument (`castle answer --fact`) is an override for a question
    # record that predates this field, or one written by hand. If neither
    # is present, this is just an ordinary answer with no model entry,
    # which is a legitimate outcome: not every question is eliciting a
    # durable fact. No caller may widen this rule — the modal in
    # particular offers no way to supply a fact name, because the fact
    # is the declaring seat's to set and a resident-typed one would make
    # the model's key space free text (agent/README.md's "Two entry
    # shapes exist... never both").
    resolved_fact = fact or question.fields.get("fact")
    if resolved_fact and resolved_fact.strip():
        when = dt.datetime.now(dt.timezone.utc).strftime(CREATED_FMT)
        entry_lines = []
        if question.body.strip():
            entry_lines.append(f"Q: {question.body.strip()}")
        entry_lines.append(f"A: {body.strip()}")
        try:
            append_model_entry(
                fact=resolved_fact.strip(),
                asked=question_id,
                answered=record_id,
                when=when,
                body="\n".join(entry_lines),
            )
        except OSError as exc:
            # The answer record is already durable at this point, and
            # the new already-answered guard means a retry of the same
            # answer would now be refused — so letting this escape would
            # cost the resident the answer they just typed (the CLI
            # never printing its id, the modal window closing on an
            # unhandled traceback in zero frames) AND make it
            # unrepeatable forever. The model is a derived, regenerable
            # *view* over the journal, not a second source of truth
            # (agent/README.md, "The resident model"): the question and
            # the answer are both in the journal, so this entry can be
            # re-derived later. Losing the view is a bad afternoon;
            # losing the record is unrecoverable.
            #
            # This one print is a deliberate exception to "file_answer
            # prints nothing, ever". That rule exists so no caller
            # inherits another surface's *wording* — and a mechanism
            # fault is not surface wording. Neither caller can render
            # this: the CLI would have to re-detect it, and the modal
            # must not say it at all (its vocabulary rule) while still
            # not lying about what happened.
            print(
                f"castle: answer {record_id} was filed, but its resident-model entry "
                f"could not be written ({exc}). Nothing is lost — the model is a view "
                "over the journal, and this entry can be re-derived from the question "
                "and answer records.",
                file=sys.stderr,
            )
            return record_id, None
        return record_id, resolved_fact.strip()
    return record_id, None


# ---------------------------------------------------------------------------
# The correction record (docs/tasks/0010-correction-record.md; Proposal
# 06's verdict half, docs/architecture.md). The resident speaking
# unbidden — not asking for anything, not answering a question — about
# how the system is doing. `castle correct` (surface=cli) and
# castle-modal's compose mode (surface=modal) both call file_correction()
# below rather than each reimplementing the record-plus-entry write: one
# shared function is what keeps the modal "castle's functions wearing a
# different hat," the same pattern every other modal write already
# follows.
# ---------------------------------------------------------------------------

# Filing-time context (scope 2): how far back "recently" and "today"
# reach when a correction is filed. One short window and one day-scale
# window, per the brief — chosen, not derived, and documented here and
# in agent/README.md since nothing else records the choice. An hour
# distinguishes "this is the second notification in the last few
# minutes" from ordinary spacing; a day catches "today has been a noisy
# day" even when no single hour looks unusual. Neither claims to be the
# *right* window for any later judge's purposes — they are cheap,
# legible facts a later pass can weigh however it decides to.
NOTIFY_CONTEXT_WINDOWS: dict[str, dt.timedelta] = {
    "context-notifies-1h": dt.timedelta(hours=1),
    "context-notifies-24h": dt.timedelta(hours=24),
}

# Local wall-clock time needs a UTC offset to be worth anything (`created`
# is always UTC, and time-of-day meaning — evening, morning — cannot be
# recovered from UTC alone once the machine's timezone history is
# forgotten). isoformat() with microseconds zeroed gives a value both
# human-readable and re-parseable with `datetime.strptime(value,
# LOCAL_CREATED_FMT)` (Python's %z has accepted a colon in the offset
# since 3.7).
LOCAL_CREATED_FMT = "%Y-%m-%dT%H:%M:%S%z"


def _filing_context() -> dict[str, str]:
    """A mechanical snapshot of what the journal shows the instant
    before a correction is appended to it (scope 2). Read from the
    journal in the *same process* that is about to write to it, before
    that write happens — which is what makes `context-last-notify`
    always resolvable by construction: unlike `refs` (resident-supplied,
    and can point at a typo), nothing here can ever cite a record that
    doesn't exist.

    These fields make NO CAUSAL CLAIM. They state what the journal
    contained at filing time — what the system had just done, how
    recently, how often — and nothing about *why* the resident chose
    that moment to speak. Asserting "this correction is about that
    notification" is the one causal claim this format allows, and only
    the resident may make it, via `--refs`. Honest limit, also recorded
    in agent/README.md: a notify-channel decision proves a notification
    was *attempted*, not that it was seen — delivery confirmation is
    Proposal 06's receipt half, and it waits for a surface that can
    report reception (docs/architecture.md's sequencing paragraph).
    """
    now = dt.datetime.now(dt.timezone.utc)
    records = load_all(journal_dir())
    # Only decisions the router itself wrote and routed to notify count
    # — the same `seat: router` filter cmd_route uses to build
    # already_routed, for the same reason: nothing else distinguishes
    # "the router decided this" from "some other record merely mentions
    # a notification."
    notify_decisions = [
        rec
        for rec in records.values()
        if rec.type == "decision"
        and rec.fields.get("seat") == "router"
        and rec.fields.get("channel") == "notify"
    ]

    context: dict[str, str] = {}
    if notify_decisions:
        # Ids are sortable timestamps (make_id) — the same ordering
        # cmd_route and cmd_digest already sort by — so the lexically
        # greatest id is the most recent notify decision.
        context["context-last-notify"] = max(notify_decisions, key=lambda rec: rec.id).id
    # No key at all when none exists (not an empty-string value): a
    # blank frontmatter value and a genuinely absent field read the same
    # to a human skimming the file, but only "absent" honestly says
    # "there is nothing to cite" instead of "there is a value and it's
    # nothing."

    for field, window in NOTIFY_CONTEXT_WINDOWS.items():
        cutoff = now - window
        count = 0
        for rec in notify_decisions:
            try:
                created = dt.datetime.strptime(
                    rec.fields.get("created", ""), CREATED_FMT
                ).replace(tzinfo=dt.timezone.utc)
            except ValueError:
                continue
            if created >= cutoff:
                count += 1
        context[field] = str(count)

    context["context-local-created"] = now.astimezone().replace(microsecond=0).strftime(
        LOCAL_CREATED_FMT
    )
    return context


def file_correction(*, body: str, refs: list[str], surface: str) -> str:
    """The correction write path (scope 3). Writes a `correction` record
    (`provenance: requested`, `seat: intake` — a correction is resident
    speech entering through intake, unconditionally, regardless of
    what's classified; see the RECORD_TYPES comment) stamped with
    filing-time context, then appends the resident-model entry that is
    the *only* place a correction's words land twice.

    The transcription here is mechanical and verbatim, on purpose — no
    seat paraphrases a correction, ever (docs/tasks/0010's load-bearing
    argument, "Why verbatim"): `fact` is nothing but the correction's
    own first line, sliced to 80 characters; `body` is passed through
    unchanged. Nothing here interprets, summarizes, or generalizes a
    single word the resident typed.

    Both `castle correct` (surface=cli) and castle-modal's compose mode
    (surface=modal) call this one function — the modal reimplementing
    this write path in its own words is exactly the erosion this
    function exists to prevent. Returns the correction record's id.
    """
    context = _filing_context()
    correction_id = write_record(
        journal_dir(),
        type="correction",
        provenance="requested",
        seat="intake",
        refs=refs,
        body=body,
        extra={"surface": surface, **context},
    )

    # A second `now()` call, same as cmd_answer's elicited-entry write
    # below it: the two timestamps can differ by a clock tick in
    # principle, and that's an accepted, pre-existing cost of the same
    # "write the record, then append the entry" shape Proposal 05
    # already uses.
    when = dt.datetime.now(dt.timezone.utc).strftime(CREATED_FMT)
    stripped = body.strip()
    first_line = stripped.splitlines()[0] if stripped else ""
    append_model_entry(
        fact=first_line[:80],
        provenance="volunteered",
        stated=correction_id,
        when=when,
        body=body,
    )
    return correction_id


