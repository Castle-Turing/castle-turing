# Record schema (docs/architecture.md's "Records" section)
# ---------------------------------------------------------------------------

# `claim` is the seventh type (docs/tasks/0021-auto-dispatch.md §3.2),
# and it answers a question docs/tasks/0015-filed-not-in-progress.md
# deliberately left open in its own non-goals — "do not add a
# started/claimed record type… it belongs with the first asynchronous
# worker." Automatic dispatch is that first asynchronous worker, so the
# record now has a job: written the instant `castle work` takes an
# errand's lease, it is the ONLY surviving evidence that a turn ever
# began once the lease dies with $XDG_RUNTIME_DIR at reboot. It exists
# for observability across a restart, never for mutual exclusion —
# flock already provides exclusion, for free (see cmd_work's lease).
RECORD_TYPES = ("request", "decision", "result", "question", "answer", "correction", "claim")
PROVENANCE_VALUES = ("requested", "initiated")

# Stamped on a `request` record written while a worker tenant's turn is
# running (docs/tasks/0021 §2.4(e)); its value is that turn's `claim`
# id. `castle dispatch` never starts a request carrying it.
#
# The one-automatic-attempt bound (§2.4(b)) is per request, and that is
# only a bound on unattended spend while the *supply* of requests is
# outside the tenant's control. It isn't: a tenant can file a request
# mid-turn, through `castle ask` or `castle record` like anything else,
# and each new request is a fresh errand with its own fresh attempt.
# Observed, not theorised — one sweep ran five turns off a single
# resident request before this stamp existed, and the sweep holds the
# global dispatch lock the whole time it does so.
#
# The stamp severs the chain at generation one, and it is a mechanical
# observation rather than a judgment: "this request was filed while
# that turn was running" is a fact about who was executing at write
# time, not a claim about the request's worth. Whether the follow-up
# work happens stays a human decision — the request is an ordinary
# request, it shows up in the status surface like any other, and
# `castle work <id>` runs it.
FILED_DURING_TURN_FIELD = "filed-during-turn"

# The marker a worker puts on a `question` record to say that this
# question, unlike an ordinary one, genuinely stopped the errand
# (docs/tasks/0023-resume-cold.md §2). Written once, at question
# creation, by the only party who could know it — the writer of the
# turn that stopped — and never mutated afterward. Its absence means
# false, which is what makes every question written before this field
# existed permanently non-resuming: a private journal accumulated over
# months does not start producing worker turns the first time this
# code runs against it.
#
# It is emphatically not a status field. "Is this question answered"
# stays the fold it always was (does any `answer` record name it);
# `blocking` answers the different, permanent question of whether its
# own writer could proceed without an answer — the same epistemic
# shape `outcome` has, an observation about the writer's own turn
# rather than a judgment about anyone else's.
BLOCKING_FIELD = "blocking"

# The `target` field on `result` records: which checkout the diff a
# turn produced is meant to be applied to
# (docs/tasks/0024-config-target.md §6). Written from what the tenant
# put in $CASTLE_TARGET_FILE, so it is an observation about which file
# the tenant wrote — never an inference about the resident, and never
# a route into the resident model.
#
# It carries a **role** (`private`, `mechanism`), not a path. A role is
# legible cold, to a human or a tenant, years later: an absolute path
# would read fine today and be a lie the first time the checkout moved
# or the machine was reinstalled. The resolved path is stated in the
# result's body prose beside the diff, where staleness is obvious
# rather than load-bearing.
#
# Deliberately **not** a closed vocabulary the way OUTCOME_VALUES is,
# and the difference is a decision rather than an oversight. There are
# two roles today; a third checkout — a resident's own fork of
# something they depend on — would widen the set, and a membership
# check here would make that a schema migration for no safety anyone
# needs. `cmd_validate` asks only "non-blank, and on a result record."
# The two known values are documented in agent/README.md.
TARGET_FIELD = "target"

# Where the tenant writes that one word. A second output file, exactly
# symmetric with $CASTLE_DIFF_FILE, rather than a sentinel line on
# stdout: stdout is the reasoning channel, quoted verbatim into the
# result body, and parsing structure out of prose is the thing the flat
# frontmatter format exists to avoid. Nor a `castle record` call from
# inside the tenant — `_write_worker_result` is the one writer of a
# turn's result, and a second writer for one record is the defect shape
# docs/tasks/0023 §5 already had to close once.
TARGET_FILE_ENV = "CASTLE_TARGET_FILE"

# The environment variable that carries the running turn's claim id
# into the tenant's own environment, and from there into any `castle`
# the tenant invokes. Set on the tenant's env dict only — never on
# os.environ of the dispatching process, which would stamp every
# request the dispatcher itself later wrote.
WORKER_CLAIM_ENV = "CASTLE_WORKER_CLAIM"

# Set on a resumed turn's tenant environment only — absent, never
# empty, otherwise, the same "absence means nothing to signal"
# convention FILED_DURING_TURN_FIELD uses on the record side. Its value
# is every answer id this turn is resuming, comma-separated in the same
# flat-list shape `refs` uses (split_refs parses it). Normally exactly
# one id, since `file_answer` refuses a second answer to one question —
# but a consumer must not assume that (docs/tasks/0023 §5, §8).
#
# "Resumed" means both halves: answers to spend, and a prior turn on
# this errand whose account the packet carries. A first turn that
# spends an answer — possible, if a blocking question was filed and
# answered before anything ran — leaves this absent, because what it
# tells a tenant is "there is earlier work of yours to read," and there
# is not. The claim's `refs` remain the complete account of which
# answers a turn consumed, on that turn and every other.
#
# It carries no prose: the continuation packet on stdin is where the
# actual prior context lives. This exists so a tenant can detect "this
# is a resumed turn" mechanically, without parsing the packet's own
# heading text, exactly as WORKER_CLAIM_ENV exists so a tenant's writes
# can be attributed without parsing anything.
RESUME_ANSWER_IDS_ENV = "CASTLE_RESUME_ANSWER_IDS"

# The two checkouts a worker tenant may be given, and the third
