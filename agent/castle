PRIVATE_ROOT_ENV = "CASTLE_PRIVATE_ROOT"
MECHANISM_ROOT_ENV = "CASTLE_MECHANISM_ROOT"
MECHANISM_ROOT_INVALID_ENV = "CASTLE_MECHANISM_ROOT_INVALID"

