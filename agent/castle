#!/usr/bin/env python3
"""castle — the agent-layer CLI (docs/architecture.md, docs/tasks/0008).

Standard library only, deliberately: this tool has to outlive whatever
harness is fashionable when it's run, and a stdlib script is the one
artifact format that needs nothing installed to stay readable. See
agent/README.md for the record format this implements and why it is a
strict, hand-parseable subset rather than real YAML.

Every subcommand is a seat's hands, not the seat's judgment: `ask` is
what the intake surface does with a request, `route` is what the
router does with provenance, `digest` is what the digest surface does
with a fold. None of them decide anything a human or a model couldn't
also decide by hand-writing the same record — that's the point
(Proposal 03: intelligence is a tenant, the structure is plain text).

Subcommands:
  ask       intake: write a `request` record.
  answer    intake: write an `answer` record for a `question`, and — if
            the question carries a resident-model `fact` (or one is
            passed with --fact) — the resident-model entry that answer
            elicits (docs/tasks/0009-ambient-intake.md, Proposal 05's
            only write path).
  correct   intake: write a `correction` record — the resident speaking
            unbidden about how the system is doing, not asking for
            anything — stamped with filing-time context, plus the
            verbatim resident-model entry it elicits
            (docs/tasks/0010-correction-record.md, Proposal 06's
            verdict half). Never routed; see `route` below.
  record    generic writer for any record type (what the sugar above,
            and any worker/router seat, calls underneath).
  route     router: append a decision record for every unrouted
            result/question, deciding channel from provenance alone.
            Corrections are never in that set — resident speech is not
            addressed to the resident.
  work      worker: run the configured worker-tenant command against a
            request and write back its result (docs/tasks/0009).
  digest    fold the journal into a human-readable report.
  validate  schema-check a journal (this is what CI asserts with).
  show      print one record, journal or spool.
"""

from __future__ import annotations

import argparse
import datetime as dt
import os
import pathlib
import shlex
import subprocess
import sys
import tempfile

# ---------------------------------------------------------------------------
# Record schema (docs/architecture.md's "Records" section)
# ---------------------------------------------------------------------------

RECORD_TYPES = ("request", "decision", "result", "question", "answer", "correction")
PROVENANCE_VALUES = ("requested", "initiated")

# `correction` (docs/tasks/0010-correction-record.md) is the resident
# speaking unbidden — never asked for, never answering a question — so
# it takes `provenance: requested` and `seat: intake` unconditionally,
# the same convention `answer` already uses: provenance's job is
# routing, and a correction is resident speech entering through intake
# like any other. It is deliberately absent from the tuple `cmd_route`
# walks (see the comment there) — the router must never route it.

# Field order matters only for readability of the written file — parsing
# does not care. Kept stable so `git diff` on journal files stays clean
# across tool versions. The four `context-*` fields and `surface` are
# correction-only (docs/tasks/0010); listing them here just keeps a
# correction record's frontmatter in one stable, readable order — every
# other record type simply never has them, and `render_record` already
# skips any FIELD_ORDER key that isn't present in a given record's
# fields.
FIELD_ORDER = (
    "id",
    "type",
    "provenance",
    "refs",
    "seat",
    "created",
    "surface",
    "context-local-created",
    "context-last-notify",
    "context-notifies-1h",
    "context-notifies-24h",
    "evidence",
)

REQUIRED_FIELDS = ("id", "type", "provenance", "refs", "seat", "created")

ID_TIMESTAMP_FMT = "%Y%m%dT%H%M%SZ"
CREATED_FMT = "%Y-%m-%dT%H:%M:%SZ"


class RecordError(Exception):
    """A record file did not parse as the strict frontmatter subset."""


class Record:
    """One parsed record: its frontmatter fields and its markdown body."""

    def __init__(self, fields: dict, body: str, path: pathlib.Path | None = None):
        self.fields = fields
        self.body = body
        self.path = path

    @property
    def id(self) -> str:
        return self.fields.get("id", "")

    @property
    def type(self) -> str:
        return self.fields.get("type", "")

    @property
    def refs(self) -> list[str]:
        return split_refs(self.fields.get("refs", ""))


def split_refs(value: str) -> list[str]:
    """Parse the comma-separated-on-one-line list convention (see README)."""
    return [part.strip() for part in value.split(",") if part.strip()]


def parse_record(path: pathlib.Path) -> Record:
    """Parse the strict flat frontmatter subset documented in agent/README.md.

    Deliberately not a YAML parser: no nesting, no anchors, no multi-line
    values, one `key: value` per line. This is what keeps the whole thing
    readable in ~150 lines of stdlib instead of a PyYAML dependency, and
    keeps `grep '^type: decision'` a valid way to query the journal.
    """
    try:
        text = path.read_text()
    except OSError as exc:
        raise RecordError(f"cannot read {path}: {exc}") from exc

    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        raise RecordError(f"{path}: does not start with a '---' frontmatter fence")

    fields: dict[str, str] = {}
    i = 1
    while i < len(lines) and lines[i].strip() != "---":
        line = lines[i]
        if line.strip():
            if ":" not in line:
                raise RecordError(f"{path}: line {i + 1} is not 'key: value': {line!r}")
            key, _, value = line.partition(":")
            key = key.strip()
            if not key:
                raise RecordError(f"{path}: line {i + 1} has an empty key: {line!r}")
            fields[key] = value.strip()
        i += 1
    if i >= len(lines):
        raise RecordError(f"{path}: frontmatter never closed with a second '---'")

    body = "\n".join(lines[i + 1 :])
    # Exactly one blank line is the convention after the closing fence;
    # strip only the leading blank so a body that starts with real
    # whitespace-sensitive markdown (a code block) is not mangled.
    if body.startswith("\n"):
        body = body[1:]
    return Record(fields=fields, body=body, path=path)


def _reject_newline_fields(fields: dict, *, what: str) -> None:
    """A field value containing a newline breaks this format at the
    root (0009 review pass finding 6): render_record/render_model_entry
    write `f"{key}: {value}"` on one line, with no escaping, so a
    multi-line value produces a continuation line with no colon.
    parse_record then raises on that file, and load_all — whose job is
    to keep working over one bad file rather than refusing to touch the
    rest of the journal — silently SKIPS it. The record vanishes from
    `route` and `digest` while `validate` fails on it, all after the
    caller (e.g. `castle record --evidence "$(some_command)"`, an easy
    way to get a newline in) was told the write succeeded. Called from
    every writer *before* anything is written, so the failure is loud,
    immediate, and leaves no partial file behind — multi-line content
    belongs in the body, which has no such restriction.
    """
    for key, value in fields.items():
        if isinstance(value, str) and "\n" in value:
            raise RecordError(
                f"{what} field {key!r} contains a newline, which this format's "
                f"flat frontmatter cannot represent: {value!r}. Put multi-line "
                "content in the record body instead."
            )


def render_record(fields: dict, body: str) -> str:
    lines = ["---"]
    seen = set()
    for key in FIELD_ORDER:
        if key in fields:
            lines.append(f"{key}: {fields[key]}")
            seen.add(key)
    for key in sorted(set(fields) - seen):
        lines.append(f"{key}: {fields[key]}")
    lines.append("---")
    lines.append("")
    body = body.rstrip("\n")
    return "\n".join(lines) + ("\n" + body + "\n" if body else "\n")


def make_id(record_type: str, now: dt.datetime | None = None) -> str:
    """`YYYYMMDDTHHMMSSZ-<type>-<6 hex chars>` — sortable, greppable,
    collision-safe enough (docs/tasks/0008 pre-made decision)."""
    now = now or dt.datetime.now(dt.timezone.utc)
    ts = now.strftime(ID_TIMESTAMP_FMT)
    suffix = os.urandom(3).hex()
    return f"{ts}-{record_type}-{suffix}"


# ---------------------------------------------------------------------------
# Where records live (docs/architecture.md's "journal and the spool")
# ---------------------------------------------------------------------------


def state_dir() -> pathlib.Path:
    """CASTLE_STATE_DIR, then XDG_STATE_HOME/castle, then ~/.local/state/castle.

    CASTLE_STATE_DIR is what makes the CI harness possible: it points a
    throwaway journal at a temp directory without touching a real
    resident's state. The Nix module (modules/agent) wires
    castle.agent.stateDir into this same environment variable.
    """
    env = os.environ.get("CASTLE_STATE_DIR")
    if env:
        return pathlib.Path(env)
    xdg = os.environ.get("XDG_STATE_HOME")
    if xdg:
        return pathlib.Path(xdg) / "castle"
    return pathlib.Path.home() / ".local" / "state" / "castle"


def journal_dir() -> pathlib.Path:
    d = state_dir() / "journal"
    d.mkdir(parents=True, exist_ok=True)
    return d


def spool_dir() -> pathlib.Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        d = pathlib.Path(runtime) / "castle" / "spool"
    else:
        d = pathlib.Path(f"/tmp/castle-{os.getuid()}") / "spool"
    d.mkdir(parents=True, exist_ok=True)
    return d


def load_all(directory: pathlib.Path) -> dict[str, Record]:
    """Load every record in a flat directory, keyed by id.

    Malformed files are skipped here rather than raising — `validate` is
    the command whose job is to complain about those; `route` and
    `digest` should keep working over a journal that has one bad file in
    it rather than refusing to touch anything else in the errand.
    """
    records: dict[str, Record] = {}
    for path in sorted(directory.glob("*.md")):
        try:
            rec = parse_record(path)
        except RecordError:
            continue
        if rec.id:
            records[rec.id] = rec
    return records


def write_record(
    target_dir: pathlib.Path,
    *,
    type: str,
    provenance: str,
    seat: str,
    refs: list[str] | None = None,
    evidence: str | None = None,
    body: str = "",
    extra: dict | None = None,
) -> str:
    record_id = make_id(type)
    created = dt.datetime.now(dt.timezone.utc).strftime(CREATED_FMT)
    fields = {
        "id": record_id,
        "type": type,
        "provenance": provenance,
        "refs": ",".join(refs or []),
        "seat": seat,
        "created": created,
    }
    if evidence is not None:
        fields["evidence"] = evidence
    if extra:
        fields.update(extra)
    _reject_newline_fields(fields, what="record")
    target_dir.mkdir(parents=True, exist_ok=True)
    path = target_dir / f"{record_id}.md"
    path.write_text(render_record(fields, body))
    return record_id


def load_journal_record(record_id: str) -> Record | None:
    """Resolve a record id against the journal, or None if it does not
    exist there or fails to parse. Callers that are about to write a
    record whose `refs` will point at `record_id` should call this
    *before* writing (see cmd_ask, cmd_answer) — the journal is
    append-only by design (docs/architecture.md), so a `refs` entry
    pointing at nothing is permanent: `validate` flags it forever, and
    there is no way to make it go away short of hand-editing history
    (0009 review pass finding 3)."""
    path = journal_dir() / f"{record_id}.md"
    if not path.exists():
        return None
    try:
        return parse_record(path)
    except RecordError:
        return None


# ---------------------------------------------------------------------------
# The resident model (docs/architecture.md's Proposal 05; format documented
# in agent/README.md). Not a record type — a single flat file of entries,
# each in the same fenced-frontmatter style, living beside the journal
# rather than inside it.
#
# The journal is the source of truth; this file is a derived, regenerable
# *view* over it — trivially so today, since every entry is a near-copy of
# the question+answer or correction records it cites. That framing (not
# "second source of truth") is what makes a future normalization pass
# legitimate rather than an append-only violation: the file stays
# append-only in day-to-day operation, but nothing is lost if it is ever
# rebuilt from the journal by a better judge (docs/tasks/0010-correction-
# record.md).
#
# Two write paths, both narrow by construction: `cmd_answer`, which only
# ever runs because a human typed an answer at this CLI, and
# `file_correction`, which only ever runs because a human typed a
# correction (see below). Nothing here is ever called from `cmd_route` or
# `cmd_work` — inference and workers may raise questions, never close
# them, and they certainly never get to speak on the resident's behalf.
# ---------------------------------------------------------------------------

# `asked`/`answered` (elicited entries) and `provenance`/`stated`
# (volunteered entries, docs/tasks/0010) are mutually exclusive per
# entry — absence of `provenance` continues to mean "elicited," so every
# entry written before this task still parses as exactly what it always
# was. render_model_entry below only emits a key if it's present in the
# fields dict, so this one order serves both entry shapes correctly.
MODEL_FIELD_ORDER = ("fact", "asked", "answered", "provenance", "stated", "when")


def resident_model_path() -> pathlib.Path:
    return state_dir() / "resident-model.md"


def render_model_entry(fields: dict, body: str) -> str:
    # Same defect, same fix, as write_record's frontmatter (finding 6,
    # 0009 review pass): resident-model.md is append-only for the same
    # reason the journal is, and `fact` in particular can come straight
    # from an unchecked `castle answer --fact` argument (or, since
    # docs/tasks/0010, straight from a correction's own first line).
    _reject_newline_fields(fields, what="resident-model")
    lines = ["---"]
    for key in MODEL_FIELD_ORDER:
        if key in fields:
            lines.append(f"{key}: {fields[key]}")
    lines.append("---")
    lines.append("")
    body = body.rstrip("\n")
    return "\n".join(lines) + ("\n" + body + "\n" if body else "\n")


def append_model_entry(
    *,
    fact: str,
    when: str,
    body: str,
    asked: str | None = None,
    answered: str | None = None,
    provenance: str | None = None,
    stated: str | None = None,
) -> None:
    """Append one entry to state/resident-model.md. Never overwrites or
    edits an existing entry — the model is append-only, same as the
    journal, for the same reason (agent/README.md).

    `asked`/`answered` is Proposal 05's elicited shape (`cmd_answer`);
    `provenance`/`stated` is docs/tasks/0010's volunteered shape
    (`file_correction`, below) — a caller passes one pair, never both,
    and the fields absent from `fields` here simply never appear in the
    rendered entry (render_model_entry only writes present keys)."""
    path = resident_model_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    fields = {"fact": fact, "when": when}
    if asked is not None:
        fields["asked"] = asked
    if answered is not None:
        fields["answered"] = answered
    if provenance is not None:
        fields["provenance"] = provenance
    if stated is not None:
        fields["stated"] = stated
    entry = render_model_entry(fields, body)
    existing = path.read_text() if path.exists() else ""
    separator = "\n" if existing.strip() else ""
    with path.open("a") as f:
        f.write(separator + entry)


# ---------------------------------------------------------------------------
# The correction record (docs/tasks/0010-correction-record.md; Proposal
# 06's verdict half, docs/architecture.md). The resident speaking
# unbidden — not asking for anything, not answering a question — about
# how the system is doing. `castle correct` (surface=cli) and
# castle-modal's compose mode (surface=modal) both call file_correction()
# below rather than each reimplementing the record-plus-entry write: one
# shared function is what keeps the modal "castle's functions wearing a
# different hat," the same pattern every other modal write already
# follows.
# ---------------------------------------------------------------------------

# Filing-time context (scope 2): how far back "recently" and "today"
# reach when a correction is filed. One short window and one day-scale
# window, per the brief — chosen, not derived, and documented here and
# in agent/README.md since nothing else records the choice. An hour
# distinguishes "this is the second notification in the last few
# minutes" from ordinary spacing; a day catches "today has been a noisy
# day" even when no single hour looks unusual. Neither claims to be the
# *right* window for any later judge's purposes — they are cheap,
# legible facts a later pass can weigh however it decides to.
NOTIFY_CONTEXT_WINDOWS: dict[str, dt.timedelta] = {
    "context-notifies-1h": dt.timedelta(hours=1),
    "context-notifies-24h": dt.timedelta(hours=24),
}

# Local wall-clock time needs a UTC offset to be worth anything (`created`
# is always UTC, and time-of-day meaning — evening, morning — cannot be
# recovered from UTC alone once the machine's timezone history is
# forgotten). isoformat() with microseconds zeroed gives a value both
# human-readable and re-parseable with `datetime.strptime(value,
# LOCAL_CREATED_FMT)` (Python's %z has accepted a colon in the offset
# since 3.7).
LOCAL_CREATED_FMT = "%Y-%m-%dT%H:%M:%S%z"


def _filing_context() -> dict[str, str]:
    """A mechanical snapshot of what the journal shows the instant
    before a correction is appended to it (scope 2). Read from the
    journal in the *same process* that is about to write to it, before
    that write happens — which is what makes `context-last-notify`
    always resolvable by construction: unlike `refs` (resident-supplied,
    and can point at a typo), nothing here can ever cite a record that
    doesn't exist.

    These fields make NO CAUSAL CLAIM. They state what the journal
    contained at filing time — what the system had just done, how
    recently, how often — and nothing about *why* the resident chose
    that moment to speak. Asserting "this correction is about that
    notification" is the one causal claim this format allows, and only
    the resident may make it, via `--refs`. Honest limit, also recorded
    in agent/README.md: a notify-channel decision proves a notification
    was *attempted*, not that it was seen — delivery confirmation is
    Proposal 06's receipt half, and it waits for a surface that can
    report reception (docs/architecture.md's sequencing paragraph).
    """
    now = dt.datetime.now(dt.timezone.utc)
    records = load_all(journal_dir())
    # Only decisions the router itself wrote and routed to notify count
    # — the same `seat: router` filter cmd_route uses to build
    # already_routed, for the same reason: nothing else distinguishes
    # "the router decided this" from "some other record merely mentions
    # a notification."
    notify_decisions = [
        rec
        for rec in records.values()
        if rec.type == "decision"
        and rec.fields.get("seat") == "router"
        and rec.fields.get("channel") == "notify"
    ]

    context: dict[str, str] = {}
    if notify_decisions:
        # Ids are sortable timestamps (make_id) — the same ordering
        # cmd_route and cmd_digest already sort by — so the lexically
        # greatest id is the most recent notify decision.
        context["context-last-notify"] = max(notify_decisions, key=lambda rec: rec.id).id
    # No key at all when none exists (not an empty-string value): a
    # blank frontmatter value and a genuinely absent field read the same
    # to a human skimming the file, but only "absent" honestly says
    # "there is nothing to cite" instead of "there is a value and it's
    # nothing."

    for field, window in NOTIFY_CONTEXT_WINDOWS.items():
        cutoff = now - window
        count = 0
        for rec in notify_decisions:
            try:
                created = dt.datetime.strptime(
                    rec.fields.get("created", ""), CREATED_FMT
                ).replace(tzinfo=dt.timezone.utc)
            except ValueError:
                continue
            if created >= cutoff:
                count += 1
        context[field] = str(count)

    context["context-local-created"] = now.astimezone().replace(microsecond=0).strftime(
        LOCAL_CREATED_FMT
    )
    return context


def file_correction(*, body: str, refs: list[str], surface: str) -> str:
    """The correction write path (scope 3). Writes a `correction` record
    (`provenance: requested`, `seat: intake` — a correction is resident
    speech entering through intake, unconditionally, regardless of
    what's classified; see the RECORD_TYPES comment) stamped with
    filing-time context, then appends the resident-model entry that is
    the *only* place a correction's words land twice.

    The transcription here is mechanical and verbatim, on purpose — no
    seat paraphrases a correction, ever (docs/tasks/0010's load-bearing
    argument, "Why verbatim"): `fact` is nothing but the correction's
    own first line, sliced to 80 characters; `body` is passed through
    unchanged. Nothing here interprets, summarizes, or generalizes a
    single word the resident typed.

    Both `castle correct` (surface=cli) and castle-modal's compose mode
    (surface=modal) call this one function — the modal reimplementing
    this write path in its own words is exactly the erosion this
    function exists to prevent. Returns the correction record's id.
    """
    context = _filing_context()
    correction_id = write_record(
        journal_dir(),
        type="correction",
        provenance="requested",
        seat="intake",
        refs=refs,
        body=body,
        extra={"surface": surface, **context},
    )

    # A second `now()` call, same as cmd_answer's elicited-entry write
    # below it: the two timestamps can differ by a clock tick in
    # principle, and that's an accepted, pre-existing cost of the same
    # "write the record, then append the entry" shape Proposal 05
    # already uses.
    when = dt.datetime.now(dt.timezone.utc).strftime(CREATED_FMT)
    stripped = body.strip()
    first_line = stripped.splitlines()[0] if stripped else ""
    append_model_entry(
        fact=first_line[:80],
        provenance="volunteered",
        stated=correction_id,
        when=when,
        body=body,
    )
    return correction_id


# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------


def cmd_record(args: argparse.Namespace) -> int:
    body = args.body
    if args.body_file:
        body = pathlib.Path(args.body_file).read_text()
    elif body is None and not sys.stdin.isatty():
        body = sys.stdin.read()
    target = spool_dir() if args.spool else journal_dir()
    extra = {"fact": args.fact} if getattr(args, "fact", None) else None
    record_id = write_record(
        target,
        type=args.type,
        provenance=args.provenance,
        seat=args.seat,
        refs=split_refs(args.refs or ""),
        evidence=args.evidence,
        body=body or "",
        extra=extra,
    )
    print(record_id)
    return 0


def cmd_ask(args: argparse.Namespace) -> int:
    body = " ".join(args.text) if args.text else (sys.stdin.read() if not sys.stdin.isatty() else "")
    if not body.strip():
        print("castle ask: refusing to file an empty request", file=sys.stderr)
        return 1
    refs = split_refs(args.refs or "")
    # Resolve every ref *before* writing anything (finding 3, 0009
    # review pass): the journal is append-only, so a request filed with
    # a `refs` entry that points at nothing corrupts it permanently —
    # `validate` flags the dangling ref forever, with no way to fix it
    # short of hand-editing history. Failing here, before write_record
    # is even called, is what keeps that impossible instead of merely
    # detectable after the fact.
    missing = [r for r in refs if load_journal_record(r) is None]
    if missing:
        print(
            f"castle ask: --refs points at record(s) that don't exist: {', '.join(missing)}",
            file=sys.stderr,
        )
        return 1
    record_id = write_record(
        journal_dir(),
        type="request",
        provenance=args.provenance,
        seat="intake",
        refs=refs,
        body=body,
    )
    print(record_id)
    return 0


def cmd_answer(args: argparse.Namespace) -> int:
    body = " ".join(args.text) if args.text else (sys.stdin.read() if not sys.stdin.isatty() else "")
    if not body.strip():
        print("castle answer: refusing to file an empty answer", file=sys.stderr)
        return 1
    # Resolve and type-check the question *before* writing the answer
    # (finding 3, 0009 review pass): the journal is append-only, so an
    # answer whose `refs` points at a typo'd or otherwise nonexistent
    # question id corrupts it permanently — `validate` flags the
    # dangling ref forever, and nothing short of hand-editing history
    # clears it. The old code wrote the answer unconditionally and only
    # checked the question's existence afterward (for the resident-model
    # fact lookup, treating absence as merely "no fact to record" rather
    # than an error) — so a typo produced no error at the point of
    # failure, just a silently-broken journal discovered later, if ever,
    # by `castle validate`. Checking first, and refusing outright when
    # the id doesn't resolve to an actual `question` record, is what
    # keeps that impossible instead of merely detectable.
    question = load_journal_record(args.question_id)
    if question is None:
        print(f"castle answer: no such record: {args.question_id}", file=sys.stderr)
        return 1
    if question.type != "question":
        print(
            f"castle answer: {args.question_id} is not a question record "
            f"(type={question.type!r})",
            file=sys.stderr,
        )
        return 1
    # Answering is also intake: a resident's word entering the system
    # through the CLI surface, same as `ask` — see architecture.md's
    # description of intake as "no judgment, just capture."
    record_id = write_record(
        journal_dir(),
        type="answer",
        provenance="requested",
        seat="intake",
        refs=[args.question_id],
        body=body,
    )
    print(record_id)

    # Proposal 05's write path: an explicit resident answer, and only
    # that, may write a resident-model entry. The fact name normally
    # comes from the question record itself (the seat that raised the
    # question is the one that knows what it's eliciting) — `--fact` is
    # an override for a question record that predates this field, or one
    # written by hand. If neither is present, this is just an ordinary
    # answer with no model entry, which is a legitimate outcome: not
    # every question is eliciting a durable fact. `question` is already
    # resolved above (and guaranteed to exist and be type=question) —
    # no need to re-read it here.
    fact = args.fact or question.fields.get("fact")
    if fact and fact.strip():
        when = dt.datetime.now(dt.timezone.utc).strftime(CREATED_FMT)
        entry_lines = []
        if question.body.strip():
            entry_lines.append(f"Q: {question.body.strip()}")
        entry_lines.append(f"A: {body.strip()}")
        append_model_entry(
            fact=fact.strip(),
            asked=args.question_id,
            answered=record_id,
            when=when,
            body="\n".join(entry_lines),
        )
        print(f"answer: recorded resident-model entry for fact '{fact.strip()}'", file=sys.stderr)
    return 0


def cmd_correct(args: argparse.Namespace) -> int:
    """intake: the resident speaking unbidden (scope 3, docs/tasks/0010).
    Exactly parallel to cmd_ask: body from argv or stdin, refuse empty,
    resolve every --refs id before writing anything. The actual write
    — record, filing-time context, and the resident-model entry it
    elicits — is file_correction(), shared with castle-modal's
    classification step so there is exactly one implementation of it."""
    body = " ".join(args.text) if args.text else (sys.stdin.read() if not sys.stdin.isatty() else "")
    if not body.strip():
        print("castle correct: refusing to file an empty correction", file=sys.stderr)
        return 1
    refs = split_refs(args.refs or "")
    # Resolve every ref *before* writing anything (finding 3, 0009
    # review pass, reused here for the same reason cmd_ask and
    # cmd_answer already do this): the journal is append-only, so a
    # correction filed with a --refs entry that points at nothing
    # corrupts it permanently.
    missing = [r for r in refs if load_journal_record(r) is None]
    if missing:
        print(
            f"castle correct: --refs points at record(s) that don't exist: {', '.join(missing)}",
            file=sys.stderr,
        )
        return 1
    correction_id = file_correction(body=body, refs=refs, surface="cli")
    print(correction_id)
    return 0


def _provenance_explanation(provenance: str) -> str:
    if provenance == "requested":
        return "the resident asked for this directly, so it interrupts now via the notify channel rather than waiting for a digest"
    return "the system undertook this on its own initiative, so it defaults to the digest rather than an interruption"


def _fire_notification(title: str, body: str) -> None:
    """Best-effort delivery on the router's `notify` channel
    (docs/tasks/0009-ambient-intake.md item 5). Never raises: a failed
    or missing notification daemon must not corrupt or block routing —
    the decision record is already durable by the time this runs, so
    the worst case is a silent (or, below, warned-about) missed ping,
    never a bad journal.

    CASTLE_NOTIFY_COMMAND, unset, defaults to plain `notify-send` on
    $PATH — real on a desktop that imported modules/desktop (which
    installs mako + libnotify), a harmless failed exec anywhere else.
    Set explicitly to an empty string to no-op silently (a headless
    host's way of saying "don't even try"); modules/agent wires
    castle.agent.notify.command into this same variable — see
    modules/agent/default.nix.
    """
    raw = os.environ.get("CASTLE_NOTIFY_COMMAND")
    if raw is None:
        raw = "notify-send"
    if not raw.strip():
        return
    try:
        argv = shlex.split(raw) + [title, body]
    except ValueError as exc:
        print(f"castle route: could not parse CASTLE_NOTIFY_COMMAND ({raw!r}): {exc}", file=sys.stderr)
        return
    try:
        subprocess.run(argv, check=False, timeout=5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"castle route: notify command {raw!r} failed (non-fatal): {exc}", file=sys.stderr)


def _find_root_request(records: dict[str, Record], rec: Record) -> Record | None:
    """Walk `refs` back to the originating `request`, if any is reachable."""
    seen: set[str] = set()
    current = rec
    while True:
        if current.type == "request":
            return current
        refs = current.refs
        if not refs:
            return None
        nxt_id = refs[0]
        if nxt_id in seen or nxt_id not in records:
            return None
        seen.add(nxt_id)
        current = records[nxt_id]


def cmd_route(args: argparse.Namespace) -> int:
    """The router's first rule set: provenance alone (docs/architecture.md).

    `requested` -> notify (a real interruption, docs/tasks/0009 item 5).
    `initiated` -> digest. Question records route the same way results
    do — both are "addressed to the resident." Every routing action
    appends exactly one decision record citing the provenance fact as
    evidence; nothing is ever routed without one, by construction (there
    is no code path here that decides a channel without also calling
    write_record for it).

    `correction` records are deliberately never in the set this walks —
    see the comment on `to_route`, below, for why that's load-bearing
    now rather than incidental.

    `already_routed` is built only from decision records whose own
    `seat` is `router` — docs/tasks/0009-ambient-intake.md item 7's bug
    fix. Before this filter, a decision written by *any* seat that
    happened to reference a result (an audit note, a future seat's own
    bookkeeping) would permanently and silently suppress that result's
    routing, since nothing distinguished "the router looked at this and
    decided" from "some record merely points at this." Not triggered
    today because only the router writes decisions, but the bug was
    real and waiting — see test/agent-loop/run.sh's regression test.
    """
    jdir = journal_dir()
    records = load_all(jdir)

    already_routed: set[str] = set()
    for rec in records.values():
        if rec.type == "decision" and rec.fields.get("seat") == "router":
            already_routed.update(rec.refs)

    # This tuple must never grow to include "correction"
    # (docs/tasks/0010-correction-record.md scope 4). A `result` or
    # `question` is addressed *to* the resident — something the system
    # produced that they need to see. A `correction` is the reverse: the
    # resident speaking to the system, unbidden, about how it's doing.
    # Routing one would mean the router deciding when and how to
    # interrupt the resident with their *own words* — the system
    # answering back to a judgment about itself, which is exactly what
    # Proposal 06 exists to prevent ("the system may grade its own
    # delivery; it may never grade its own judgment"). Pinned by a CI
    # regression in test/agent-loop/run.sh and check_assertions.py, not
    # just this comment, because today's silence here (correction simply
    # isn't in the tuple) is easy to break by accident later without one.
    to_route = [
        rec
        for rec in records.values()
        if rec.type in ("result", "question") and rec.id not in already_routed
    ]
    to_route.sort(key=lambda r: r.id)

    appended = []
    for rec in to_route:
        provenance = rec.fields.get("provenance", "")
        channel = "notify" if provenance == "requested" else "digest"
        root = _find_root_request(records, rec)
        evidence = (
            f"{rec.type} {rec.id} carries provenance={provenance}"
            + (f", inherited from originating request {root.id}" if root else "")
            + f": {_provenance_explanation(provenance)}."
        )
        body_lines = [
            f"Routing `{rec.type}` `{rec.id}` to channel **{channel}**.",
            "",
            f"Rule applied: provenance={provenance} -> {channel} "
            "(docs/architecture.md: \"requested -> surface to the resident now via notify; "
            "initiated -> digest\").",
        ]
        decision_id = write_record(
            jdir,
            type="decision",
            provenance="initiated",
            seat="router",
            refs=[rec.id],
            evidence=evidence,
            body="\n".join(body_lines),
            extra={"channel": channel},
        )
        appended.append((decision_id, rec.id, channel))
        if channel == "notify":
            summary = rec.body.strip().splitlines()[0] if rec.body.strip() else rec.type
            _fire_notification(f"Castle Turing — {rec.type}", summary[:200])

    if not appended:
        print("route: nothing unrouted; no decision records appended")
    else:
        for decision_id, ref_id, channel in appended:
            print(f"route: {decision_id} routes {ref_id} -> {channel}")
    return 0


DEFAULT_WORKER_COMMAND = "claude -p"


def cmd_work(args: argparse.Namespace) -> int:
    """The worker seat's hands (docs/tasks/0009-ambient-intake.md item 4).

    The contract sits at the errand boundary, not the model-call
    boundary (Proposal 03): a request record in, a result record out.
    What runs in between is `castle.agent.worker.command` — CI overrides
    it with a scripted stand-in; a real deployment defaults to
    agent/castle-worker-claude, a thin wrapper around a headless
    `claude -p` that this function knows nothing about beyond its
    contract: read the request body on stdin, write reasoning to
    stdout, write a diff (or nothing) to $CASTLE_DIFF_FILE, and — this
    is a hard product decision, not a nicety — never deploy anything.

    THE WORKER MUST NOT DEPLOY. This function never runs nixos-rebuild,
    never commits, never applies the diff it collects; it only ever
    folds that diff into a result record for the resident to review.
    """
    jdir = journal_dir()
    request_path = jdir / f"{args.request_id}.md"
    if not request_path.exists():
        print(f"castle work: no such request: {args.request_id}", file=sys.stderr)
        return 1
    try:
        request = parse_record(request_path)
    except RecordError as exc:
        print(f"castle work: {exc}", file=sys.stderr)
        return 1
    if request.type != "request":
        print(f"castle work: {args.request_id} is not a request record (type={request.type!r})", file=sys.stderr)
        return 1

    command = os.environ.get("CASTLE_WORKER_COMMAND", DEFAULT_WORKER_COMMAND)
    if not command.strip():
        print("castle work: no worker command configured (CASTLE_WORKER_COMMAND is empty)", file=sys.stderr)
        return 1
    try:
        argv = shlex.split(command)
    except ValueError as exc:
        print(f"castle work: could not parse CASTLE_WORKER_COMMAND ({command!r}): {exc}", file=sys.stderr)
        return 1

    diff_fd, diff_path_str = tempfile.mkstemp(prefix="castle-work-diff-")
    os.close(diff_fd)
    diff_path = pathlib.Path(diff_path_str)
    try:
        env = dict(os.environ)
        env["CASTLE_REQUEST_ID"] = request.id
        env["CASTLE_REQUEST_BODY"] = request.body
        env["CASTLE_DIFF_FILE"] = str(diff_path)
        env.setdefault("CASTLE_REPO_ROOT", str(pathlib.Path.cwd()))

        try:
            proc = subprocess.run(
                argv,
                input=request.body,
                capture_output=True,
                text=True,
                env=env,
            )
        except OSError as exc:
            print(f"castle work: could not run worker command {command!r}: {exc}", file=sys.stderr)
            return 1

        diff_text = ""
        try:
            diff_text = diff_path.read_text().strip()
        except OSError:
            diff_text = ""
    finally:
        try:
            diff_path.unlink()
        except OSError:
            pass

    ok = proc.returncode == 0
    reasoning = proc.stdout.strip()

    body_lines = []
    if ok:
        body_lines.append(f"Errand `{request.id}` completed by worker tenant `{command}`.")
    else:
        body_lines.append(
            f"Errand `{request.id}` FAILED in worker tenant `{command}` (exit {proc.returncode})."
        )
    body_lines.append("")
    if reasoning:
        body_lines.append(reasoning)
        body_lines.append("")
    if not ok and proc.stderr.strip():
        body_lines += ["stderr:", "```", proc.stderr.strip(), "```", ""]
    if diff_text:
        body_lines += ["```diff", diff_text, "```"]
    else:
        body_lines.append(
            "(no diff produced — either no change was proposed, or the worker "
            "tenant did not write one to $CASTLE_DIFF_FILE)"
        )
    body_lines.append("")
    body_lines.append(
        "This result was produced by the worker seat. Per "
        "docs/tasks/0009-ambient-intake.md's non-goals, the worker "
        "proposes; it does not deploy — nothing above was applied to any "
        "running system or committed to any repo by this seat."
    )

    record_id = write_record(
        jdir,
        type="result",
        provenance=request.fields.get("provenance", "requested"),
        seat="worker",
        refs=[request.id],
        body="\n".join(body_lines),
    )
    print(record_id)
    return 0 if ok else 1


def _collect_downstream(records: dict[str, Record], root_id: str) -> list[Record]:
    """Every record transitively reachable from `root_id` via `refs`."""
    collected: list[Record] = []
    seen = {root_id}
    changed = True
    while changed:
        changed = False
        for rec in records.values():
            if rec.id in seen:
                continue
            if any(ref in seen for ref in rec.refs):
                collected.append(rec)
                seen.add(rec.id)
                changed = True
    return collected


def cmd_digest(args: argparse.Namespace) -> int:
    """Fold the journal into "what happened, and why" (architecture.md's
    digest surface). Invoked by hand — no scheduling in this skeleton.

    Corrections are not errands (no request, no downstream fold — see
    _errand_state in castle-modal for the same distinction on that
    surface) but they still need to be part of a "read the journal cold"
    account, so they get their own section rather than being silently
    absent (scope 7, docs/tasks/0010): every correction in the period,
    verbatim first line, created time, and any refs the resident
    supplied."""
    records = load_all(journal_dir())
    requests = [rec for rec in records.values() if rec.type == "request"]
    corrections = [rec for rec in records.values() if rec.type == "correction"]
    if args.since:
        requests = [rec for rec in requests if rec.fields.get("created", "") >= args.since]
        corrections = [rec for rec in corrections if rec.fields.get("created", "") >= args.since]
    requests.sort(key=lambda r: r.id)
    corrections.sort(key=lambda r: r.id)

    if not requests and not corrections:
        print("No errands recorded.")
        return 0

    for req in requests:
        print(f"## Errand {req.id}")
        print(f"- provenance: {req.fields.get('provenance')}")
        print(f"- seat: {req.fields.get('seat')}")
        print(f"- created: {req.fields.get('created')}")
        print()
        if req.body.strip():
            print(req.body.strip())
            print()
        downstream = _collect_downstream(records, req.id)
        downstream.sort(key=lambda r: r.id)
        for rec in downstream:
            print(f"### {rec.type} {rec.id} (seat: {rec.fields.get('seat')})")
            if rec.type == "decision":
                print(f"- channel: {rec.fields.get('channel', '?')}")
                print(f"- evidence: {rec.fields.get('evidence', '')}")
            if rec.body.strip():
                print()
                print(rec.body.strip())
            print()

    if corrections:
        print("## Corrections")
        print()
        print(
            "Volunteered, unprompted — the resident's own words about how "
            "the system is doing (docs/tasks/0010-correction-record.md). "
            "Not an errand: nothing below is \"in progress\" or \"done,\" "
            "and none of it was routed."
        )
        print()
        for rec in corrections:
            body = rec.body.strip()
            first_line = body.splitlines()[0] if body else "(empty)"
            refs = rec.fields.get("refs", "")
            suffix = f" (refs: {refs})" if refs else ""
            print(f"- {rec.fields.get('created', '?')} — {first_line}{suffix}")
        print()

    return 0


def cmd_validate(args: argparse.Namespace) -> int:
    """Schema-check a journal. This is what CI asserts with (task 0008)."""
    jdir = pathlib.Path(args.journal) if args.journal else journal_dir()
    files = sorted(jdir.glob("*.md"))
    errors: list[str] = []
    records: dict[str, Record] = {}

    for path in files:
        try:
            rec = parse_record(path)
        except RecordError as exc:
            errors.append(str(exc))
            continue

        if rec.id:
            records[rec.id] = rec

        for field in REQUIRED_FIELDS:
            if field not in rec.fields:
                errors.append(f"{path.name}: missing required field '{field}'")

        if rec.fields.get("id") and rec.fields["id"] != path.stem:
            errors.append(
                f"{path.name}: id field {rec.fields['id']!r} does not match filename"
            )

        rtype = rec.fields.get("type")
        if rtype not in RECORD_TYPES:
            errors.append(f"{path.name}: invalid type {rtype!r}")

        provenance = rec.fields.get("provenance")
        if provenance not in PROVENANCE_VALUES:
            errors.append(f"{path.name}: invalid provenance {provenance!r}")

        # Proposal 04 given teeth: a decision without evidence doesn't
        # validate, full stop.
        if rtype == "decision" and not rec.fields.get("evidence", "").strip():
            errors.append(f"{path.name}: decision record missing non-empty 'evidence'")

        created = rec.fields.get("created", "")
        try:
            dt.datetime.strptime(created, CREATED_FMT)
        except ValueError:
            errors.append(f"{path.name}: 'created' ({created!r}) is not a valid UTC timestamp")

    for rec in records.values():
        for ref in rec.refs:
            if ref not in records:
                errors.append(f"{rec.path.name}: refs unknown record '{ref}'")

    if errors:
        for err in errors:
            print(f"INVALID: {err}", file=sys.stderr)
        print(f"{len(errors)} error(s) across {len(files)} record(s) in {jdir}", file=sys.stderr)
        return 1

    print(f"OK: {len(files)} record(s) valid in {jdir}")
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    for directory in (journal_dir(), spool_dir()):
        path = directory / f"{args.id}.md"
        if path.exists():
            print(path.read_text(), end="")
            return 0
    print(f"castle show: no such record: {args.id}", file=sys.stderr)
    return 1


