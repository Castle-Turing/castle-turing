# (docs/tasks/0025-approval.md).
PROPOSAL_SHA256_FIELD = "proposal-sha256"

# The one sentence a proposal question's body ever carries. Harness-
# authored, never tenant prose and never model-generated, for two
# reasons that both matter (docs/tasks/0025-approval.md §B, §I): it is
# the picker's first-line preview, which is what makes a proposal
# visually distinct from an ordinary elicited question with no extra
# code; and it is the first line `_fire_notification` takes, so the
# notification a resident actually receives says what this is and what
# it has not done, rather than leaking a store path or a model's
# opening sentence onto the one surface bound hardest by "no internal
# vocabulary."
PROPOSAL_QUESTION_BODY = (
    "This errand produced a proposed change to your {target} configuration. "
    "Nothing has been applied. Review it to approve, reject, or set it aside."
)

# The boundary that says where a result record's embedded diff starts
# and stops, and the field the value lives in
# (docs/tasks/0025-approval.md §G, finding 1 of its code review).
#
# **A markdown fence cannot be this boundary, and the reason is the
# same one docs/tasks/0023 hit with the continuation packet: content
# was being trusted to be structure.** The diff embedded in a result
# body is arbitrary bytes a tenant produced, and a unified diff of a
# file that itself contains a fenced code block carries context lines
# like " ```" and " ```diff" — which is to say, a reader
# scanning for a fence finds one *inside* the diff and closes the
# block early. Everything after it then reads as prose. On the review
# surface that is not a rendering wobble: the resident is shown less
# than the change they are approving, with the missing half relabelled
# as the machine's reasoning, on the one screen in this system where
# authority is granted.
#
# A nonce closes it by construction rather than by escaping, exactly
# as `render_continuation_packet`'s does. Eight random bytes, generated
# when the result is written — which is *after* the tenant has finished
# producing every byte of that diff — so no diff content can contain
# it, spell it, move it, or close it. It is stamped in the frontmatter,
# where a body cannot reach, and the frontmatter's copy is the only
# thing that makes a line in the body a boundary.
#
# Escaping the diff instead was the alternative and would have been
# wrong for the reason that function already gives: it means editing
# what the record says, and a result body carries a diff whose leading
# spaces are its meaning.
#
# The markdown fence stays, *inside* the boundary, so the record still
# renders as a diff wherever a journal is read as markdown. It is
# decoration now, not structure: nothing keys on it.
DIFF_BOUNDARY_FIELD = "diff-boundary"

# The field that says this proposed change, if approved, carries
