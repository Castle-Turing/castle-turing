# Commands
# ---------------------------------------------------------------------------


def cmd_check(args: argparse.Namespace) -> int:
    path = pathlib.Path(args.slate)
    if not path.is_file():
        raise SystemExit(f"{path}: no such file")

    slate, report = parse_slate(path)
    requirements, budget = check_header(slate, report)

    # A header travels with the file, so `Tasks:` resolves against the
    # slate's own directory — that is what lets a slate be moved or
    # copied without its rules quietly changing meaning. A flag is typed
    # at a shell, so `--tasks` resolves against the working directory,
    # which is the only reading a shell's tab-completion agrees with.
    tasks: pathlib.Path | None = None
    if args.tasks:
        tasks = pathlib.Path(args.tasks).resolve()
    elif slate.header.get("Tasks", "").strip():
        tasks = (path.parent / slate.header["Tasks"].strip()).resolve()

    if requirements is None:
        return emit(report)

    clauses = read_clauses(requirements, report)

    check_coverage(slate, clauses, report)
    check_grounding(slate, clauses, report)
    check_obligations(slate, report)
    check_budget(slate, budget, report)
    check_edges(slate, report)
    check_numbers(slate, tasks, report)

    for note in index_notes(slate, clauses, budget):
        report.note(note)
    return emit(report)


SCAFFOLD = """# Slate — {title}

Requirements: {requirements}
Brief-budget: {budget}
Tasks: {tasks}

What this slate is, and why it is decomposed the way it is. The
slate-review checklist in docs/planning.md is what this prose has to
survive.

## The briefs

<!-- Every clause of the requirements document is listed below. Each one
     must end up in some brief's Traces:, or in a Deferred: line under
     ## Coverage with a real reason. Neither is pre-filled here: a
     scaffold that pre-filled deferrals would let a clause nobody
     considered pass as a clause somebody declined.

{inventory}

     The next free number under {tasks} is {next_number}.
     Numbers here are proposals; the transfer into docs/tasks/ allocates
     against the live directory again at that moment. -->

### <what this brief makes true> [{next_number}]

Model: <tier>
Model-because: <what about this task makes that tier right, phrased
    against the tier you did not choose. A reason that would have
    supported the opposite choice equally well is not a reason.>
Milestone: <clause key from docs/state/MILESTONE.md>
Traces: <clause keys from the requirements document>
Criterion: <what demonstrates the traced requirement working in its real
    invocation path — not that the code runs, that the thing the clause
    asks for is reachable.>

The brief's body: the spec and reasoning an implementing agent reads
cold, including what was considered and rejected.

## Coverage

<!-- Deferred: <clause-key> — <why deferring it is acceptable> -->
"""


def cmd_scaffold(args: argparse.Namespace) -> int:
    """Write a slate skeleton from a requirements document.

    This is the mechanical half of producing a slate, and the whole of
    what a tool can honestly do: it enumerates the clauses so that no
    clause can be missed by never having been looked at, and it computes
    the next free number so parallel writers do not each invent one. The
    decomposition itself — how many briefs, where the seams are, what
    each one has to demonstrate — is the seat's, and nothing here
    attempts it.

    The output does not pass `plan check`, deliberately: it traces
    nothing and covers nothing. A scaffold whose own output passed would
    be a slate that looks complete while deciding nothing.
    """
    requirements = pathlib.Path(args.requirements)
    if not requirements.is_file():
        raise SystemExit(f"{requirements}: no such file")

    report = Report()
    clauses = read_clauses(requirements, report)
    if report.findings:
        return emit(report)

    tasks = pathlib.Path(args.tasks)
    if not tasks.is_dir():
        raise SystemExit(f"{tasks}: not a directory — nothing to allocate against")
    taken = {
        int(m.group(1))
        for m in (NUMBER_RE.match(p.name) for p in tasks.rglob("*.md"))
        if m
    }
    next_number = f"{(max(taken) + 1) if taken else 1:04d}"

    out = pathlib.Path(args.out)
    if out.exists() and not args.force:
        raise SystemExit(f"{out}: exists (pass --force to overwrite)")

    inventory = "\n".join(
        f"       clause: {c.key}"
        + (f" ({c.level})" if c.level else "")
        + (f" — {c.open_ambiguities} open ambiguity" if c.open_ambiguities else "")
        for c in clauses
    )
    text = SCAFFOLD.format(
        title=args.title or requirements.stem,
        requirements=os.path.relpath(requirements.resolve(), out.resolve().parent),
        budget=args.budget,
        tasks=os.path.relpath(tasks.resolve(), out.resolve().parent),
        inventory=inventory,
        next_number=next_number,
    )
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(text, encoding="utf-8")
    print(f"scaffolded {out} from {requirements}")
    print(f"  {len(clauses)} clause(s) to place, budget {args.budget}, "
          f"next free number {next_number}")
    print("  it does not pass `plan check` yet, and should not: it traces "
          "nothing.")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="plan",
        description="Check a planner seat's slate (docs/planning.md).",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    check = sub.add_parser("check", help="run the rules over a slate")
    check.add_argument("slate")
    check.add_argument(
        "--tasks",
        help="where task numbers are allocated against; defaults to the "
        "slate's Tasks: header",
    )
    check.set_defaults(func=cmd_check)

    scaffold = sub.add_parser(
        "scaffold", help="write a slate skeleton from a requirements document"
    )
    scaffold.add_argument("requirements")
    scaffold.add_argument("--out", required=True)
    scaffold.add_argument(
        "--budget",
        required=True,
        type=int,
        help="the brief budget, declared before the run: a budget chosen "
        "after seeing the count is not a budget",
    )
    scaffold.add_argument(
        "--tasks",
        default="docs/tasks",
        help="where task numbers are allocated against (default: docs/tasks)",
    )
    scaffold.add_argument("--title", help="the slate's title")
    scaffold.add_argument(
        "--force", action="store_true", help="overwrite an existing --out"
    )
    scaffold.set_defaults(func=cmd_scaffold)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
