def cmd_check(args: argparse.Namespace) -> int:
    requirements = pathlib.Path(args.requirements)
    if not requirements.is_file():
        raise SystemExit(f"{requirements}: no such file")

    doc, report = parse_requirements(requirements)

    transcript_path: pathlib.Path | None = None
    if args.transcript:
        transcript_path = pathlib.Path(args.transcript)
    elif "Transcript" in doc.header:
        transcript_path = (requirements.parent / doc.header["Transcript"]).resolve()

    only = set(args.only or ())
    want = lambda name: not only or name in only  # noqa: E731

    check_knobs(doc, report)
    if want("form"):
        check_form(doc, report)
        check_placement(doc, report)

    if transcript_path is None:
        if only and only <= {"form"}:
            return emit(report, args.strict)
        report.fail(
            "form",
            requirements.name,
            "no transcript: the document declares no Transcript: and none was "
            "passed with --transcript, so the question discipline and the "
            "read-back cannot be checked at all",
        )
        return emit(report, args.strict)
    if not transcript_path.is_file():
        report.fail("form", requirements.name, f"{transcript_path}: no such file")
        return emit(report, args.strict)

    blocks, transcript_report = parse_transcript(transcript_path)
    report.findings.extend(transcript_report.findings)

    if want("questions"):
        check_questions(doc, blocks, report)
    if want("readback"):
        check_readback(doc, blocks, report)

    return emit(report, args.strict)


def _probe_root(name: str) -> pathlib.Path:
    here = pathlib.Path(__file__).resolve().parent
    candidate = pathlib.Path(name)
    if candidate.is_dir():
        return candidate
    root = here / "probes" / name
    if not root.is_dir():
        raise SystemExit(f"no probe {name!r} under {here / 'probes'}")
    return root


def cmd_probe_build(args: argparse.Namespace) -> int:
    spec = load_probe(_probe_root(args.name))
    out = pathlib.Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    seeded = build_probe(spec)
    (out / "statement.md").write_text(seeded, encoding="utf-8")
    (out / "PROBE").write_text(
        f"probe: {spec.name}\nregistered: {spec.header['Registered']}\n"
        f"seeds: {len(spec.seeds)}\n\n"
        "This directory is a probe run. The seed record is deliberately NOT\n"
        "here: the phase runs against statement.md alone and writes\n"
        "transcript.md and requirements.md beside it. The requirements\n"
        f"document must carry 'Probe: {spec.name}' in its header.\n",
        encoding="utf-8",
    )
    print(f"built probe {spec.name} into {out} ({len(spec.seeds)} seeds deleted)")
    print(f"  {out / 'statement.md'}")
    return 0


def cmd_probe_score(args: argparse.Namespace) -> int:
    spec = load_probe(_probe_root(args.name))
    run = pathlib.Path(args.run)
    report = Report()
    score_probe(spec, run, report)
    return emit(report, args.strict)


def cmd_probe_oracle(args: argparse.Namespace) -> int:
    """Demonstrate that every seed is catchable.

    A seeded probe whose seeds nothing could catch measures the seeder,
    not the phase. The oracle is a transcript and requirements document
    written against the seeded statement that catch every seed; the
    demonstration is that scoring it reaches coverage 1.0. It runs in a
    temporary directory built from the seed record, so the oracle is
    scored against the same statement a real run would get.
    """
    spec = load_probe(_probe_root(args.name))
    oracle = spec.root / "oracle"
    if not oracle.is_dir():
        raise SystemExit(f"probe {spec.name}: no oracle/ directory under {spec.root}")

    report = Report()
    with tempfile.TemporaryDirectory(prefix="clarify-oracle.") as tmp:
        run = pathlib.Path(tmp)
        (run / "statement.md").write_text(build_probe(spec), encoding="utf-8")
        for name in ("transcript.md", "requirements.md"):
            source = oracle / name
            if not source.is_file():
                raise SystemExit(f"probe {spec.name}: oracle/{name} is missing")
            shutil.copyfile(source, run / name)
        coverage, _ = score_probe(spec, run, report)
        if coverage < 1.0:
            report.fail(
                "probe",
                spec.name,
                f"the oracle reaches coverage {coverage:.2f}, not 1.00 — a seed "
                "nothing can catch measures the seeder, not the phase",
            )
    return emit(report, args.strict)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="clarify",
        description=(
            "Check the clarifying-questions phase's artifacts "
            "(docs/clarifying-questions.md)."
        ),
    )
    parser.add_argument(
        "--strict",
        action="store_true",
        help="treat warnings as failures (off by default: the style lint's "
        "indicators are low-precision and blocking on them trains a seat to "
        "stop asking)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    check = sub.add_parser(
        "check", help="check a requirements document against its transcript"
    )
    check.add_argument("requirements")
    check.add_argument(
        "--transcript",
        help="the conversation; defaults to the document's Transcript: header",
    )
    check.add_argument(
        "--only",
        action="append",
        choices=["form", "questions", "readback"],
        help="run only these checks (repeatable)",
    )
    check.set_defaults(func=cmd_check)

    probe = sub.add_parser("probe", help="seeded-ambiguity probes")
    probe_sub = probe.add_subparsers(dest="probe_command", required=True)

    build = probe_sub.add_parser(
        "build", help="write a seeded statement for the phase to run against"
    )
    build.add_argument("name")
    build.add_argument("--out", required=True)
    build.set_defaults(func=cmd_probe_build)

    score = probe_sub.add_parser("score", help="score a completed probe run")
    score.add_argument("name")
    score.add_argument("run")
    score.set_defaults(func=cmd_probe_score)

    oracle = probe_sub.add_parser(
        "oracle", help="demonstrate that every seed is catchable"
    )
    oracle.add_argument("name")
    oracle.set_defaults(func=cmd_probe_oracle)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
